<%= wrapper_element do %>
  <%# `role="dialog"` + `aria-modal="true"` is redundant with `<dialog>` in
      modern browsers, but older Safari and screen readers still benefit.
      `aria-labelledby` always points at `title_id`: when the header rendered a
      title, AT announces it; when it did not (custom headers, body-only
      dialogs), the dangling reference is ignored per WAI-ARIA, and callers can
      pass `aria-label` / `aria-labelledby` through `**opts` (last wins). %>
  <%= tag.dialog class: "w-full h-full bg-transparent text-primary outline-none theme-dark:backdrop:bg-alpha-black-900 backdrop:bg-overlay pt-[env(safe-area-inset-top)] pb-[env(safe-area-inset-bottom)] #{(drawer? || responsive?) ? "lg:p-3" : "lg:p-1"}",
              role: "dialog",
              "aria-modal": "true",
              "aria-labelledby": title_id,
              **merged_opts do %>
    <%= tag.div class: dialog_outer_classes do %>
      <%= tag.div class: dialog_inner_classes, data: { DS__dialog_target: "content" } do %>
        <div class="grow py-4 space-y-4 flex flex-col <%= "overflow-y-auto" if scrollable %>">
          <% if header? %>
            <%= header %>
          <% end %>

          <% if body? %>
            <div class="px-4 grow">
              <%= body %>

              <% if sections.any? %>
                <div class="space-y-4">
                  <% sections.each do |section| %>
                    <%= section %>
                  <% end %>
                </div>
              <% end %>
            </div>
          <% end %>

          <%# Optional, for customizing dialogs %>
          <%= content %>
        </div>

        <% if actions? %>
          <div class="flex items-center gap-2 justify-end p-4">
            <% actions.each do |action| %>
              <%= action %>
            <% end %>
          </div>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
