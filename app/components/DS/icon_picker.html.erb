<div data-controller="list-filter" class="flex flex-col gap-2">
  <%# Enter in the search field would otherwise submit the surrounding form. %>
  <%= render DS::SearchInput.new(
        variant: :standalone,
        placeholder: placeholder,
        data: {
          list_filter_target: "input",
          action: "input->list-filter#filter keydown.enter->list-filter#filter:prevent"
        }
      ) %>

  <div data-list-filter-target="list" class="flex flex-wrap gap-0.5 max-h-52 overflow-y-auto scrollbar">
    <p class="hidden px-1 py-2 text-sm text-secondary" data-list-filter-target="emptyMessage">
      <%= t("ds.icon_picker.no_matching_icons") %>
    </p>

    <%# The `label > input + div > svg` nesting is load-bearing: the picker
        controller tints `input.nextElementSibling` and clones the svg out of
        the closest label. %>
    <% icons.each do |icon_name| %>
      <label class="filterable-item relative" data-filter-name="<%= filter_name(icon_name) %>">
        <%= form.radio_button method, icon_name, class: "sr-only peer", data: radio_data %>
        <%# Keyboard focus on the hidden radio draws the canonical outline on its
            tile; the chosen tile has a border-primary ring set off from the panel. %>
        <div class="text-secondary w-7 h-7 flex m-0.5 items-center justify-center rounded-full cursor-pointer hover:bg-container-inset-hover peer-checked:bg-container-inset border border-transparent outline-2 outline-offset-0 outline-transparent peer-focus-visible:outline-focus-ring peer-checked:ring-1 peer-checked:ring-alpha-black-300 theme-dark:peer-checked:ring-alpha-white-400 peer-checked:ring-offset-1 peer-checked:ring-offset-container">
          <%= helpers.icon(icon_name, size: "sm", color: "current") %>
        </div>
      </label>
    <% end %>
  </div>
</div>
