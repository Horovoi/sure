<%# locals: (budget:) %>

<%# The budget's dates. Periods follow the family's fiscal months when those are on. %>
<div class="text-secondary text-xs mb-3">
  <span><%= t(".period") %></span>
  <span class="text-primary">
    <%= format_date(budget.start_date) %> — <%= format_date(budget.end_date) %>
  </span>
  <% if Current.family.fiscal_month_enabled? %>
    <span class="ml-2 px-1.5 py-0.5 border border-tertiary rounded-md"><%= t(".fiscal_months") %></span>
  <% end %>
</div>
