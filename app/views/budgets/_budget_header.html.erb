<%# locals: (budget:) %>

<div class="flex items-center gap-1 mb-4">
  <div class="flex items-center gap-2">
    <%= render DS::PeriodArrow.new(
      direction: :previous,
      label: t(".previous_budget"),
      href: budget.previous_budget_param && budget_path(budget.previous_budget_param)
    ) %>

    <%= render DS::PeriodArrow.new(
      direction: :next,
      label: t(".next_budget"),
      href: budget.next_budget_param && budget_path(budget.next_budget_param)
    ) %>
  </div>

  <%= render DS::Popover.new(variant: "button") do |popover| %>
    <% popover.with_button class: "flex items-center gap-1 hover:bg-surface-hover cursor-pointer rounded-md p-2"  do %>
      <span class="text-primary font-medium text-base md:text-lg"><%= budget.name %></span>
      <%= icon("chevron-down") %>
    <% end %>

    <% popover.with_custom_content do %>
      <%= render "budgets/picker", family: Current.family, year: budget.start_date.year %>
    <% end %>
  <% end %>

  <div class="ml-auto">
    <%= render DS::Link.new(
        text: t(".today"),
        variant: "outline",
        href: budget_path(Budget.date_to_param(Date.current, family: Current.family)),
    ) %>
  </div>
</div>

<div class="text-secondary text-xs mb-3">
  <span><%= t(".period") %></span>
  <span class="text-primary">
    <%= budget.start_date.strftime("%b %-d, %Y") %> — <%= budget.end_date.strftime("%b %-d, %Y") %>
  </span>
  <% if Current.family.fiscal_month_enabled? %>
    <span class="ml-2 px-1.5 py-0.5 border border-tertiary rounded-md"><%= t(".fiscal_months") %></span>
  <% end %>
</div>
