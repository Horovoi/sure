<%# locals: (budget:) %>

<div class="flex items-center gap-1 mb-4">
  <div class="flex items-center gap-2">
    <%= render DS::PeriodArrow.new(
      direction: :previous,
      label: t(".previous_budget"),
      href: budget.previous_budget_param && budget_path(budget.previous_budget_param)
    ) %>

    <%= render DS::PeriodArrow.new(
      direction: :next,
      label: t(".next_budget"),
      href: budget.next_budget_param && budget_path(budget.next_budget_param)
    ) %>
  </div>

  <%# A md control: the trigger stands at the 36px height of the arrows beside it %>
  <%= render DS::Popover.new(variant: "button", placement: "bottom-start", offset: 4, testid: "budget-month-picker") do |popover| %>
    <% popover.with_button class: "flex h-9 items-center gap-1 rounded-lg px-2 cursor-pointer hover:bg-surface-hover focus-ring" do %>
      <span class="text-primary font-medium text-base md:text-lg whitespace-nowrap"><%= budget.name %></span>
      <%= icon("chevron-down", size: "sm") %>
    <% end %>

    <% popover.with_custom_content do %>
      <%= render "budgets/picker", family: Current.family, year: budget.start_date.year, selected: budget.to_param %>
    <% end %>
  <% end %>

  <div class="ml-auto">
    <%= render DS::Link.new(
        text: t(".today"),
        variant: "outline",
        href: budget_path(Budget.date_to_param(Date.current, family: Current.family)),
    ) %>
  </div>
</div>

<%= render "budgets/period", budget: budget %>
