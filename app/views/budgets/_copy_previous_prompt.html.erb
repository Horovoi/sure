<%# locals: (budget:, source_budget:) %>

<div class="flex flex-col gap-4 items-center justify-center h-full" data-testid="copy-previous-prompt">
  <%= icon "copy", size: "lg" %>

  <div class="text-center">
    <p class="text-primary font-medium"><%= t(".title") %></p>
    <p class="text-secondary text-sm mt-1"><%= t(".description", source_name: source_budget.name) %></p>
  </div>

  <div class="flex flex-col sm:flex-row items-center gap-2">
    <%= render DS::Button.new(
      text: t(".copy_button", source_name: source_budget.name),
      href: copy_previous_budget_path(budget),
      method: :post,
      icon: "copy",
      size: "sm"
    ) %>

    <%= render DS::Link.new(
      text: t(".fresh_button"),
      variant: "secondary",
      icon: "plus",
      size: "sm",
      href: edit_budget_path(budget)
    ) %>
  </div>
</div>
