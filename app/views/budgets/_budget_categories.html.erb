<%# locals: (budget:) %>

<% if budget.family.categories.expenses.empty? %>
  <div class="bg-container-inset rounded-xl p-1">
    <div class="bg-container py-8 shadow-border-xs rounded-md">
      <%= render "budget_categories/no_categories" %>
    </div>
  </div>
<% else %>
  <% categories_state = budget_categories_view_state(budget) %>
  <% has_over_budget = budget_has_over_budget?(budget) %>
  <%# Sections start hidden by the requested tab only when the tabs are shown. %>
  <% filter = has_over_budget ? current_budget_filter : "all" %>

  <div class="space-y-4">
    <%# With the tabs shown, the section stays, so the Over budget tab gets its empty state. %>
    <% if has_over_budget || categories_state[:over_budget_count].positive? %>
      <%= render "budgets/category_section",
            budget: budget,
            count: categories_state[:over_budget_count],
            groups: categories_state[:over_budget_groups],
            uncategorized: categories_state[:uncategorized_budget_category],
            show_uncategorized: categories_state[:show_over_budget_uncategorized],
            over_budget_mode: true,
            filter: filter %>
    <% end %>

    <%= render "budgets/category_section",
          budget: budget,
          count: categories_state[:on_track_count],
          groups: categories_state[:on_track_groups],
          uncategorized: categories_state[:uncategorized_budget_category],
          show_uncategorized: categories_state[:show_on_track_uncategorized],
          over_budget_mode: false,
          filter: filter %>
  </div>
<% end %>
