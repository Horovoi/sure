<%# locals: (budget:) %>

<% steps = [
  { name: t(".setup"), path: edit_budget_path(budget), is_complete: budget.initialized?, step_number: 1 },
  { name: t(".categories"), path: budget_budget_categories_path(budget), is_complete: budget.confirmable?, step_number: 2 },
] %>

<%# The current step is the filled one; a finished step is ticked in the success tint %>
<ol class="flex items-center gap-2">
  <% steps.each_with_index do |step, idx| %>
    <li class="flex items-center gap-2 group">
      <% is_current = request.path == step[:path] %>
      <% done = step[:is_complete] && !is_current %>

      <%= link_to step[:path],
                  class: class_names("flex items-center gap-2 rounded-md text-sm font-medium focus-ring",
                                     is_current ? "text-primary" : (done ? "text-success" : "text-secondary hover:text-primary")),
                  aria: { current: ("step" if is_current) } do %>
        <span class="<%= class_names("w-7 h-7 rounded-full shrink-0 inline-flex items-center justify-center tabular-nums",
                                     is_current ? "bg-inverse text-inverse" : (done ? "bg-success/10 text-success" : "bg-container-inset text-secondary")) %>">
          <%= done ? icon("check", size: "sm", color: "current") : idx + 1 %>
        </span>

        <span><%= step[:name] %></span>
      <% end %>

      <span class="w-12 border-t border-secondary group-last:hidden" aria-hidden="true"></span>
    </li>
  <% end %>
</ol>
