<%= render DS::Dialog.new do |dialog| %>
  <% dialog.with_header(title: t(".title"), subtitle: t(".subtitle")) %>

  <% dialog.with_body do %>
    <% if @monobank_accounts.empty? %>
      <div class="p-8 flex flex-col gap-3 items-center justify-center text-center">
        <%= icon "check-circle", size: "lg", color: "success" %>
        <p class="text-primary font-medium"><%= t(".nothing_to_set_up") %></p>
        <p class="text-secondary text-sm"><%= t(".nothing_to_set_up_hint") %></p>
      </div>
    <% else %>
      <%= form_with url: complete_account_setup_monobank_item_path(@monobank_item),
                    method: :post,
                    data: { turbo_frame: "_top" },
                    class: "space-y-4" do %>
        <% @monobank_accounts.each do |monobank_account| %>
          <% suggested = @suggested_links[monobank_account.id] %>
          <% candidates = @link_candidates.fetch(monobank_account.currency, []) %>
          <% field = "setup[#{monobank_account.id}]" %>

          <fieldset class="border border-primary rounded-lg p-4 space-y-3">
            <legend class="px-1">
              <span class="font-medium text-primary"><%= monobank_account.name %></span>
              <span class="text-xs text-secondary">
                <%= [ monobank_account.type_label, monobank_account.currency ].join(" · ") %>
              </span>
            </legend>

            <div class="form-field">
              <%= label_tag "#{field}[choice]", t(".choice_label"), class: "form-field__label" %>
              <%= select_tag "#{field}[choice]",
                             options_for_select(monobank_setup_choices(monobank_account, candidates), suggested ? "link:#{suggested.id}" : monobank_setup_default_choice(monobank_account)),
                             id: "setup_#{monobank_account.id}_choice",
                             class: "form-field__input" %>
            </div>

            <% if candidates.any? %>
              <div class="form-field">
                <%= label_tag "#{field}[cutover_date]", t(".cutover_label"), class: "form-field__label", for: "setup_#{monobank_account.id}_cutover" %>
                <%# Blank: the day after the latest entry of whichever account is chosen %>
                <%= date_field_tag "#{field}[cutover_date]",
                                   nil,
                                   id: "setup_#{monobank_account.id}_cutover",
                                   max: Date.current,
                                   autocomplete: "off",
                                   class: "form-field__input" %>
              </div>
              <p class="text-xs text-secondary">
                <% if suggested && (cutover = Account::ProviderLink.default_cutover_date(suggested)) %>
                  <%= t(".cutover_text", date: format_date(cutover), account: suggested.name) %>
                <% else %>
                  <%= t(".cutover_hint") %>
                <% end %>
              </p>
            <% end %>
          </fieldset>
        <% end %>

        <div class="flex gap-2 justify-end">
          <%= render DS::Link.new(text: t(".cancel"), variant: "secondary", href: accounts_path, data: { turbo_frame: "_top" }) %>
          <%= render DS::Button.new(text: t(".submit"), type: "submit", icon: "check") %>
        </div>
      <% end %>
    <% end %>
  <% end %>
<% end %>
