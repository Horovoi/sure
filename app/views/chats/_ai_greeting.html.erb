<%# Laid out like an answer: the avatar above, the text on the chat's left edge %>
<div class="w-full space-y-2">
  <%= render "chats/ai_avatar", size: "sm" %>

  <div class="text-sm leading-relaxed space-y-4 text-primary">
    <p><%= t("chats.greeting.intro", name: Current.user&.first_name.presence || t("chats.greeting.default_name")) %></p>

    <p>
      <%= t("chats.greeting.commands_html", key: tag.kbd("/", class: "bg-container border border-secondary px-1.5 py-0.5 rounded-sm font-mono text-xs")) %>
    </p>

    <div class="space-y-3">
      <p><%= t("chats.greeting.examples") %></p>

      <% questions = [
        { icon: "chart-area", text: t("chats.greeting.questions.portfolio") },
        { icon: "wallet-minimal", text: t("chats.greeting.questions.spending") },
        { icon: "alert-triangle", text: t("chats.greeting.questions.patterns") }
      ] %>

      <%# DS outline buttons (md, rounded-lg) that ask the question %>
      <div class="flex flex-col items-start gap-2">
        <% questions.each do |question| %>
          <%= render DS::Button.new(
                variant: :outline,
                text: question[:text],
                icon: question[:icon],
                data: { action: "chat#submitSampleQuestion", chat_question_param: question[:text] }
              ) %>
        <% end %>
      </div>
    </div>
  </div>
</div>
