<div class="flex items-start w-full gap-3 p-2">
  <%= render "chats/ai_avatar" %>

  <div class="max-w-[85%] text-sm space-y-4 text-primary">
    <p><%= t("chats.greeting.intro", name: Current.user&.first_name.presence || t("chats.greeting.default_name")) %></p>

    <p>
      <%= t("chats.greeting.commands_html", key: tag.span("/", class: "bg-container border border-secondary px-1.5 py-0.5 rounded font-mono text-xs")) %>
    </p>

    <div class="space-y-3">
      <p><%= t("chats.greeting.examples") %></p>

      <% questions = [
        { icon: "chart-area", text: t("chats.greeting.questions.portfolio") },
        { icon: "wallet-minimal", text: t("chats.greeting.questions.spending") },
        { icon: "alert-triangle", text: t("chats.greeting.questions.patterns") }
      ] %>

      <div class="space-y-2.5">
        <% questions.each do |question| %>
          <button data-action="chat#submitSampleQuestion"
                  data-chat-question-param="<%= question[:text] %>"
                  class="w-fit flex items-center gap-2 border border-tertiary rounded-full py-1.5 px-2.5 hover:bg-surface-hover">
            <%= icon(question[:icon]) %> <%= question[:text] %>
          </button>
        <% end %>
      </div>
    </div>
  </div>
</div>
