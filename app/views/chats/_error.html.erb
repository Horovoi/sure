<%# locals: (chat:) %>

<div id="chat-error" class="px-3 py-2 bg-destructive/10 border border-destructive rounded-lg">
  <% if chat.debug_mode? && chat.error.present? %>
    <div class="overflow-x-auto text-xs p-4 bg-destructive/20 text-primary rounded-md mb-2">
      <code><%= chat.error %></code>
    </div>
  <% end %>

  <div class="flex items-center justify-between gap-2">
    <div class="space-y-1">
      <p class="text-xs text-destructive"><%= t("chats.error.message") %></p>
      <% if (detail = chat.user_facing_error) %>
        <p class="text-xs text-destructive" data-testid="chat-error-detail"><%= detail %></p>
      <% end %>
    </div>

    <%= render DS::Button.new(
      text: t("chats.error.retry"),
      href: retry_chat_path(chat),
    ) %>
  </div>
</div>
