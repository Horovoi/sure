<%# Shown while the user's AI switch is off (the desktop chat sidebar, the phone chats page).
    An engine is connected (User#ai_available?): the button that turns AI on.
    No engine yet: the two ways to connect one, and the settings page where that is done. %>
<div class="rounded-lg p-4 bg-container shadow-border-xs" data-testid="ai-consent">
  <div class="flex justify-center mb-4">
    <%= render "chats/ai_avatar" %>
  </div>

  <% if Current.user.ai_available? %>
    <h3 class="text-sm font-medium text-primary mb-1 -mt-2 text-center"><%= t(".enable_title") %></h3>
    <p class="text-secondary mb-4 text-sm text-center"><%= t(".enable_body") %></p>

    <%= render DS::Button.new(
      text: t(".enable_button"),
      href: user_path(Current.user),
      method: :patch,
      params: { user: { ai_enabled: true, redirect_to: "home" } },
      data: { turbo: false },
      full_width: true
    ) %>

    <p class="text-xs text-secondary text-center mt-3"><%= t(".enable_note") %></p>
  <% else %>
    <div data-testid="ai-setup">
      <h3 class="text-sm font-medium text-primary mb-1 -mt-2 text-center"><%= t(".setup_title") %></h3>
      <p class="text-secondary mb-3 text-sm text-center"><%= t(".setup_body") %></p>

      <%# Plain rows, not filled cards: they describe the two ways, and the buttons below
          are what to click %>
      <ul class="space-y-3 mb-4 px-1">
        <li class="flex items-start gap-3">
          <%= icon "sparkles", size: "sm", class: "mt-0.5" %>
          <div class="min-w-0">
            <p class="text-sm font-medium text-primary"><%= t(".claude_title") %></p>
            <p class="text-xs text-secondary"><%= t(".claude_body") %></p>
          </div>
        </li>
        <li class="flex items-start gap-3">
          <%= icon "key-round", size: "sm", class: "mt-0.5" %>
          <div class="min-w-0">
            <p class="text-sm font-medium text-primary"><%= t(".openai_title") %></p>
            <p class="text-xs text-secondary"><%= t(".openai_body") %></p>
          </div>
        </li>
      </ul>

      <div class="space-y-2">
        <%= render DS::Link.new(
          text: t(".setup_button"),
          href: settings_ai_prompts_path,
          variant: :primary,
          full_width: true,
          frame: "_top"
        ) %>

        <% if self_hosted? %>
          <%= render DS::Link.new(
            text: t(".openai_button"),
            href: settings_hosting_path,
            variant: :ghost,
            full_width: true,
            frame: "_top"
          ) %>
        <% end %>
      </div>

      <p class="text-xs text-secondary text-center mt-3"><%= t(".setup_note") %></p>
    </div>
  <% end %>
</div>
