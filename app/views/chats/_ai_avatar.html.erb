<%# locals: (theme: "light", size: "md") %>

<div class="shrink-0 antialiased <%= size == "sm" ? "size-6" : "size-8" %>" style="filter: drop-shadow(0px 6px 8px rgba(244, 78, 247, 0.10));">
  <%# Never use svg as an image tag, it appears blurry in Safari %>
  <%= ai_avatar_svg "ai-dark.svg", alt: "AI", class: "w-full h-full hidden theme-dark:block" %>
  <%= ai_avatar_svg "ai.svg", alt: "AI", class: "w-full h-full theme-dark:hidden" %>
</div>
