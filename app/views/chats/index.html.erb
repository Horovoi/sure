<% ai_off = !Current.user.ai_enabled? %>

<div data-controller="chat hotkey" class="h-full">
  <%= turbo_frame_tag chat_frame do %>
    <%# pb-4: the composer's ring and shadow stay inside the page on a phone %>
    <div class="flex flex-col h-full px-0.5 pb-4 md:p-4">
      <% if ai_off %>
        <%# With AI off this page shows only the AI box: no greeting, no questions to
            ask. In the sidebar the layout draws the same box over the frame, so the
            frame stays empty there. %>
        <% unless turbo_frame_request? %>
          <div class="grow flex flex-col justify-center py-8">
            <%= render "chats/ai_consent" %>
          </div>
        <% end %>
      <% else %>
        <div class="grow flex flex-col">
          <% if show_demo_warning? %>
            <%= render "shared/demo_warning",
              title: t("chats.demo_banner_title"),
              message: t("chats.demo_banner_message") %>
          <% end %>

          <% if @chats.any? %>
            <div class="grow flex flex-col">
              <div class="flex items-center justify-between my-6">
                <h1 class="text-xl font-medium"><%= t(".title") %></h1>
                <%= render DS::Link.new(
                  id: "new-chat",
                  icon: "plus",
                  variant: "icon",
                  href: new_chat_path,
                  frame: chat_frame,
                  title: t(".new_chat"),
                  aria: { label: t(".new_chat") }
                ) %>
              </div>
              <div class="space-y-2 px-0.5">
                <%= render @chats %>
              </div>
            </div>
          <% else %>
            <div class="grow flex flex-col">
              <h1 class="sr-only"><%= t(".title") %></h1>
              <div class="mt-auto mx-auto w-full max-w-xl">
                <div class="py-8">
                  <%= render "chats/ai_greeting" %>
                </div>
                <%= render "messages/chat_form" %>
              </div>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
