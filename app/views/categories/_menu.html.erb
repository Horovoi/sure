<%# locals: (transaction:, variant: "desktop") %>
<%# mobile: the icon only (the row's avatar slot). desktop: the row's category column,
    the icon below 48rem of the row's width and the pill from there (transactions/_transaction) %>

<%= render DS::Popover.new(variant: "button") do |popover| %>
  <%# max-w-full: a button sizes to its content, so without it a long badge ran past its column %>
  <% popover.with_button(class: "max-w-full text-left") do %>
    <% if variant == "desktop" %>
      <div class="hidden @3xl:flex min-w-0">
        <%= render partial: "categories/badge", locals: { category: transaction.category } %>
      </div>
    <% end %>
    <div class="<%= variant == "desktop" ? "flex @3xl:hidden" : "flex" %>">
      <%= render partial: "categories/badge_mobile", locals: { category: transaction.category } %>
    </div>
  <% end %>

  <% popover.with_custom_content do %>
    <%= turbo_frame_tag "category_dropdown", src: category_dropdown_path(category_id: transaction.category_id, transaction_id: transaction.id), loading: :lazy do %>
      <div class="p-6 flex items-center justify-center">
        <p class="text-sm text-secondary animate-pulse"><%= t(".loading") %></p>
      </div>
    <% end %>
  <% end %>
<% end %>
