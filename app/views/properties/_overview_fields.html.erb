<%# locals: (form:) %>

<div class="flex flex-col gap-2">
  <%= form.text_field :name,
                  label: t("properties.overview_fields.name_label"),
                  placeholder: t("properties.overview_fields.name_placeholder"),
                  required: true %>

  <%= form.hidden_field :accountable_type, value: "Property" %>

  <%= form.fields_for :accountable do |property_form| %>
    <%= property_form.select :subtype,
                Property::SUBTYPES.keys.map { |key| [Property.long_subtype_label_for(key), key] },
                { prompt: t("properties.overview_fields.subtype_prompt"), label: t("properties.overview_fields.property_type_label") }, required: true %>

    <div class="flex items-center gap-2">
      <%= property_form.number_field :year_built,
                    label: t("properties.overview_fields.year_built_label"),
                    placeholder: t("properties.overview_fields.year_built_placeholder"),
                    min: 1500,
                    max: Time.current.year %>
    </div>

    <div class="flex items-center gap-2">
      <%= property_form.number_field :area_value,
                      label: t("properties.overview_fields.area_label"),
                      placeholder: t("properties.overview_fields.area_placeholder"),
                      min: 0 %>
      <%= property_form.select :area_unit,
                      [[t("properties.overview_fields.square_feet"), "sqft"], [t("properties.overview_fields.square_meters"), "sqm"]],
                      { label: t("properties.overview_fields.area_unit_label") } %>
    </div>
  <% end %>
</div>
