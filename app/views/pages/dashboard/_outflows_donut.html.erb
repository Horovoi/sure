<%# locals: (outflows_data:, period:) %>
<%= turbo_frame_tag "outflows_donut_section" do %>
<div id="outflows-donut-section">
  <div class="flex justify-end items-center gap-4 px-4 mb-4">
    <%= render "pages/dashboard/period_form", period: period, id: "outflows" %>
  </div>

  <%# The widget stays on the dashboard when the shared period has no outflows, so its
      period picker and the other widgets' period changes can lead back out %>
  <% if outflows_data[:categories].empty? %>
    <div class="h-[300px] px-4 flex items-center justify-center">
      <p class="text-secondary text-sm"><%= t("pages.dashboard.outflows_donut.no_data") %></p>
    </div>
  <% else %>
  <div class="px-4 @container">
    <div class="flex flex-col @2xl:flex-row gap-8 items-center">
      <!-- Donut Chart -->
      <div class="w-full @2xl:w-1/3 max-w-[300px] px-4">
        <div class="h-[300px] relative"
          data-controller="donut-chart"
          data-donut-chart-segments-value="<%= outflows_data[:categories].to_json %>"
          data-donut-chart-segment-opacity-value="0.9"
          data-donut-chart-extended-hover-value="true"
          data-donut-chart-hover-extension-value="3"
          data-donut-chart-enable-click-value="true"
          data-donut-chart-start-date-value="<%= period.date_range.first %>"
          data-donut-chart-end-date-value="<%= period.date_range.last %>">
          <div data-donut-chart-target="chartContainer" class="absolute inset-0 pointer-events-none"></div>

          <div data-donut-chart-target="contentContainer" class="flex justify-center items-center h-full">
            <div data-donut-chart-target="defaultContent" class="flex flex-col items-center">
              <div class="text-secondary text-sm mb-2">
                <span><%= t("pages.dashboard.outflows_donut.total_outflows") %></span>
              </div>

              <div data-donut-chart-target="amount" class="text-3xl font-medium text-primary tabular-nums whitespace-nowrap privacy-sensitive">
                <%= format_money Money.new(outflows_data[:total], outflows_data[:currency]) %>
              </div>
            </div>

            <% outflows_data[:categories].each do |category| %>
              <div id="segment_<%= category[:id] %>" class="hidden">
                <div class="flex flex-col gap-2 items-center">
                  <p class="text-sm text-secondary"><%= category[:name] %></p>

                  <p data-donut-chart-target="amount" class="text-3xl font-medium text-primary tabular-nums whitespace-nowrap privacy-sensitive">
                    <%= format_money Money.new(category[:amount], category[:currency]) %>
                  </p>

                  <p class="text-sm text-secondary tabular-nums"><%= number_to_percentage(category[:percentage], precision: 1) %></p>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      </div>

      <!-- Category List -->
      <%# Weight | Value, as in the balance sheet. Rows sit 4px inside their panel and
          take the container hover; the name column truncates, the figures do not wrap. %>
      <div class="w-full @2xl:w-2/3 bg-container-inset rounded-xl p-1 space-y-1">
        <div class="px-4 py-2 flex items-center gap-4 text-xs font-medium text-secondary">
          <p class="min-w-0 flex-1 truncate"><%= t("pages.dashboard.outflows_donut.categories") %><span class="text-subdued mx-1">&middot;</span><%= outflows_data[:categories].count %></p>
          <p class="w-14 shrink-0 text-right hidden @sm:block"><%= t("pages.dashboard.outflows_donut.weight") %></p>
          <p class="min-w-24 shrink-0 text-right"><%= t("pages.dashboard.outflows_donut.value") %></p>
        </div>
        <div class="p-1 shadow-border-xs rounded-lg bg-container font-medium text-sm">
          <% outflows_data[:categories].each_with_index do |category, idx| %>
            <%
              category_content = capture do
            %>
              <div class="flex items-center gap-3 flex-1 min-w-0">
                <div class="h-7 w-7 flex-shrink-0 group-hover:scale-105 transition-all duration-300 rounded-full flex justify-center items-center"
                  style="
                    background-color: color-mix(in oklab, <%= category[:color] %> 10%, transparent);
                    border-color: color-mix(in oklab, <%= category[:color] %> 10%, transparent);
                    color: <%= category[:color] %>;">
                  <% if category[:icon] %>
                    <%= icon(category[:icon], color: "current", size: "sm") %>
                  <% else %>
                    <%= render DS::FilledIcon.new(
                      variant: :text,
                      hex_color: category[:color],
                      text: category[:name],
                      size: "sm",
                      rounded: true
                    ) %>
                  <% end %>
                </div>
                <span class="text-sm font-medium text-primary truncate"><%= category[:name] %></span>
              </div>
              <span class="w-14 shrink-0 text-right text-sm text-secondary tabular-nums whitespace-nowrap hidden @sm:inline"><%= number_to_percentage(category[:percentage], precision: 1) %></span>
              <span class="min-w-24 shrink-0 text-right text-sm font-medium text-primary tabular-nums whitespace-nowrap privacy-sensitive"><%= format_money Money.new(category[:amount], category[:currency]) %></span>
            <% end %>

            <% if category[:clickable] != false %>
              <%= link_to transactions_path(q: { categories: [category[:filter_value]], start_date: period.date_range.first, end_date: period.date_range.last }),
                  class: "flex items-center gap-4 p-3 rounded-lg cursor-pointer group hover:bg-container-hover focus-ring",
                  data: {
                    turbo_frame: "_top",
                    category_id: category[:id],
                    action: "mouseenter->donut-chart#highlightSegment mouseleave->donut-chart#unhighlightSegment"
                  } do %>
                <%= category_content %>
              <% end %>
            <% else %>
              <div class="flex items-center gap-4 p-3 rounded-lg group"
                  data-category-id="<%= category[:id] %>"
                  data-action="mouseenter->donut-chart#highlightSegment mouseleave->donut-chart#unhighlightSegment">
                <%= category_content %>
              </div>
            <% end %>
            <% if idx < outflows_data[:categories].size - 1 %>
              <%= render "shared/ruler", classes: "mx-3" %>
            <% end %>
          <% end %>
        </div>
      </div>
    </div>
  </div>
  <% end %>
</div>
<% end %>
