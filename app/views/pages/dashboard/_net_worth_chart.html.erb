<%# locals: (balance_sheet:, period:, **args) %>
<%= turbo_frame_tag "net_worth_section" do %>
<div id="net-worth-chart" data-controller="networth-sync">
  <% series = balance_sheet.net_worth_series(period: period) %>
  <%# The section header names the widget, so the value leads; the expand button sits
      with the period controls %>
  <div class="flex flex-wrap items-start justify-between gap-x-4 gap-y-3 px-4">
    <div class="min-w-0 space-y-2">
      <% if series.trend.present? %>
        <p class="text-primary -space-x-0.5 text-3xl font-medium tabular-nums whitespace-nowrap privacy-sensitive <%= "animate-pulse" if balance_sheet.syncing? %>">
          <%= series.trend.current.format %>
        </p>
        <%= render partial: "shared/trend_change", locals: { trend: series.trend, comparison_label: period.comparison_label } %>
      <% else %>
        <p class="text-sm text-secondary"><%= t(".data_not_available") %></p>
      <% end %>
    </div>

    <div class="flex flex-wrap items-center gap-2">
      <%= render "pages/dashboard/period_form", period: period, id: "net_worth" %>

      <% if series.trend.present? %>
        <%= render DS::Button.new(
          variant: :icon,
          icon: "maximize-2",
          type: "button",
          title: t(".expand"),
          aria: { label: t(".expand") },
          data: { controller: "fullscreen", action: "click->fullscreen#open", fullscreen_target_id_value: "net_worth_fullscreen_dialog" },
          class: "hidden sm:inline-flex"
        ) %>
      <% end %>
    </div>
  </div>

  <% if series.any? %>
    <%# The fullscreen header takes data-period-label after a frame refresh. A custom
        range is formatted here, as the dialog formats it, not by the browser's locale. %>
    <div
    id="netWorthChart"
    class="w-full flex-1 min-h-52"
    data-controller="time-series-chart"
    data-time-series-chart-data-value="<%= series.to_json %>"
    data-time-series-chart-endpoint-markers-value="true"
    data-time-series-chart-show-y-guides-value="true"
    data-time-series-chart-money-format-value="<%= Money.new(0, balance_sheet.currency).format_options.slice(:unit, :precision, :delimiter, :separator, :format).to_json %>"
    data-time-series-chart-selectable-value="true"
    draggable="false"
    data-period-label="<%= period.key.present? ? period.label : t("pages.dashboard.net_worth_chart_dialog.date_range", start: l(period.start_date, format: "%b %-d, %Y"), end: l(period.end_date, format: "%b %-d, %Y")) %>"
    data-period-start="<%= period.start_date %>"
    data-period-end="<%= period.end_date %>"></div>
  <% else %>
    <div class="w-full h-full flex items-center justify-center">
      <p class="text-secondary text-sm"><%= t(".data_not_available") %></p>
    </div>
  <% end %>

</div>
<% end %>

<%# Fullscreen dialog moved to dashboard.html.erb to prevent frame refresh from closing it %>
