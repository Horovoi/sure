<%# locals: (sankey_data:, period:, show_subcategories:) %>

<%= render DS::Dialog.new(variant: "modal", width: "xl", auto_open: false, id: "cashflow_sankey_dialog", disable_frame: true) do |d| %>
  <% period_text = period.key.present? ? period.label : period.comparison_label %>

  <%# One header: the title and period, then the widget's own control %>
  <% d.with_header title: t("pages.dashboard.cashflow_sankey.title"), meta: period_text, meta_id: "cashflowFullscreenPeriod" do %>
    <div class="flex flex-wrap items-center justify-end gap-2">
      <label for="cashflow_show_subcategories_dialog" class="text-sm text-secondary"><%= t("pages.dashboard.cashflow_sankey.show_subcategories") %></label>
      <%= render DS::Toggle.new(
        id: "cashflow_show_subcategories_dialog",
        name: "cashflow_show_subcategories_overlay",
        checked: show_subcategories,
        data: { controller: "fullscreen", action: "change->fullscreen#toggleSubcategories", fullscreen_target_id_value: "cashflowSankeyChartFullscreen" }
      ) %>
    </div>
  <% end %>
  <% d.with_body do %>
    <div class="pb-4 -mx-2 sm:-mx-1">
      <div class="w-full max-w-[1400px] h-[calc(100svh-10rem)] min-h-64 mx-auto">
        <%= render "pages/dashboard/cashflow_sankey_chart",
              sankey_data: sankey_data,
              period: period,
              show_subcategories: show_subcategories,
              id: "cashflowSankeyChartFullscreen" %>
      </div>
    </div>
  <% end %>
<% end %>
