<%# locals: (balance_sheet:, **args) %>

<div class="space-y-6" id="balance-sheet">
  <% balance_sheet.classification_groups.each do |classification_group| %>
    <%# @container: the weight column gives way when the dashboard column is narrow
        (both side panels open), so the value column stays in view %>
    <div class="space-y-4 px-4 @container"
         data-controller="disclosure-group"
         data-disclosure-group-storage-key-value="sure.balanceSheetGroups.open"
         data-disclosure-group-expand-label-value="<%= t("shared.expand_all_toggle.expand_all") %>"
         data-disclosure-group-collapse-label-value="<%= t("shared.expand_all_toggle.collapse_all") %>">
      <div class="flex items-center justify-between gap-2">
        <h2 class="text-lg font-medium inline-flex items-center gap-1.5">
          <span class="<%= "animate-pulse" if classification_group.syncing? %>">
            <%= classification_group.name %>
          </span>

          <% if classification_group.account_groups.any? %>
            <span class="text-secondary">&middot;</span>
            <span class="text-secondary font-medium text-lg privacy-sensitive"><%= classification_group.total_money.format(precision: 0) %></span>
          <% end %>
        </h2>

        <% if classification_group.account_groups.any? %>
          <%= render "shared/expand_all_toggle" %>
        <% end %>
      </div>

      <% if classification_group.account_groups.any? %>
        <div class="space-y-4">
          <div class="flex gap-1">
            <% classification_group.account_groups.each do |account_group| %>
              <div class="h-1.5 rounded-sm" style="width: <%= account_group.weight %>%; background-color: <%= account_group.color %>;"></div>
            <% end %>
          </div>

          <div class="flex flex-wrap gap-4">
            <% classification_group.account_groups.each do |account_group| %>
              <div class="flex items-center gap-2 text-sm">
                <div class="h-2.5 w-2.5 rounded-full" style="background-color: <%= account_group.color %>;"></div>
                <p class="text-secondary"><%= account_group.name %></p>
                <p class="text-primary tabular-nums"><%= number_to_percentage(account_group.weight, precision: 1) %></p>
              </div>
            <% end %>
          </div>
        </div>

        <%# Names truncate and figures never wrap, so a narrow column needs no sideways
            scroll. Rows sit 4px inside their panel and take the container hover. %>
        <div class="bg-container-inset rounded-xl p-1 space-y-1">
          <div class="px-4 py-2 flex items-center gap-6 text-xs font-medium text-secondary">
            <p class="min-w-0 flex-1 truncate"><%= t("pages.dashboard.balance_sheet.name") %></p>
            <p class="w-28 shrink-0 text-right hidden @lg:block"><%= t("pages.dashboard.balance_sheet.weight") %></p>
            <p class="@lg:min-w-40 shrink-0 text-right"><%= t("pages.dashboard.balance_sheet.value") %></p>
          </div>

          <div class="p-1 rounded-lg bg-container shadow-border-xs font-medium text-sm">
            <% classification_group.account_groups.each_with_index do |account_group, idx| %>
              <details data-disclosure-group-key="<%= account_group.key %>" class="group">
                <summary class="cursor-pointer px-3 py-3 rounded-lg flex items-center gap-6 hover:bg-container-hover focus-ring">
                  <div class="min-w-0 flex-1 flex items-center gap-4">
                    <%= icon("chevron-right", class: "shrink-0 group-open:rotate-90 motion-safe:transition-transform") %>

                    <p class="min-w-0 truncate"><%= account_group.name %></p>
                  </div>

                  <div class="w-28 shrink-0 hidden @lg:flex items-center justify-end gap-2">
                    <%= render "pages/dashboard/group_weight", weight: account_group.weight, color: account_group.color %>
                  </div>

                  <p class="@lg:min-w-40 shrink-0 text-right whitespace-nowrap tabular-nums privacy-sensitive"><%= format_money(account_group.total_money) %></p>
                </summary>

                <div>
                  <% account_group.accounts.each_with_index do |account, idx| %>
                    <div class="pl-11 pr-3 py-3 flex items-center gap-6 text-sm font-medium">
                      <div class="min-w-0 flex-1 flex items-center gap-3">
                        <%= render "accounts/logo", account: account, size: "sm", color: account_group.color %>

                        <%= link_to account.name, account_path(account), class: "min-w-0 truncate rounded-sm focus-ring" %>
                      </div>

                      <div class="w-28 shrink-0 hidden @lg:flex items-center justify-end gap-2">
                        <%
                            # Calculate weight as percentage of classification total
                            classification_total = classification_group.total_money.amount
                            account_weight = classification_total.zero? ? 0 : account.converted_balance / classification_total * 100
                        %>
                        <%= render "pages/dashboard/group_weight", weight: account_weight, color: account_group.color %>
                      </div>

                      <p class="@lg:min-w-40 shrink-0 text-right whitespace-nowrap tabular-nums privacy-sensitive"><%= format_money(account.balance_money) %></p>
                    </div>

                    <% if idx < account_group.accounts.size - 1 %>
                      <%= render "shared/ruler", classes: "ml-20 mr-3" %>
                    <% end %>
                  <% end %>
                </div>
              </details>
              <% unless idx == classification_group.account_groups.size - 1 %>
                <%= render "shared/ruler", classes: "mx-3 group-ruler" %>
              <% end %>
            <% end %>
          </div>
        </div>

      <% else %>
        <div class="py-10 flex flex-col items-center">
          <%= render DS::FilledIcon.new(
            variant: :container,
            icon: classification_group.icon,
          ) %>

          <p class="text-primary text-sm font-medium mb-1 mt-4">
            <%= t("pages.dashboard.balance_sheet.no_items", name: classification_group.name) %>
          </p>
          <p class="text-secondary text-sm text-center">
            <%= t("pages.dashboard.balance_sheet.add_accounts", name: classification_group.name) %>
          </p>
        </div>
      <% end %>
    </div>
  <% end %>
</div>

<%# Custom style for hiding ruler when details are open %>
<style>
  details[open] + .group-ruler {
    display: none;
  }
</style>
