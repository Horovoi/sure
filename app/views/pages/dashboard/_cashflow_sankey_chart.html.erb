<%# locals: (sankey_data:, period:, show_subcategories:, id:) %>
<div
  id="<%= id %>"
  data-controller="sankey-chart"
  data-sankey-chart-data-value="<%= sankey_data.to_json %>"
  data-sankey-chart-show-subcategories-value="<%= show_subcategories %>"
  data-sankey-chart-currency-symbol-value="<%= sankey_data[:currency_symbol] %>"
  data-period-text="<%= period.key.present? ? period.label : period.comparison_label %>"
  class="w-full h-full"></div>
