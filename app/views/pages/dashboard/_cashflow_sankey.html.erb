<%# locals: (sankey_data:, period:, show_subcategories: false) %>
<%= turbo_frame_tag "cashflow_sankey_section" do %>
<div id="cashflow-sankey-chart">
  <%# The section header names the widget: the controls row holds the period, the
      subcategory toggle and the expand button %>
  <div class="flex flex-wrap items-center justify-end gap-2 px-4 mb-4">
    <%= form_with url: root_path, method: :get, data: { controller: "auto-submit-form", turbo_frame: "cashflow_sankey_section" } do |form| %>
      <div class="flex flex-wrap items-center gap-2">
        <% cashflow_options = Period.as_options + [ [ t("pages.dashboard.cashflow_sankey.custom"), "custom" ] ] %>
        <% selected_key = period.key || "custom" %>
        <%= form.select :cashflow_period,
                  cashflow_options,
                  { selected: selected_key },
                  data: { "auto-submit-form-target": "auto" },
                  aria: { label: t("pages.dashboard.cashflow_sankey.period_label") },
                  class: "h-9 py-0 pl-3 pr-8 bg-container border border-secondary font-medium rounded-lg text-sm cursor-pointer text-primary focus-ring focus:ring-0 focus:border-secondary" %>

        <%# When in custom mode, show start/end date pickers %>
        <% if period.key.nil? %>
          <div class="flex items-center gap-2">
            <%= form.date_field :cashflow_start_date,
                  value: period.start_date,
                  data: { "auto-submit-form-target": "auto" },
                  aria: { label: t("pages.dashboard.cashflow_sankey.start_date") },
                  class: "h-9 py-0 px-2 bg-container border border-secondary rounded-lg text-sm text-primary focus-ring focus:ring-0 focus:border-secondary" %>
            <span class="text-secondary text-sm"><%= t("pages.dashboard.cashflow_sankey.to") %></span>
            <%= form.date_field :cashflow_end_date,
                  value: period.end_date,
                  data: { "auto-submit-form-target": "auto" },
                  aria: { label: t("pages.dashboard.cashflow_sankey.end_date") },
                  class: "h-9 py-0 px-2 bg-container border border-secondary rounded-lg text-sm text-primary focus-ring focus:ring-0 focus:border-secondary" %>
          </div>
        <% end %>

        <%# The chart draws both modes from one payload, so the toggle needs no request.
            It stays in the form so a period change keeps the mode. %>
        <div class="flex items-center gap-2 sm:pl-2">
          <label for="cashflow_show_subcategories" class="text-sm text-secondary"><%= t("pages.dashboard.cashflow_sankey.show_subcategories") %></label>
          <%= render DS::Toggle.new(
            id: "cashflow_show_subcategories",
            name: "cashflow_show_subcategories",
            checked: show_subcategories,
            data: {
              controller: "cashflow-sync",
              action: "change->cashflow-sync#broadcast"
            }
          ) %>
        </div>
      </div>
    <% end %>

    <% if sankey_data[:links].present? %>
      <%= render DS::Button.new(
        variant: :icon,
        icon: "maximize-2",
        type: "button",
        title: t("pages.dashboard.cashflow_sankey.expand"),
        aria: { label: t("pages.dashboard.cashflow_sankey.expand") },
        data: { controller: "fullscreen", action: "click->fullscreen#open", fullscreen_target_id_value: "cashflow_sankey_dialog" },
        class: "hidden sm:inline-flex"
      ) %>
    <% end %>
  </div>

  <% if sankey_data[:links].present? %>
    <div class="w-full h-[26rem] md:h-[28rem]">
      <%= render "pages/dashboard/cashflow_sankey_chart",
            sankey_data: sankey_data,
            period: period,
            show_subcategories: show_subcategories,
            id: "cashflowSankeyChart" %>
    </div>
  <% else %>
    <div class="h-[340px] lg:h-[380px] bg-container py-4 flex flex-col items-center justify-center">
      <div class="space-y-3 text-center flex flex-col items-center">
        <%= render DS::FilledIcon.new(
          variant: :container,
          icon: "activity" # cashflow placeholder icon
        ) %>

        <p class="text-sm font-medium text-primary"><%= t("pages.dashboard.cashflow_sankey.no_data_title") %></p>
        <p class="text-secondary text-sm"><%= t("pages.dashboard.cashflow_sankey.no_data_description") %></p>
        <%= render DS::Link.new(
          text: t("pages.dashboard.cashflow_sankey.add_transaction"),
          icon: "plus",
          href: new_transaction_path,
          frame: :modal
        ) %>
      </div>
    </div>
  <% end %>
</div>
<% end %>

<%# The fullscreen dialog is in dashboard.html.erb, outside this frame, so a frame refresh does not close it %>
