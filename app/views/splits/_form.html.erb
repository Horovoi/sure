<%# locals: (entry:, parts:, title:, submit_text:, method:) %>
<% currency = Money::Currency.new(entry.currency)
   # A transaction may carry more decimals than its currency shows (a converted amount);
   # the parts then take as many, so they can add up to it exactly
   decimals = entry.amount.abs.to_s("F").split(".").last.to_s.sub(/0+\z/, "").length
   precision = [ currency.default_precision, decimals ].max
   total_minor = (entry.amount.abs * 10**precision).round.to_i
   step = (BigDecimal(1) / 10**precision).to_s("F")
   classification = entry.amount.negative? ? "income" : "expense"
   categories = @categories
   blank_part = SplitsController::Part.new(name: "", tag_ids: [], merchant_id: entry.transaction.merchant_id) %>

<%= render DS::Dialog.new(variant: "modal", width: "lg", disable_click_outside: true) do |dialog| %>
  <% dialog.with_header(title: title) do %>
    <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
      <p class="text-sm text-secondary min-w-0 truncate">
        <%= entry.name %> · <%= l(entry.date, format: :long) %> · <%= entry.account.name %>
      </p>
      <p class="text-sm text-secondary shrink-0">
        <%= t("splits.form.total") %>
        <span class="font-medium text-primary privacy-sensitive"><%= format_money(-entry.amount_money) %></span>
      </p>
    </div>
  <% end %>

  <% dialog.with_body do %>
    <%= styled_form_with url: transaction_split_path(entry),
          method: method,
          scope: :split,
          class: "space-y-3",
          data: {
            controller: "split-editor",
            action: "submit->split-editor#submit",
            split_editor_total_value: total_minor,
            split_editor_precision_value: precision,
            split_editor_currency_value: entry.currency,
            split_editor_next_index_value: parts.size,
            split_editor_balanced_text_value: t("splits.form.balanced"),
            split_editor_left_text_value: t("splits.form.left", amount: "%{amount}"),
            split_editor_over_text_value: t("splits.form.over", amount: "%{amount}"),
            split_editor_min_parts_text_value: t("splits.form.min_parts"),
            split_editor_zero_part_text_value: t("splits.form.zero_part")
          } do |f| %>

      <p class="text-sm text-secondary"><%= t("splits.form.intro") %></p>

      <% if @error.present? %>
        <%= render DS::Alert.new(message: @error, variant: :error, live: :alert) %>
      <% end %>

      <div class="space-y-3" data-split-editor-target="rows">
        <% parts.each_with_index do |part, index| %>
          <%= render "splits/part", part: part, index: index, categories: categories, merchants: @merchants, tags: @tags, step: step, precision: precision, classification: classification %>
        <% end %>
      </div>

      <template data-split-editor-target="template">
        <%= render "splits/part", part: blank_part, index: "__INDEX__", categories: categories, merchants: @merchants, tags: @tags, step: step, precision: precision, classification: classification %>
      </template>

      <%= render DS::Button.new(
            text: t("splits.form.add_part"),
            variant: "outline",
            icon: "plus",
            type: "button",
            full_width: true,
            data: { action: "split-editor#add" }
          ) %>

      <p class="rounded-lg border px-3 py-2 text-sm font-medium privacy-sensitive
                data-[state=balanced]:border-success/30 data-[state=balanced]:bg-success/10 data-[state=balanced]:text-success
                data-[state=left]:border-warning/30 data-[state=left]:bg-warning/10 data-[state=left]:text-primary
                data-[state=over]:border-destructive/30 data-[state=over]:bg-destructive/10 data-[state=over]:text-destructive
                data-[state=invalid]:border-secondary data-[state=invalid]:text-secondary"
         role="status"
         aria-live="polite"
         data-state="invalid"
         data-split-editor-target="remaining"></p>

      <div class="flex flex-col-reverse sm:flex-row sm:justify-end gap-2 pt-2">
        <%= render DS::Button.new(
              text: t("splits.form.cancel"),
              variant: "outline",
              type: "button",
              data: { action: "DS--dialog#close" }
            ) %>
        <%= render DS::Button.new(
              text: submit_text,
              type: "submit",
              data: { split_editor_target: "submit", turbo_submits_with: t("splits.form.saving") }
            ) %>
      </div>
    <% end %>
  <% end %>
<% end %>
