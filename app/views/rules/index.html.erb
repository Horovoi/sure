<header class="flex flex-wrap justify-between items-center gap-x-4 gap-y-2">
  <h1 class="text-primary text-xl font-medium"><%= t(".page_title") %></h1>
  <div class="flex items-center gap-2">
    <% if @rules.any? %>
      <%= render DS::Menu.new do |menu| %>
        <% menu.with_item(
          variant: "button",
          text: t(".delete_all_rules"),
          href: destroy_all_rules_path,
          icon: "trash-2",
          method: :delete,
          confirm: CustomConfirm.for_resource_deletion(t(".all_rules"), high_severity: true)) %>
      <% end %>
      <%= render DS::Link.new(
        text: t("rules.apply_all.button"),
        variant: "outline",
        href: confirm_all_rules_path,
        icon: "play",
        frame: :modal
      ) %>
    <% end %>
    <%= render DS::Link.new(
      text: t(".new_rule"),
      variant: "primary",
      href: new_rule_path(resource_type: "transaction"),
      icon: "plus",
      frame: :modal
    ) %>
  </div>
</header>
<% if self_hosted? %>
  <div class="py-4">
    <%= render DS::Alert.new(message: t(".ai_cost_warning"), variant: :warning) %>
  </div>
<% end %>
<div class="bg-container rounded-xl shadow-border-xs p-4">
  <% if @rules.any? %>
    <div class="bg-container-inset rounded-xl">
      <div class="flex justify-between px-4 py-2 text-xs">
        <div class="flex items-center gap-1.5 font-medium text-secondary">
          <p><%= t(".rules_heading") %></p>
          <span class="text-subdued" aria-hidden="true">&middot;</span>
          <p class="tabular-nums"><%= @rules.size %></p>
        </div>
      </div>
      <p class="px-4 pb-2 text-sm text-secondary"><%= t(".order_hint") %></p>
      <div class="p-1">
        <div class="flex flex-col bg-container rounded-lg shadow-border-xs"
             id="rules_list"
             data-controller="rules-sortable"
             data-rules-sortable-url-value="<%= reorder_rules_path %>"
             data-action="dragover->rules-sortable#dragOver drop->rules-sortable#drop"
             role="list"
             aria-label="<%= t(".rules_heading") %>">
          <% @rules.each do |rule| %>
            <div class="flex items-center gap-1 pl-1 border-t border-divider first:border-t-0 first:rounded-t-lg last:rounded-b-lg focus-ring"
                 data-rules-sortable-target="section"
                 data-section-key="<%= rule.id %>"
                 draggable="true"
                 tabindex="0"
                 role="listitem"
                 aria-grabbed="false"
                 aria-label="<%= t(".reorder_rule", name: rule.name.presence || rule.primary_condition_title) %>"
                 data-action="dragstart->rules-sortable#dragStart dragend->rules-sortable#dragEnd keydown->rules-sortable#handleKeyDown">
              <%= render DS::Button.new(
                    variant: "icon",
                    size: "sm",
                    icon: "grip-vertical",
                    type: "button",
                    class: "shrink-0 cursor-grab active:cursor-grabbing",
                    title: t(".drag_to_reorder"),
                    aria: { label: t(".drag_to_reorder") },
                    data: {
                      rules_sortable_target: "handle",
                      action: "touchstart->rules-sortable#touchStart touchmove->rules-sortable#touchMove touchend->rules-sortable#touchEnd touchcancel->rules-sortable#touchCancel"
                    }
                  ) %>
              <div class="grow min-w-0">
                <%= render "rule", rule: rule %>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  <% else %>
    <%= render DS::EmptyState.new(icon: "git-branch", title: t(".no_rules_title"), description: t(".no_rules_description")) do |empty| %>
      <% empty.with_action do %>
        <%= render DS::Link.new(
          text: t(".new_rule"),
          variant: "primary",
          href: new_rule_path(resource_type: "transaction"),
          icon: "plus",
          frame: :modal
        ) %>
      <% end %>
    <% end %>
  <% end %>
</div>

<%# Recent runs %>
<% if @recent_runs.any? %>
  <div class="mt-6 bg-container rounded-xl shadow-border-xs p-4">
    <div class="mb-4">
      <h2 class="text-primary text-lg font-medium mb-1"><%= t("rules.recent_runs.title") %></h2>
      <p class="text-sm text-secondary"><%= t("rules.recent_runs.description") %></p>
    </div>

    <div class="overflow-x-auto">
      <table class="w-full">
        <thead class="border-b border-divider">
          <tr>
            <th class="px-4 py-3 text-left text-xs font-medium text-secondary">
              <%= t("rules.recent_runs.columns.date_time") %>
            </th>
            <th class="px-4 py-3 text-center text-xs font-medium text-secondary">
              <%= t("rules.recent_runs.columns.execution_type") %>
            </th>
            <th class="px-4 py-3 text-center text-xs font-medium text-secondary">
              <%= t("rules.recent_runs.columns.status") %>
            </th>
            <th class="px-4 py-3 text-left text-xs font-medium text-secondary">
              <%= t("rules.recent_runs.columns.rule_name") %>
            </th>
            <th class="px-4 py-3 text-center text-xs font-medium text-secondary">
              <div class="flex flex-col leading-tight">
                <div><%= t("rules.recent_runs.columns.transactions_counts.queued") %></div>
                <div><%= t("rules.recent_runs.columns.transactions_counts.processed") %></div>
                <div><%= t("rules.recent_runs.columns.transactions_counts.modified") %></div>
                <div><%= t("rules.recent_runs.columns.transactions_counts.blocked") %></div>
              </div>
            </th>
          </tr>
        </thead>
        <tbody class="divide-y divide-subdued">
          <% @recent_runs.each do |run| %>
            <tr class="<%= "bg-destructive/5" if run.failed? %>">
              <td class="px-4 py-3 text-sm text-primary whitespace-nowrap">
                <%= l(run.executed_at, format: :rule_run) %>
              </td>
              <td class="px-4 py-3 text-sm text-primary text-center">
                <%= render DS::Pill.new(label: t("rules.recent_runs.execution_types.#{run.execution_type}"), tone: run.execution_type == "manual" ? :info : :violet, marker: false) %>
              </td>
              <td class="px-4 py-3 text-sm text-center">
                <div class="flex items-center justify-center gap-2">
                  <%= render DS::Pill.new(label: t("rules.recent_runs.statuses.#{run.status}"), tone: run.pending? ? :warning : (run.success? ? :success : :error), marker: false) %>
                  <% if run.failed? && run.error_message.present? %>
                    <div data-controller="tooltip" data-tooltip-content-value="<%= run.error_message %>">
                      <%= icon("info", size: "sm", color: "destructive") %>
                    </div>
                  <% end %>
                </div>
              </td>
              <td class="px-4 py-3 text-sm text-primary">
                <%= run.rule_name.presence || run.rule&.name.presence || t("rules.recent_runs.unnamed_rule") %>
              </td>
              <td class="px-4 py-3 text-sm text-primary text-center tabular-nums">
                <%= "#{number_with_delimiter(run.transactions_queued)} / #{number_with_delimiter(run.transactions_processed)} / #{number_with_delimiter(run.transactions_modified)} / #{number_with_delimiter(run.transactions_blocked)}" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <% if @pagy.pages > 1 %>
      <div class="mt-4">
        <%= render "shared/pagination", pagy: @pagy %>
      </div>
    <% end %>
  </div>
<% end %>
