<%# The same width as the new-goal dialog: one form, one size %>
<%= render DS::Dialog.new(width: "lg") do |dialog| %>
  <%# The header stays on screen while the long form scrolls under it %>
  <% dialog.with_header(title: t(".heading"), class: goal_dialog_header_classes) %>
  <% dialog.with_body do %>
    <%= render "form", goal: @goal, linkable_accounts: @linkable_accounts, currently_linked_account_ids: @currently_linked_account_ids, pooled_allocations: @pooled_allocations %>
  <% end %>
<% end %>
