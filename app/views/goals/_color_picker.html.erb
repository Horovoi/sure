<%# locals: (form:, colors:, icons:) %>
<div data-controller="color-icon-picker"
     data-color-icon-picker-preset-colors-value="<%= colors.to_json %>"
     data-color-icon-picker-poor-contrast-message-value="<%= t("goals.color_picker.poor_contrast_validity") %>">
  <div class="w-fit relative">
    <span class="goal-avatar inline-flex items-center justify-center w-11 h-11 rounded-xl font-semibold text-base"
          style="--avatar-color: <%= form.object.color %>;"
          data-color-icon-picker-target="avatar"
          data-goal-form-target="avatarPreview">
      <% if form.object.icon.present? %>
        <%= icon(form.object.icon, color: "current", size: "md") %>
      <% elsif form.object.name.present? %>
        <%= form.object.name.strip.first&.upcase %>
      <% else %>
        <%= icon("target", color: "current", size: "md") %>
      <% end %>
    </span>

    <%= render DS::Disclosure.new(
          variant: :bare,
          summary_aria_label: t("goals.color_picker.trigger_label"),
          summary_class: "list-none [&::-webkit-details-marker]:hidden cursor-pointer absolute -bottom-1 -right-1 inline-flex w-fit h-6 min-w-6 justify-center items-center rounded-md bg-surface-inset hover:bg-surface-inset-hover ring-2 ring-container text-secondary focus-ring",
          data: {
            color_icon_picker_target: "details",
            action: "mousedown->color-icon-picker#handleOutsideClick"
          }) do |d| %>
      <% d.with_summary_content do %>
        <%= icon("pen", size: "xs") %>
      <% end %>

      <%# The overlay recipe: an opaque container panel, rounded-lg, shadow-border-lg %>
      <div class="absolute top-full left-1/2 -translate-x-1/2 mt-1 z-50 bg-container p-3 rounded-lg shadow-border-lg w-80 max-w-[calc(100vw-2rem)] max-h-[60vh] h-fit overflow-y-auto"
           data-color-icon-picker-target="popup">
        <div class="flex gap-2 flex-col mb-3" data-color-icon-picker-target="selection">
          <div data-color-icon-picker-target="pickerSection"></div>
          <h4 class="text-xs font-medium text-secondary"><%= t("goals.color_picker.color_heading") %></h4>
          <div class="flex flex-wrap gap-2 items-center" data-color-icon-picker-target="colorsSection">
            <% colors.each do |c| %>
              <label class="relative">
                <%= form.radio_button :color, c, class: "sr-only peer", data: { action: "change->color-icon-picker#handleColorChange" } %>
                <div class="w-6 h-6 rounded-full cursor-pointer peer-checked:ring-2 peer-checked:ring-text-primary peer-checked:ring-offset-2 peer-checked:ring-offset-container peer-focus-visible:outline-2 peer-focus-visible:outline-offset-4 peer-focus-visible:outline-focus-ring" style="background-color: <%= c %>"></div>
              </label>
            <% end %>
            <label class="relative">
              <%= form.radio_button :color, "custom-color", class: "sr-only peer", data: { color_icon_picker_target: "colorPickerRadioBtn" } %>
              <div class="w-6 h-6 rounded-full cursor-pointer peer-checked:ring-2 peer-checked:ring-text-primary peer-checked:ring-offset-2 peer-checked:ring-offset-container peer-focus-visible:outline-2 peer-focus-visible:outline-offset-4 peer-focus-visible:outline-focus-ring" data-color-icon-picker-target="pickerBtn" style="background: conic-gradient(red,orange,yellow,lime,green,teal,cyan,blue,indigo,purple,magenta,pink,red)"></div>
            </label>
          </div>
          <div class="hidden flex-col gap-2" data-color-icon-picker-target="paletteSection">
            <div class="flex gap-2 items-center w-full">
              <div class="w-6 h-6 p-4 rounded-full cursor-pointer" style="background-color: <%= form.object.color %>" data-color-icon-picker-target="colorPreview"></div>
              <%= form.text_field :color, data: { color_icon_picker_target: "colorInput" }, inline: true, pattern: "^#[0-9A-Fa-f]{6}$" %>
              <%= render DS::Button.new(variant: "icon", icon: "palette", aria: { label: t("goals.color_picker.presets") }, data: { action: "click->color-icon-picker#toggleSections" }) %>
            </div>
            <div data-color-icon-picker-target="validationMessage" class="hidden self-start gap-1 items-center text-xs text-destructive">
              <span><%= t("goals.color_picker.poor_contrast") %></span>
              <button type="button" class="underline cursor-pointer rounded-sm focus-ring" data-action="color-icon-picker#autoAdjust"><%= t("goals.color_picker.auto_adjust") %></button>
            </div>
          </div>
        </div>

        <div class="flex flex-col gap-2">
          <h4 class="text-xs font-medium text-secondary"><%= t("goals.color_picker.icon_heading") %></h4>
          <%= render DS::IconPicker.new(form: form, method: :icon, icons: icons, picker_controller: "color-icon-picker") %>
        </div>
      </div>
    <% end %>
  </div>
</div>
