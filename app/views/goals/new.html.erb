<% if turbo_frame_request? %>
  <%= render DS::Dialog.new(width: "lg") do |dialog| %>
    <%# The header stays on screen while the long form scrolls under it %>
    <% dialog.with_header(title: t(".heading"), subtitle: t(".subtitle"), class: goal_dialog_header_classes) %>
    <% dialog.with_body do %>
      <%= render "form", goal: @goal, linkable_accounts: @linkable_accounts, currently_linked_account_ids: @currently_linked_account_ids, pooled_allocations: @pooled_allocations, return_to: @return_to %>
    <% end %>
  <% end %>
<% else %>
  <div class="max-w-2xl mx-auto py-8 px-4">
    <header class="mb-6 flex items-start gap-3">
      <%= render DS::FilledIcon.new(variant: :container, icon: "target", size: "md", rounded: true) %>
      <div>
        <h1 class="text-2xl font-medium text-primary"><%= t(".heading") %></h1>
        <p class="text-sm text-secondary mt-0.5"><%= t(".subtitle") %></p>
      </div>
    </header>
    <%= render "form", goal: @goal, linkable_accounts: @linkable_accounts, currently_linked_account_ids: @currently_linked_account_ids, pooled_allocations: @pooled_allocations, return_to: @return_to %>
  </div>
<% end %>
