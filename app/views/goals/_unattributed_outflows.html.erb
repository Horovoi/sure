<%# locals: (goal:, outflows:) %>

<%# Money left this goal's accounts and nothing says where it went
    (Goal::WithdrawalDetector). A goal reads balances, not transactions, so
    without this the outflow reaches it only as a smaller number. %>
<div class="@container bg-container rounded-xl shadow-border-xs p-4 space-y-3">
  <div class="flex items-start gap-3">
    <div class="w-8 h-8 rounded-full bg-surface-inset inline-flex items-center justify-center text-secondary shrink-0">
      <%= icon("arrow-down-left", size: "sm") %>
    </div>
    <div class="min-w-0">
      <h2 class="text-sm font-medium text-primary"><%= t(".heading") %></h2>
      <p class="text-xs text-secondary mt-0.5"><%= t(".body", goal: goal.name) %></p>
    </div>
  </div>

  <ul class="space-y-2">
    <% outflows.each do |entry| %>
      <%# Below @md the amount and the button go under the text, so the name
          and the date keep the row's width %>
      <li class="flex flex-col gap-2 rounded-lg bg-surface-inset px-3 py-2 @md:flex-row @md:items-center @md:justify-between @md:gap-3">
        <div class="min-w-0">
          <p class="text-sm text-primary truncate"><%= entry.name %></p>
          <p class="flex min-w-0 items-center gap-1 text-xs text-secondary tabular-nums">
            <span class="shrink-0 whitespace-nowrap privacy-sensitive"><%= l(entry.date, format: "%B %-d, %Y") %></span>
            <span class="shrink-0" aria-hidden="true">·</span>
            <span class="min-w-0 truncate privacy-sensitive"><%= entry.account.name %></span>
          </p>
        </div>
        <div class="flex items-center justify-between gap-2 shrink-0">
          <span class="text-sm text-primary tabular-nums whitespace-nowrap privacy-sensitive">
            <%= Money.new(entry.amount, entry.currency).format(precision: 0) %>
          </span>
          <%= render DS::Button.new(
                text: t(".attribute"),
                href: consume_goal_path(goal),
                method: :post,
                params: { transaction_id: entry.entryable_id },
                variant: :secondary,
                size: :sm
              ) %>
        </div>
      </li>
    <% end %>
  </ul>
</div>
