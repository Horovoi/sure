<%# locals: (accountable:, autofocus: false) %>

<%# Without bank connections the only method is manual entry, so go straight to the form %>
<%= link_to new_polymorphic_path(accountable, step: (bank_connections_enabled? ? "method_select" : nil), return_to: params[:return_to]),
            autofocus: autofocus,
            class: "flex items-center gap-4 w-full px-3 py-2 rounded-lg text-left text-primary hover:bg-container-hover focus:bg-container-hover focus-visible:outline-hidden" do %>
  <%= render DS::FilledIcon.new(
    icon: accountable.icon,
    hex_color: accountable.color,
  ) %>

  <%= accountable.display_name.singularize %>
<% end %>
