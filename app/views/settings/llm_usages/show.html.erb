<% content_for :page_title, t(".page_title") %>

<%# The page title names the page: the first section carries only its description %>
<%= settings_section title: nil, subtitle: t(".subtitle") do %>
  <%# One filter row: labelled fields, then one outline button, aligned to the bottom %>
  <%= form_with url: settings_llm_usage_path, method: :get, class: "flex flex-wrap items-end gap-2" do |f| %>
    <div class="form-field w-full sm:w-44">
      <div class="form-field__body">
        <%= f.label :start_date, t(".start_date"), class: "form-field__label" %>
        <%= f.date_field :start_date, value: @start_date, class: "form-field__input" %>
      </div>
    </div>
    <div class="form-field w-full sm:w-44">
      <div class="form-field__body">
        <%= f.label :end_date, t(".end_date"), class: "form-field__label" %>
        <%= f.date_field :end_date, value: @end_date, class: "form-field__input" %>
      </div>
    </div>
    <%= render DS::Button.new(variant: :outline, size: :md, type: "submit", text: t(".filter")) %>
  <% end %>

  <div class="@container">
  <div class="grid grid-cols-1 @lg:grid-cols-2 @3xl:grid-cols-4 gap-2">
    <div class="bg-container-inset rounded-lg p-4">
      <div class="flex items-center gap-2 mb-2">
        <%= icon "activity", class: "w-5 h-5 text-secondary" %>
        <p class="text-xs font-medium text-secondary"><%= t(".total_requests") %></p>
      </div>
      <p class="text-2xl font-medium text-primary tabular-nums"><%= number_with_delimiter(@statistics[:total_requests]) %></p>
    </div>

    <div class="bg-container-inset rounded-lg p-4">
      <div class="flex items-center gap-2 mb-2">
        <%= icon "hash", class: "w-5 h-5 text-secondary" %>
        <p class="text-xs font-medium text-secondary"><%= t(".total_tokens") %></p>
      </div>
      <p class="text-2xl font-medium text-primary tabular-nums"><%= number_with_delimiter(@statistics[:total_tokens]) %></p>
      <p class="text-xs text-secondary mt-1">
        <%= t(".token_split",
              prompt: number_with_delimiter(@statistics[:total_prompt_tokens]),
              completion: number_with_delimiter(@statistics[:total_completion_tokens])) %>
      </p>
    </div>

    <div class="bg-container-inset rounded-lg p-4">
      <div class="flex items-center gap-2 mb-2">
        <%= icon "dollar-sign", class: "w-5 h-5 text-secondary" %>
        <p class="text-xs font-medium text-secondary"><%= t(".total_cost") %></p>
      </div>
      <p class="text-2xl font-medium text-primary tabular-nums" data-testid="llm-total-cost"><%= format_llm_cost(@statistics[:total_cost], precision: 2) %></p>
      <% if @statistics[:subscription_requests].positive? %>
        <p class="text-xs text-secondary mt-1">
          <%= t(".subscription_total",
                count: @statistics[:subscription_requests],
                cost: format_llm_cost(@statistics[:subscription_equivalent_cost], precision: 2)) %>
        </p>
      <% end %>
    </div>

    <div class="bg-container-inset rounded-lg p-4">
      <div class="flex items-center gap-2 mb-2">
        <%= icon "trending-up", class: "w-5 h-5 text-secondary" %>
        <p class="text-xs font-medium text-secondary"><%= t(".avg_cost") %></p>
      </div>
      <p class="text-2xl font-medium text-primary tabular-nums"><%= format_llm_cost(@statistics[:avg_cost], precision: 4) %></p>
      <% if @statistics[:requests_with_cost] < @statistics[:billed_requests] %>
        <p class="text-xs text-secondary mt-1">
          <%= t(".avg_cost_basis",
                with_cost: number_with_delimiter(@statistics[:requests_with_cost]),
                total: number_with_delimiter(@statistics[:billed_requests])) %>
        </p>
      <% end %>
    </div>
  </div>
  </div>
<% end %>

<% if @statistics[:by_operation].any? %>
  <%= settings_section title: t(".cost_by_operation") do %>
    <div>
      <div class="bg-container-inset rounded-lg p-4">
        <div class="space-y-2">
          <% @statistics[:by_operation].each do |operation, cost| %>
            <div class="flex justify-between items-center">
              <span class="text-sm text-primary"><%= operation.humanize %></span>
              <span class="text-sm font-medium text-primary tabular-nums whitespace-nowrap"><%= format_llm_cost(cost, precision: 4) %></span>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  <% end %>
<% end %>

<% if @statistics[:by_model].any? %>
  <%= settings_section title: t(".cost_by_model") do %>
    <div>
      <div class="bg-container-inset rounded-lg p-4">
        <div class="space-y-2">
          <% @statistics[:by_model].each do |model, cost| %>
            <div class="flex justify-between items-center">
              <span class="text-sm text-primary font-mono"><%= model %></span>
              <span class="text-sm font-medium text-primary tabular-nums whitespace-nowrap"><%= format_llm_cost(cost, precision: 4) %></span>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  <% end %>
<% end %>

<%= settings_section title: t(".recent_usage") do %>
  <div>
    <div class="bg-container-inset rounded-lg overflow-x-auto" tabindex="-1">
      <% if @llm_usages.any? %>
        <table class="w-full">
          <thead class="border-b border-divider">
            <tr>
              <th class="px-4 py-3 text-left text-xs font-medium text-secondary"><%= t(".columns.date") %></th>
              <th class="px-4 py-3 text-left text-xs font-medium text-secondary"><%= t(".columns.operation") %></th>
              <th class="px-4 py-3 text-left text-xs font-medium text-secondary"><%= t(".columns.model") %></th>
              <th class="px-4 py-3 text-right text-xs font-medium text-secondary"><%= t(".columns.tokens") %></th>
              <th class="px-4 py-3 text-right text-xs font-medium text-secondary"><%= t(".columns.cost") %></th>
            </tr>
          </thead>
          <tbody class="divide-y divide-primary">
            <% @llm_usages.each do |usage| %>
              <tr class="<%= "bg-destructive/10" if usage.failed? %>">
                <td class="px-4 py-3 text-sm text-primary whitespace-nowrap">
                  <%= usage.created_at.strftime("%b %-d, %Y %H:%M") %>
                </td>
                <td class="px-4 py-3 text-sm text-primary">
                  <%= usage.operation.humanize %>
                </td>
                <td class="px-4 py-3 text-sm text-primary font-mono">
                  <%= usage.model %>
                </td>
                <td class="px-4 py-3 text-sm text-primary text-right whitespace-nowrap">
                  <% if usage.failed? %>
                    <div data-controller="tooltip" class="inline-flex justify-end">
                      <div class="inline-flex items-center gap-1 cursor-help">
                        <%= icon "alert-circle", size: "sm", color: "destructive" %>
                        <span class="text-destructive font-medium"><%= t(".failed") %></span>
                      </div>
                      <div role="tooltip" data-tooltip-target="tooltip" class="tooltip bg-container shadow-border-md text-sm p-3 rounded w-72 text-left break-words whitespace-normal hidden">
                        <% if usage.http_status_code.present? %>
                          <p class="text-xs mt-1 text-secondary"><%= t(".http_status", status: usage.http_status_code) %></p>
                        <% end %>
                        <p class="text-xs text-primary"><%= usage.error_message %></p>
                      </div>
                    </div>
                  <% else %>
                    <%= number_with_delimiter(usage.total_tokens) %>
                    <span class="text-xs text-secondary">
                      (<%= number_with_delimiter(usage.prompt_tokens) %>/<%= number_with_delimiter(usage.completion_tokens) %>)
                    </span>
                  <% end %>
                </td>
                <td class="px-4 py-3 text-sm font-medium text-primary text-right whitespace-nowrap">
                  <% if usage.subscription? %>
                    <span class="text-secondary" data-testid="llm-subscription-cost">
                      <%= t(".subscription_cost", cost: format_llm_cost(usage.estimated_cost, precision: 4)) %>
                    </span>
                  <% else %>
                    <%= format_llm_cost(usage.estimated_cost, precision: 4) %>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% else %>
        <%= render DS::EmptyState.new(icon: "activity", title: t(".empty"), class: "py-8") %>
      <% end %>
    </div>
  </div>

<% end %>

<%= render DS::Alert.new(variant: :info, message: t(".pricing_note", verified_on: l(LlmUsage::PRICING_VERIFIED_ON, format: :long))) %>
