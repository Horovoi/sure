<%# locals: (status:, time_zone:, model_options:, current_model:) %>

<%= turbo_frame_tag "claude_card" do %>
  <div class="space-y-4" data-testid="claude-card">
    <div class="flex items-center gap-3">
      <div class="w-9 h-9 rounded-full bg-surface-inset flex justify-center items-center">
        <%= icon "sparkles" %>
      </div>
      <div class="min-w-0">
        <p class="text-sm font-medium text-primary"><%= t("settings.ai_prompts.claude_card.title") %></p>
        <p class="text-xs text-secondary"><%= t("settings.ai_prompts.claude_card.subtitle") %></p>
      </div>
    </div>

    <div class="pl-12 space-y-3">
      <% if !status["configured"] %>
        <p class="text-sm text-secondary" data-testid="claude-not-configured"><%= t("settings.ai_prompts.claude_card.not_configured") %></p>
        <pre class="text-xs font-mono text-primary bg-container-inset rounded-lg px-3 py-2 whitespace-pre-wrap">bin/claude-bridge install</pre>
      <% elsif status["ok"] %>
        <% account = status["account"].is_a?(Hash) ? status["account"] : {} %>
        <div class="flex flex-wrap items-center gap-2">
          <span class="inline-flex items-center gap-1 text-xs font-medium text-success" data-testid="claude-bridge-up">
            <%= icon "circle-check", size: "sm", color: "success" %>
            <%= t("settings.ai_prompts.claude_card.bridge_up") %>
          </span>
          <% if account["email"].present? %>
            <span class="text-xs text-secondary"><%= t("settings.ai_prompts.claude_card.account", email: account["email"]) %></span>
          <% end %>
          <% if status["plan"].present? %>
            <span class="text-xs text-secondary"><%= t("settings.ai_prompts.claude_card.plan", plan: status["plan"].to_s.humanize) %></span>
          <% end %>
          <% if status["cli_version"].present? %>
            <span class="text-xs text-secondary"><%= t("settings.ai_prompts.claude_card.version", version: status["cli_version"]) %></span>
          <% end %>
        </div>

        <% windows = claude_usage_windows(status) %>
        <% if windows.any? %>
          <div class="space-y-2">
            <% windows.each do |window| %>
              <div class="space-y-1" data-testid="claude-usage-<%= window[:name] %>">
                <div class="flex items-center justify-between gap-2 text-xs">
                  <span class="text-primary font-medium"><%= t("settings.ai_prompts.claude_card.windows.#{window[:name]}") %></span>
                  <span class="text-secondary">
                    <%= window[:percent] ? t("settings.ai_prompts.claude_card.used", percent: window[:percent]) : t("settings.ai_prompts.claude_card.unknown") %>
                    <% if (reset = claude_reset_time(window[:resets_at], time_zone)) %>
                      · <%= t("settings.ai_prompts.claude_card.resets", time: reset) %>
                    <% end %>
                  </span>
                </div>
                <div class="h-1.5 w-full rounded-full bg-surface-inset overflow-hidden"
                     role="progressbar"
                     aria-label="<%= t("settings.ai_prompts.claude_card.windows.#{window[:name]}") %>"
                     aria-valuemin="0"
                     aria-valuemax="100"
                     aria-valuenow="<%= window[:percent] || 0 %>">
                  <div class="h-full rounded-full <%= claude_usage_bar_class(window[:percent]) %>" style="width: <%= window[:percent] || 0 %>%"></div>
                </div>
              </div>
            <% end %>
            <p class="text-xs text-secondary"><%= t("settings.ai_prompts.claude_card.time_zone", zone: time_zone) %></p>
          </div>
        <% else %>
          <p class="text-xs text-secondary"><%= t("settings.ai_prompts.claude_card.no_usage") %></p>
        <% end %>
      <% else %>
        <div class="space-y-2" data-testid="claude-bridge-down">
          <span class="inline-flex items-center gap-1 text-xs font-medium text-destructive">
            <%= icon "circle-alert", size: "sm", color: "destructive" %>
            <%= status["signed_in"] == false ? t("settings.ai_prompts.claude_card.signed_out") : t("settings.ai_prompts.claude_card.bridge_down") %>
          </span>
          <% if status.dig("error", "message").present? %>
            <p class="text-xs text-secondary"><%= status.dig("error", "message") %></p>
          <% end %>
          <p class="text-xs text-secondary"><%= t("settings.ai_prompts.claude_card.start_hint") %></p>
          <pre class="text-xs font-mono text-primary bg-container-inset rounded-lg px-3 py-2 whitespace-pre-wrap">bin/claude-bridge status
bin/claude-bridge run</pre>
        </div>
      <% end %>

      <% if model_options.any? %>
        <%= styled_form_with scope: :ai_chat,
                             url: settings_ai_chat_path,
                             method: :patch,
                             data: {
                               turbo_frame: "_top",
                               controller: "auto-submit-form",
                               "auto-submit-form-trigger-event-value": "change"
                             } do |form| %>
          <%= form.select :chat_model,
                          options_for_select([ [ t("settings.ai_prompts.claude_card.model_automatic"), "" ] ] + model_options, current_model),
                          { label: t("settings.ai_prompts.claude_card.model_label") },
                          { data: { "auto-submit-form-target": "auto" }, disabled: !Current.user.admin? } %>
        <% end %>
        <p class="text-xs text-secondary"><%= t("settings.ai_prompts.claude_card.model_hint") %></p>
      <% end %>
    </div>
  </div>
<% end %>
