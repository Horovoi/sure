<%= content_for :page_title, t(".page_title") %>

<% field_class = "rounded-lg border border-primary px-3 py-2 text-sm bg-container-inset text-primary w-full" %>
<% label_class = "block text-sm font-medium text-primary mb-1" %>

<div class="space-y-6">
  <%= settings_section title: t(".title"), subtitle: t(".subtitle") do %>
    <%= form_with url: settings_debug_path, method: :get, class: "grid grid-cols-1 md:grid-cols-2 gap-4 items-end" do |f| %>
      <% { category: @categories, level: @levels, source: @sources, provider_key: @provider_keys }.each do |name, values| %>
        <div>
          <%= f.label name, t(".filters.#{name}"), class: label_class %>
          <%= f.select name, options_for_select([ [ t(".filters.all"), "" ] ] + values.map { |value| [ value, value ] }, params[name]), {}, class: field_class %>
        </div>
      <% end %>
      <div>
        <%= f.label :start_date, t(".filters.start_date"), class: label_class %>
        <%= f.date_field :start_date, value: @start_date, class: field_class %>
      </div>
      <div>
        <%= f.label :end_date, t(".filters.end_date"), class: label_class %>
        <%= f.date_field :end_date, value: @end_date, class: field_class %>
      </div>
      <% Settings::DebugsController::FILTER_ID_PARAMS.each do |name| %>
        <div>
          <%= f.label name, t(".filters.#{name}"), class: label_class %>
          <%= f.text_field name, value: params[name], class: "#{field_class} font-mono" %>
        </div>
      <% end %>
      <div class="flex gap-2 md:col-span-2">
        <%= render DS::Button.new(variant: :primary, size: :md, type: "submit", text: t(".filters.submit"), class: "justify-center") %>
        <%= render DS::Link.new(text: t(".filters.reset"), href: settings_debug_path, variant: "ghost") %>
      </div>
    <% end %>
  <% end %>

  <%# Seven columns of long-form diagnostics stay cramped in the settings column, so the
      whole table can be reopened in a near full-width dialog. %>
  <div class="bg-container rounded-xl shadow-border-xs overflow-hidden group" data-controller="expandable">
    <% if @debug_log_entries.any? %>
      <%# Hover, keyboard focus, and always on coarse pointers, where there is no hover %>
      <div class="flex items-center justify-end px-4 py-2 border-b border-primary">
        <%= render DS::Button.new(
              variant: "icon",
              size: :sm,
              icon: "maximize-2",
              type: "button",
              title: t(".expand"),
              aria: { label: t(".expand") },
              class: "opacity-0 group-hover:opacity-100 focus-visible:opacity-100 pointer-coarse:opacity-100 transition-opacity",
              data: { action: "click->expandable#open" }
            ) %>
      </div>

      <div class="overflow-x-auto">
        <%= render "settings/debugs/log_table", entries: @debug_log_entries %>
      </div>

      <%= render DS::Dialog.new(
            auto_open: false,
            disable_frame: true,
            width: "xl",
            data: { expandable_target: "dialog" }
          ) do |dialog| %>
        <% dialog.with_header(title: t(".title"), subtitle: t(".subtitle")) %>
        <% dialog.with_body do %>
          <div class="max-h-[75dvh] overflow-auto overscroll-contain">
            <%= render "settings/debugs/log_table", entries: @debug_log_entries %>
          </div>
        <% end %>
      <% end %>
    <% else %>
      <div class="p-8 text-center text-secondary"><%= t(".empty") %></div>
    <% end %>
  </div>

  <% if @pagy.pages > 1 %>
    <div>
      <%= render "shared/pagination", pagy: @pagy %>
    </div>
  <% end %>
</div>
