<div class="space-y-4">
  <p class="text-secondary text-sm"><%= t(".description") %></p>

  <div class="flex items-center justify-between gap-4">
    <div class="space-y-1">
      <p class="text-sm"><%= t(".start_time_label") %></p>
      <p class="text-secondary text-sm"><%= t(".start_time_description") %></p>
    </div>

    <%= form_with model: Setting.new,
                  url: settings_hosting_path,
                  method: :patch,
                  data: { controller: "auto-submit-form", auto_submit_form_trigger_event_value: "change" } do |form| %>
      <%= form.time_field :scheduled_jobs_start_time,
                          value: Setting.scheduled_jobs_start_time,
                          class: "h-9 rounded-lg border border-secondary px-3 py-0 text-sm bg-container text-primary focus:ring-0 focus:border-secondary focus-ring",
                          data: { auto_submit_form_target: "auto" } %>
    <% end %>
  </div>

  <div class="flex items-center justify-between gap-4">
    <div class="space-y-1">
      <p class="text-sm"><%= t(".timezone_label") %></p>
      <p class="text-secondary text-sm"><%= t(".timezone_description") %></p>
    </div>

    <%= form_with model: Setting.new,
                  url: settings_hosting_path,
                  method: :patch,
                  data: { controller: "auto-submit-form", auto_submit_form_trigger_event_value: "change" } do |form| %>
      <%= form.select :scheduled_jobs_timezone,
                      timezone_options(ScheduledJobsManager.timezone, value: :name),
                      { selected: ScheduledJobsManager.timezone },
                      class: "h-9 rounded-lg border border-secondary px-3 py-0 text-sm bg-container text-primary focus:ring-0 focus:border-secondary focus-ring",
                      data: { auto_submit_form_target: "auto" } %>
    <% end %>
  </div>

  <div class="bg-surface-secondary border border-subdued rounded-lg p-4">
    <p class="text-sm text-secondary mb-3"><%= t(".preview_label") %></p>
    <% ScheduledJobsManager.effective_times.each do |job_key, time| %>
      <div class="flex items-center gap-2 text-sm py-1">
        <%= icon "clock", size: "sm", class: "text-subdued" %>
        <span class="text-secondary"><%= t(".jobs.#{job_key}") %>:</span>
        <span class="font-medium"><%= time %></span>
        <% if ScheduledJobsManager.has_custom_times? && Setting.public_send("#{job_key}_time").present? %>
          <span class="text-xs text-warning bg-warning/10 px-1.5 py-0.5 rounded"><%= t(".custom") %></span>
        <% end %>
      </div>
    <% end %>
    <p class="text-xs text-subdued mt-2"><%= t(".timezone_note", timezone: ScheduledJobsManager.timezone) %></p>
  </div>

  <details class="border border-subdued rounded-lg">
    <summary class="cursor-pointer text-sm font-medium text-secondary hover:text-primary flex items-center gap-2 p-4">
      <%= icon "settings", size: "sm" %>
      <%= t(".advanced_settings") %>
    </summary>
    <div class="px-4 pb-4 space-y-4">
      <%# DS::Alert: the warning-50/200/800 classes this used are not in the design system %>
      <%= render DS::Alert.new(variant: :warning, message: t(".avoid_same_time_warning")) %>

      <% ScheduledJobsManager::CONFIGURABLE_JOBS.keys.each do |job_key| %>
        <div class="flex items-center justify-between gap-4">
          <div class="space-y-1">
            <p class="text-sm"><%= t(".jobs.#{job_key}") %></p>
          </div>

          <%= form_with model: Setting.new,
                        url: settings_hosting_path,
                        method: :patch,
                        data: { controller: "auto-submit-form", auto_submit_form_trigger_event_value: "change" } do |form| %>
            <%= form.time_field "#{job_key}_time",
                                value: Setting.public_send("#{job_key}_time") || ScheduledJobsManager.effective_time_for(job_key),
                                class: "h-9 rounded-lg border border-secondary px-3 py-0 text-sm bg-container text-primary focus:ring-0 focus:border-secondary focus-ring",
                                data: { auto_submit_form_target: "auto" } %>
          <% end %>
        </div>
      <% end %>

      <% if ScheduledJobsManager.has_custom_times? %>
        <%= render DS::Button.new(text: t(".reset_to_defaults"),
                                  href: reset_scheduled_jobs_settings_hosting_path,
                                  method: :post,
                                  variant: :ghost,
                                  size: :sm) %>
      <% end %>
    </div>
  </details>

  <% status = @scheduled_jobs_status || ScheduledJobs::Status.new %>
  <section id="scheduled-jobs-status" class="border-t border-subdued pt-4 mt-4 space-y-3">
    <div class="flex items-center justify-between gap-4">
      <div class="space-y-1">
        <p class="text-sm font-medium text-primary"><%= t(".status.title") %></p>
        <p class="text-secondary text-sm"><%= t(".status.description", timezone: Time.zone.name) %></p>
      </div>

      <% if Current.user&.super_admin? %>
        <%= render DS::Link.new(
          text: t(".status.open_sidekiq"),
          href: "/sidekiq/cron",
          variant: :ghost,
          size: :sm,
          icon: "external-link",
          id: "sidekiq-cron-link",
          data: { turbo: false }
        ) %>
      <% end %>
    </div>

    <% if !status.available? %>
      <%= render DS::Alert.new(variant: :warning, title: t(".status.unavailable_title"), message: t(".status.unavailable_message")) %>
    <% else %>
      <% unless status.worker_alive? %>
        <%= render DS::Alert.new(variant: :error, title: t(".status.worker_down_title"), message: t(".status.worker_down_message")) %>
      <% end %>

      <%= render DS::Table.new(rows: status.entries, label: t(".status.title")) do |table| %>
        <% table.with_column(t(".status.columns.job"), row_header: true) do |entry| %>
          <div class="flex flex-wrap items-center gap-2">
            <span class="text-sm text-primary"><%= t(".status.job_names.#{entry.name}", default: entry.name.humanize) %></span>
            <% case entry.state %>
            <% when :overdue %>
              <%= render DS::Pill.new(label: t(".status.states.overdue"), tone: :warning, marker: false) %>
            <% when :disabled %>
              <%= render DS::Pill.new(label: t(".status.states.disabled"), tone: :neutral, marker: false) %>
            <% when :not_scheduled %>
              <%= render DS::Pill.new(label: t(".status.states.not_scheduled"), tone: :error, marker: false) %>
            <% end %>
          </div>
          <p class="text-xs text-subdued font-mono"><%= entry.name %></p>
        <% end %>
        <% table.with_column(t(".status.columns.last_run"), class: "text-secondary whitespace-nowrap") do |entry| %>
          <% if entry.last_run_at %>
            <%= tag.time l(entry.last_run_at, format: :short), datetime: entry.last_run_at.iso8601, title: t(".status.ago", time: time_ago_in_words(entry.last_run_at)) %>
          <% else %>
            <%= t(".status.never") %>
          <% end %>
        <% end %>
        <% table.with_column(t(".status.columns.next_run"), class: "text-secondary whitespace-nowrap") do |entry| %>
          <% if entry.next_run_at %>
            <%= tag.time l(entry.next_run_at, format: :short), datetime: entry.next_run_at.iso8601 %>
          <% else %>
            <%= t(".status.no_next_run") %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  </section>
</div>
