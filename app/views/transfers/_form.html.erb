<% accounts = Current.family.accounts.visible.alphabetically.to_a %>
<%= styled_form_with model: transfer, class: "space-y-4", data: {
      turbo_frame: "_top",
      controller: "exchange-rate-form",
      action: "submit->exchange-rate-form#prepareSubmit",
      **exchange_rate_form_data(mode: "transfer", accounts: accounts)
    } do |f| %>
  <% if transfer.errors.present? %>
    <div class="text-destructive flex items-center gap-2">
      <%= icon "circle-alert", size: "sm" %>
      <p class="text-sm"><%= @transfer.errors.full_messages.to_sentence %></p>
    </div>
  <% end %>

  <section>
    <%= render "shared/transaction_type_tabs", active_tab: "transfer" %>
  </section>

  <section class="space-y-2">
    <%= f.collection_select :from_account_id, accounts, :id, :name, { prompt: t(".select_account"), label: t(".from"), selected: @from_account_id },
          required: true, data: { exchange_rate_form_target: "fromAccount", action: "change->exchange-rate-form#refresh" } %>
    <%= f.collection_select :to_account_id, accounts, :id, :name, { prompt: t(".select_account"), label: t(".to") },
          required: true, data: { exchange_rate_form_target: "toAccount", action: "change->exchange-rate-form#refresh" } %>
    <%# The amount is in the source account's currency, which the transfer takes
        from it, so no currency picker or symbol is shown. step "any" keeps a
        crypto amount's eight decimals without padding every amount to them. %>
    <%= f.money_field :amount, label: t(".amount"), required: true, min: 0, hide_currency: true, hide_symbol: true, step: "any",
          amount_data: { exchange_rate_form_target: "amount", action: "input->exchange-rate-form#recalculate" } %>
    <%= f.date_field :date, value: transfer.inflow_transaction&.entry&.date || Date.current, label: t(".date"), required: true, max: Date.current,
          data: { exchange_rate_form_target: "date", action: "change->exchange-rate-form#refresh" } %>

    <%# w2-transfers custom-exchange-rate: shown only when the two accounts differ in currency %>
    <%= render "shared/exchange_rate_tabs",
          id_prefix: "transfer",
          rate_name: "transfer[exchange_rate]",
          converted_name: "transfer[destination_amount]",
          rate_value: params.dig(:transfer, :exchange_rate),
          converted_value: params.dig(:transfer, :destination_amount) %>

    <%# w2-transfers transfer-fees: each in its own account's currency, booked as expenses in Fees %>
    <div class="grid grid-cols-2 gap-2">
      <%= f.money_field :source_fee, label: t(".source_fee"), min: 0, hide_currency: true, hide_symbol: true, step: "any", placeholder: "0",
            value: UserDecimal.parse(params.dig(:transfer, :source_fee)) %>
      <%= f.money_field :destination_fee, label: t(".destination_fee"), min: 0, hide_currency: true, hide_symbol: true, step: "any", placeholder: "0",
            value: UserDecimal.parse(params.dig(:transfer, :destination_fee)) %>
    </div>
    <p class="text-xs text-secondary px-1"><%= t(".fees_hint") %></p>
  </section>

  <section>
    <%= f.submit t(".submit") %>
  </section>
<% end %>
