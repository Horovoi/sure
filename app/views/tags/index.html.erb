<header class="flex flex-wrap justify-between items-center gap-x-4 gap-y-2">
  <h1 class="text-primary text-xl font-medium"><%= t(".tags") %></h1>

  <div class="flex items-center gap-2">
    <%= render DS::Menu.new do |menu| %>
      <% menu.with_item(
            variant: "button",
            text: t(".delete_all"),
            href: destroy_all_tags_path,
            method: :delete,
            icon: "trash-2",
            confirm: CustomConfirm.for_resource_deletion(t(".all_tags"), high_severity: true)) %>
    <% end %>

    <%= render DS::Link.new(
      text: t(".new"),
      variant: "primary",
      href: new_tag_path,
      icon: "plus",
      frame: :modal
    ) %>
  </div>
</header>

<div class="bg-container rounded-xl shadow-border-xs p-4">
  <% if @tags.any? %>
    <div class="rounded-xl bg-container-inset space-y-1 p-1">
      <div class="flex items-center gap-1.5 px-4 py-2 text-xs font-medium text-secondary">
        <p><%= t(".tags") %></p>
        <span class="text-subdued" aria-hidden="true">&middot;</span>
        <p class="tabular-nums"><%= @tags.count %></p>
      </div>

      <div class="bg-container rounded-lg shadow-border-xs">
        <div class="overflow-hidden rounded-lg">
          <%= render partial: @tags, spacer_template: "shared/ruler" %>
        </div>
      </div>
    </div>
  <% else %>
    <%= render DS::EmptyState.new(icon: "tags", title: t(".empty")) do |empty| %>
      <% empty.with_action do %>
        <%= render DS::Link.new(
          text: t(".new"),
          variant: "primary",
          icon: "plus",
          href: new_tag_path,
          frame: :modal
        ) %>
      <% end %>
    <% end %>
  <% end %>
</div>
