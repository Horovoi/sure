<%
  header_title "Join #{@invitation.family.name}"
%>

<div class="space-y-1 mb-6 text-center">
  <p class="text-secondary">
    <%= @invitation.inviter.display_name %> invited you to join this household as <%= @invitation.role.to_s.humanize.downcase %>.
  </p>
</div>

<% if @signed_in_user && @invitation.email.casecmp?(@signed_in_user.email) %>
  <div class="space-y-4">
    <p class="text-sm text-secondary text-center"><%= t(".signed_in_as", email: @signed_in_user.email) %></p>

    <% if @signed_in_user.family_id != @invitation.family_id %>
      <p class="text-sm text-secondary text-center"><%= t(".leave_current_household", family: @signed_in_user.family.name) %></p>
    <% end %>

    <%= button_to t(".accept", family: @invitation.family.name),
        confirm_invitation_path(@invitation.token),
        method: :post,
        class: "block w-full rounded-md bg-inverse fg-inverse px-4 py-3 text-center text-sm font-medium hover:bg-inverse-hover transition" %>

    <%= link_to t(".decline"), root_path,
        class: "block w-full rounded-md border border-secondary bg-container px-4 py-3 text-center text-sm font-medium text-primary hover:bg-secondary transition" %>
  </div>
<% else %>
  <% if @signed_in_user %>
    <p class="text-sm text-secondary text-center mb-4"><%= t(".wrong_account") %></p>
  <% end %>

  <div class="space-y-4">
    <%= link_to new_registration_path(invitation: @invitation.token),
        class: "block w-full rounded-md border border-secondary bg-container px-4 py-3 text-center text-sm font-medium text-primary hover:bg-secondary transition" do %>
      Create a new account
    <% end %>

    <%= link_to new_session_path(invitation: @invitation.token),
        class: "block w-full rounded-md border border-secondary bg-container px-4 py-3 text-center text-sm font-medium text-primary hover:bg-secondary transition" do %>
      Sign in with an existing account
    <% end %>
  </div>
<% end %>
