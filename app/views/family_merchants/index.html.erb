<header class="flex flex-wrap justify-between items-center gap-x-4 gap-y-2">
  <h1 class="text-primary text-xl font-medium"><%= t(".title") %></h1>

  <div class="flex items-center gap-2">
    <%= render DS::Menu.new do |menu| %>
      <% menu.with_item(variant: "link", text: t(".merge"), href: merge_family_merchants_path, frame: :modal, icon: "combine") %>
    <% end %>
    <%= render DS::Link.new(
      text: t(".new"),
      variant: "primary",
      icon: "plus",
      href: new_family_merchant_path,
      frame: :modal
    ) %>
  </div>
</header>

<div class="bg-container rounded-xl shadow-border-xs p-4 space-y-6">
  <section class="space-y-3">
    <div class="flex items-center gap-1.5 px-4 py-2 text-xs font-medium text-secondary">
      <p><%= t(".family_title") %></p>
      <span class="text-subdued" aria-hidden="true">&middot;</span>
      <p class="tabular-nums"><%= @family_merchants_count %></p>
    </div>

    <% if @family_merchants_count.positive? %>
      <div class="space-y-2">
        <%= form_tag family_merchants_path, method: :get, data: { controller: "auto-submit-form" } do %>
          <%= hidden_field_tag :per_page, params[:per_page] if params[:per_page].present? %>
          <%= render DS::SearchInput.new(
                name: :family_search,
                value: params[:family_search],
                placeholder: t(".search_family_merchants"),
                aria_label: t(".search_family_merchants"),
                data: { auto_submit_form_target: "auto", autosubmit_trigger_event: "input" }
              ) %>
        <% end %>

        <% if @family_merchants.any? %>
          <div class="rounded-xl bg-container-inset space-y-1 p-1">
            <div class="bg-container rounded-lg shadow-border-xs overflow-x-auto">
              <table class="w-full">
                <thead>
                  <tr class="text-xs font-medium text-secondary border-b border-divider">
                    <th scope="col" class="text-left py-3 px-4"><%= t(".table.merchant") %></th>
                    <th scope="col" class="text-right py-3 px-4"><%= t(".table.actions") %></th>
                  </tr>
                </thead>
                <tbody>
                  <%= render partial: "family_merchants/family_merchant", collection: @family_merchants %>
                </tbody>
              </table>
            </div>
          </div>

          <% if @pagy_family_merchants.pages > 1 %>
            <div class="pt-2">
              <%= render "shared/pagination", pagy: @pagy_family_merchants %>
            </div>
          <% end %>
        <% else %>
          <div class="flex justify-center items-center py-8">
            <p class="text-secondary text-sm"><%= t(".no_family_merchants_found") %></p>
          </div>
        <% end %>
      </div>
    <% else %>
      <%= render DS::EmptyState.new(icon: "store", title: t(".family_empty")) do |empty| %>
        <% empty.with_action do %>
          <%= render DS::Link.new(
            text: t(".new"),
            icon: "plus",
            href: new_family_merchant_path,
            frame: :modal
          ) %>
        <% end %>
      <% end %>
    <% end %>
  </section>

  <section class="space-y-3">
    <div class="flex items-center gap-1.5 px-4 py-2 text-xs font-medium text-secondary">
      <p><%= t(".provider_title") %></p>
      <span class="text-subdued" aria-hidden="true">&middot;</span>
      <p class="tabular-nums"><%= @provider_merchants_count %></p>
    </div>

    <%= render DS::Alert.new(message: t(".provider_info"), variant: :info) %>

    <% if @provider_merchants.any? %>
      <div class="rounded-xl bg-container-inset space-y-1 p-1">
        <div class="bg-container rounded-lg shadow-border-xs overflow-x-auto">
          <table class="w-full">
            <thead>
              <tr class="text-xs font-medium text-secondary border-b border-divider">
                <th scope="col" class="text-left py-3 px-4"><%= t(".table.merchant") %></th>
                <th scope="col" class="text-left py-3 px-4"><%= t(".table.source") %></th>
                <th scope="col" class="text-right py-3 px-4"><%= t(".table.actions") %></th>
              </tr>
            </thead>
            <tbody>
              <%= render partial: "family_merchants/provider_merchant", collection: @provider_merchants %>
            </tbody>
          </table>
        </div>
      </div>

      <% if @pagy_provider_merchants.pages > 1 %>
        <div class="pt-2">
          <%= render "shared/pagination", pagy: @pagy_provider_merchants %>
        </div>
      <% end %>
    <% else %>
      <%= render DS::EmptyState.new(icon: "building-2", title: t(".provider_empty"), class: "py-8") %>
    <% end %>
  </section>

  <% if @unlinked_merchants.any? %>
    <section class="space-y-3">
      <div class="flex items-center gap-1.5 px-4 py-2 text-xs font-medium text-secondary">
        <p><%= t(".unlinked_title") %></p>
        <span class="text-subdued" aria-hidden="true">&middot;</span>
        <p class="tabular-nums"><%= @unlinked_merchants.count %></p>
      </div>

      <%= render DS::Alert.new(message: t(".unlinked_info"), variant: :info) %>

      <div class="rounded-xl bg-container-inset space-y-1 p-1">
        <div class="bg-container rounded-lg shadow-border-xs overflow-x-auto">
          <table class="w-full">
            <thead>
              <tr class="text-xs font-medium text-secondary border-b border-divider">
                <th scope="col" class="text-left py-3 px-4"><%= t(".table.merchant") %></th>
                <th scope="col" class="text-left py-3 px-4"><%= t(".table.source") %></th>
                <th scope="col" class="text-right py-3 px-4"><%= t(".table.actions") %></th>
              </tr>
            </thead>
            <tbody>
              <%= render partial: "family_merchants/provider_merchant", collection: @unlinked_merchants, locals: { linkable: false } %>
            </tbody>
          </table>
        </div>
      </div>
    </section>
  <% end %>
</div>
