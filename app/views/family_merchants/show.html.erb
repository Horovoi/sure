<div class="space-y-4 pb-6 lg:pb-12 flex flex-col">
  <header class="flex items-center justify-between gap-4 text-primary">
    <div class="flex items-center gap-3 min-w-0">
      <%= render "family_merchants/logo", merchant: @merchant, size: "lg" %>
      <h1 class="text-xl font-medium truncate"><%= @merchant.name %></h1>
    </div>

    <%= render DS::Link.new(
          text: t(".edit"),
          icon: "pencil",
          variant: "outline",
          href: edit_family_merchant_path(@merchant, return_to: request.fullpath),
          frame: :modal
        ) %>
  </header>

  <%= form_with url: family_merchant_path(@merchant),
        id: "merchant-transactions-search",
        scope: :q,
        method: :get,
        data: { controller: "auto-submit-form", turbo_frame: "merchant_transactions", turbo_action: "advance" } do |form| %>
    <%= hidden_field_tag :per_page, params[:per_page] if params[:per_page].present? %>

    <div class="flex gap-2">
      <%= render DS::SearchInput.new(
            name: "q[search]",
            value: @q[:search],
            placeholder: t(".search_placeholder"),
            aria_label: t(".search_placeholder"),
            class: "grow",
            data: {
              auto_submit_form_target: "auto",
              autosubmit_trigger_event: "input",
              autosubmit_min_length: "2",
              autosubmit_debounce_add_timeout: "100",
              autosubmit_debounce_clear_timeout: "0"
            }
          ) %>

      <%= render DS::Popover.new(variant: "button", no_padding: true) do |popover| %>
        <% popover.with_button(
              id: "merchant-filters-button",
              type: "button",
              text: t("transactions.searches.form.filter"),
              variant: "outline",
              icon: "list-filter"
            ) %>

        <% popover.with_custom_content do %>
          <%= render "transactions/searches/menu",
                form: form,
                filters: transaction_search_filters.reject { |filter| filter[:key] == "merchant_filter" },
                clear_all_url: family_merchant_path(@merchant, { per_page: params[:per_page].presence }.compact) %>
        <% end %>
      <% end %>
    </div>
  <% end %>

  <%# Summary and list share the frame, so a filter narrows the totals as well as the rows %>
  <%= turbo_frame_tag "merchant_transactions", data: { turbo_action: "advance" }, class: "block space-y-4" do %>
    <%= render "shared/exchange_rate_notes", family: Current.family %>

    <%= render DS::Card.new(class: "gap-3") do %>
      <h2 class="text-base font-medium text-primary"><%= t(".summary") %></h2>
      <dl class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-x-10 gap-y-3">
        <%= render DS::DetailRow.new(label: t(".total_transactions"), value: @search.totals.count.to_s, align: :center, value_class: "privacy-sensitive") %>
        <% if @expense_totals %>
          <%= render DS::DetailRow.new(label: t(".total_spending"), value: format_money(@expense_totals.expense_money), align: :center, value_class: "privacy-sensitive") %>
        <% end %>
        <% if @average_expense_money %>
          <%= render DS::DetailRow.new(label: t(".average_transaction"), value: format_money(@average_expense_money), align: :center, value_class: "privacy-sensitive") %>
        <% end %>
        <% if @search.totals.income_money.amount.positive? %>
          <%= render DS::DetailRow.new(label: t(".total_income"), value: format_money(@search.totals.income_money), align: :center, value_class: "privacy-sensitive") %>
        <% end %>
        <% if @first_date %>
          <%= render DS::DetailRow.new(label: t(".first_transaction"), value: format_date(@first_date), align: :center) %>
          <%= render DS::DetailRow.new(label: t(".last_transaction"), value: format_date(@last_date), align: :center) %>
        <% end %>
      </dl>
    <% end %>

    <div class="flex flex-col bg-container rounded-xl shadow-border-xs px-3 py-4 lg:p-4"
         data-controller="bulk-select"
         data-bulk-select-singular-label-value="<%= t("transactions.index.transaction") %>"
         data-bulk-select-plural-label-value="<%= t("transactions.index.transactions") %>">
      <% if @q.present? %>
        <%= render "transactions/searches/filters_bar",
              clear_all_url: family_merchant_path(@merchant, { per_page: params[:per_page].presence }.compact),
              clear_filter_url_builder: ->(param_key, param_value) {
                clear_filter_family_merchant_path(@merchant, param_key: param_key, param_value: param_value, **request.query_parameters)
              } %>
      <% end %>

      <div id="entry-selection-bar" data-bulk-select-target="selectionBar" class="flex justify-center hidden">
        <%= render "transactions/selection_bar" %>
      </div>

      <% if @transactions.any? %>
        <div class="grid-cols-12 bg-container-inset rounded-xl px-5 py-3 text-xs uppercase font-medium text-secondary items-center mb-4 grid">
          <div class="pl-0.5 col-span-8 flex items-center gap-4">
            <%= check_box_tag "selection_entry",
                  class: "checkbox checkbox--light hidden lg:block",
                  aria: { label: t(".select_page") },
                  data: { action: "bulk-select#togglePageSelection" } %>
            <p><%= t(".col_transaction") %></p>
          </div>
          <p class="col-span-2 md:block hidden"><%= t(".col_category") %></p>
          <p class="col-span-2 col-start-11 md:col-start-auto justify-self-end md:block"><%= t(".col_amount") %></p>
        </div>

        <div class="space-y-6">
          <%= entries_by_date(@transactions.map(&:entry), totals: true) do |entries| %>
            <%= render entries %>
          <% end %>
        </div>
      <% else %>
        <p class="text-secondary text-sm p-4"><%= t(".no_transactions") %></p>
      <% end %>

      <div class="pt-4">
        <%= render "shared/pagination", pagy: @pagy, frame: "merchant_transactions" %>
      </div>
    </div>
  <% end %>
</div>
