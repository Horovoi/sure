<div class="@container space-y-6">
  <%# Main net worth figures. Columns follow the section's width, not the
      window, and amounts never wrap. %>
  <div>
    <div class="grid grid-cols-1 @2xl:grid-cols-3 gap-4">
      <%= render "reports/kpi_tile",
            label: t("reports.net_worth.current_net_worth"),
            value: net_worth_metrics[:current_net_worth].format,
            value_class: net_worth_metrics[:current_net_worth] >= 0 ? "text-success" : "text-destructive",
            surface: :inset,
            size: :md %>

      <% if (trend = net_worth_metrics[:trend]) %>
        <%# A previous value of zero makes the percentage infinite, with nothing useful to print %>
        <%= render "reports/kpi_tile",
              label: t("reports.net_worth.period_change"),
              value: trend.value.format(signify_positive: true),
              value_class: nil,
              value_style: "color: #{trend.color}",
              sub: (tag.span("#{"+" if trend.value >= 0}#{trend.percent_formatted}", class: "tabular-nums", style: "color: #{trend.color}") if trend.percent.finite?),
              surface: :inset,
              size: :md %>
      <% else %>
        <%= render "reports/kpi_tile",
              label: t("reports.net_worth.period_change"),
              value: "--",
              value_class: "text-subdued",
              sensitive: false,
              surface: :inset,
              size: :md %>
      <% end %>

      <%# Two labelled lines, so neither amount wraps or reads as a range %>
      <div class="min-w-0 bg-surface-inset rounded-lg p-4" data-testid="net-worth-assets-liabilities">
        <p class="text-sm text-secondary"><%= t("reports.net_worth.assets_vs_liabilities") %></p>
        <dl class="mt-1 space-y-0.5">
          <div class="flex items-baseline justify-between gap-3">
            <dt class="text-xs text-secondary"><%= t("reports.net_worth.total_assets") %></dt>
            <dd class="text-base font-medium tabular-nums whitespace-nowrap text-success privacy-sensitive"><%= net_worth_metrics[:total_assets].format %></dd>
          </div>
          <div class="flex items-baseline justify-between gap-3">
            <dt class="text-xs text-secondary"><%= t("reports.net_worth.total_liabilities") %></dt>
            <dd class="text-base font-medium tabular-nums whitespace-nowrap text-destructive privacy-sensitive"><%= net_worth_metrics[:total_liabilities].format %></dd>
          </div>
        </dl>
      </div>
    </div>
  </div>

  <%# Net worth over time, one point per month, with each account group in the tooltip %>
  <% breakdown_series = net_worth_metrics[:breakdown_series] %>
  <% if breakdown_series && breakdown_series[:values].size >= 2 %>
    <div class="space-y-2" data-testid="net-worth-over-time">
      <p class="text-sm text-secondary"><%= t("reports.net_worth.chart.title") %></p>
      <div
        id="reportsNetWorthChart"
        class="w-full h-72"
        role="img"
        aria-label="<%= t("reports.net_worth.chart.aria_label") %>"
        draggable="false"
        data-controller="net-worth-chart"
        data-net-worth-chart-data-value="<%= breakdown_series.to_json %>"
        data-net-worth-chart-show-y-guides-value="true"
        data-net-worth-chart-money-format-value="<%= Money.new(0, Current.family.currency).format_options.slice(:unit, :precision, :delimiter, :separator, :format).to_json %>"
        data-net-worth-chart-assets-label-value="<%= t("reports.net_worth.total_assets") %>"
        data-net-worth-chart-liabilities-label-value="<%= t("reports.net_worth.total_liabilities") %>"></div>
    </div>
  <% end %>

  <%# Waterfall Chart %>
  <% if net_worth_metrics[:asset_groups].any? || net_worth_metrics[:liability_groups].any? %>
    <%
      assets_json = net_worth_metrics[:asset_groups].map { |g| { name: g[:name], value: g[:total].amount.to_f } }.to_json
      liabilities_json = net_worth_metrics[:liability_groups].map { |g| { name: g[:name], value: g[:total].amount.to_f } }.to_json
      net_worth_val = net_worth_metrics[:current_net_worth].amount.to_f
    %>
    <div class="relative"
         data-controller="reports-waterfall-chart"
         data-reports-waterfall-chart-assets-value="<%= assets_json %>"
         data-reports-waterfall-chart-liabilities-value="<%= liabilities_json %>"
         data-reports-waterfall-chart-net-worth-value="<%= net_worth_val %>"
         data-reports-waterfall-chart-money-format-value="<%= Money.new(0, Current.family.currency).format_options.slice(:unit, :precision, :delimiter, :separator, :format).to_json %>"
         data-reports-waterfall-chart-net-worth-label-value="<%= t("reports.net_worth.net_worth_total") %>">
    </div>
  <% else %>
    <div class="grid grid-cols-1 @md:grid-cols-2 gap-4">
      <div class="bg-surface-inset rounded-lg p-4">
        <p class="text-sm text-secondary text-center"><%= t("reports.net_worth.no_assets") %></p>
      </div>
      <div class="bg-surface-inset rounded-lg p-4">
        <p class="text-sm text-secondary text-center"><%= t("reports.net_worth.no_liabilities") %></p>
      </div>
    </div>
  <% end %>
</div>
