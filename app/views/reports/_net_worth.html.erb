<div class="space-y-6">
  <%# Main Net Worth Stats %>
  <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
    <%# Current Net Worth %>
    <div class="p-4 bg-surface-inset rounded-lg">
      <p class="text-sm text-secondary mb-2"><%= t("reports.net_worth.current_net_worth") %></p>
      <p class="text-2xl font-semibold privacy-sensitive <%= net_worth_metrics[:current_net_worth] >= 0 ? "text-success" : "text-destructive" %>">
        <%= net_worth_metrics[:current_net_worth].format %>
      </p>
    </div>

    <%# Period Change %>
    <div class="p-4 bg-surface-inset rounded-lg">
      <p class="text-sm text-secondary mb-2"><%= t("reports.net_worth.period_change") %></p>
      <% if net_worth_metrics[:trend] %>
        <% trend = net_worth_metrics[:trend] %>
        <p class="text-2xl font-semibold mb-1 privacy-sensitive" style="color: <%= trend.color %>">
          <%= trend.value.format(signify_positive: true) %>
        </p>
        <%# A previous value of zero makes the percentage infinite, with nothing useful to print %>
        <% if trend.percent.finite? %>
          <p class="text-xs" style="color: <%= trend.color %>">
            <%= trend.value >= 0 ? "+" : "" %><%= trend.percent_formatted %>
          </p>
        <% end %>
      <% else %>
        <p class="text-2xl font-semibold mb-1 text-subdued">--</p>
      <% end %>
    </div>

    <%# Assets vs Liabilities %>
    <div class="p-4 bg-surface-inset rounded-lg">
      <p class="text-sm text-secondary mb-2"><%= t("reports.net_worth.assets_vs_liabilities") %></p>
      <%# Large amounts wrap rather than overflow the card when the side panel is open %>
      <div class="flex items-baseline gap-2 flex-wrap">
        <span class="text-lg font-semibold text-success break-words privacy-sensitive"><%= net_worth_metrics[:total_assets].format %></span>
        <span class="text-xs text-subdued shrink-0">-</span>
        <span class="text-lg font-semibold text-destructive break-words privacy-sensitive"><%= net_worth_metrics[:total_liabilities].format %></span>
      </div>
    </div>
  </div>

  <%# Net worth over time, one point per month, with each account group in the tooltip %>
  <% breakdown_series = net_worth_metrics[:breakdown_series] %>
  <% if breakdown_series && breakdown_series[:values].size >= 2 %>
    <div class="space-y-2" data-testid="net-worth-over-time">
      <p class="text-sm text-secondary"><%= t("reports.net_worth.chart.title") %></p>
      <div
        id="reportsNetWorthChart"
        class="w-full h-72"
        role="img"
        aria-label="<%= t("reports.net_worth.chart.aria_label") %>"
        draggable="false"
        data-controller="net-worth-chart"
        data-net-worth-chart-data-value="<%= breakdown_series.to_json %>"
        data-net-worth-chart-show-y-guides-value="true"
        data-net-worth-chart-assets-label-value="<%= t("reports.net_worth.total_assets") %>"
        data-net-worth-chart-liabilities-label-value="<%= t("reports.net_worth.total_liabilities") %>"></div>
    </div>
  <% end %>

  <%# Waterfall Chart %>
  <% if net_worth_metrics[:asset_groups].any? || net_worth_metrics[:liability_groups].any? %>
    <%
      assets_json = net_worth_metrics[:asset_groups].map { |g| { name: g[:name], value: g[:total].amount.to_f } }.to_json
      liabilities_json = net_worth_metrics[:liability_groups].map { |g| { name: g[:name], value: g[:total].amount.to_f } }.to_json
      net_worth_val = net_worth_metrics[:current_net_worth].amount.to_f
      currency_symbol = Money::Currency.new(Current.family.currency).symbol
    %>
    <div class="relative"
         data-controller="reports-waterfall-chart"
         data-reports-waterfall-chart-assets-value="<%= assets_json %>"
         data-reports-waterfall-chart-liabilities-value="<%= liabilities_json %>"
         data-reports-waterfall-chart-net-worth-value="<%= net_worth_val %>"
         data-reports-waterfall-chart-currency-value="<%= currency_symbol %>"
         data-reports-waterfall-chart-net-worth-label-value="<%= t("reports.net_worth.net_worth_total") %>">
    </div>
  <% else %>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div class="bg-container-inset rounded-xl p-4">
        <p class="text-sm text-secondary text-center"><%= t("reports.net_worth.no_assets") %></p>
      </div>
      <div class="bg-container-inset rounded-xl p-4">
        <p class="text-sm text-subdued text-center"><%= t("reports.net_worth.no_liabilities") %></p>
      </div>
    </div>
  <% end %>
</div>
