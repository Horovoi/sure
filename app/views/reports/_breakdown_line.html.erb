<%# locals: (item:, level:, panel_id:) %>
<%# The grid of one breakdown row (a category or one of its subcategories): name,
    amount and share on the first line; the bar, the change and the change in
    percent on the second. The second line keeps its height without a change, so
    income and expense rows line up side by side. %>
<% sub = level == :subcategory %>
<% delta = item[:delta] %>

<%= tag.div class: class_names("group/category-row relative grid items-center gap-y-1.5 rounded-lg px-2", ReportsHelper::BREAKDOWN_GRID,
                               sub ? "py-1.5" : "py-2",
                               "hover:bg-surface-hover" => item[:href]),
            data: { category: "category-#{item[:key]}" } do %>
  <% if panel_id %>
    <%# With a mouse the chevron shows on the row's hover or focus, so thirteen of
        them do not line the list; touch screens always show it %>
    <button type="button"
            class="group/toggle relative z-10 row-span-2 -m-1 self-start rounded-md p-1 text-subdued transition-opacity hover:text-primary focus-ring pointer-fine:opacity-0 pointer-fine:group-hover/category-row:opacity-100 pointer-fine:focus-visible:opacity-100 pointer-fine:aria-expanded:opacity-100"
            aria-expanded="false"
            aria-controls="<%= panel_id %>"
            aria-label="<%= t("reports.transactions_breakdown.column.details", category: item[:name]) %>"
            data-action="breakdown-list#toggleRow">
      <%= icon("chevron-right", size: "sm", class: "transition-transform group-aria-expanded/toggle:rotate-90") %>
    </button>
  <% end %>

  <%# A wide list shows the category icon; a narrow one a colour dot, so the name
      gets the room and keeps the same identity cue %>
  <div class="col-start-2 flex min-w-0 items-center gap-2">
    <% if sub %>
      <span class="h-2 w-2 shrink-0 rounded-full" style="background-color: <%= item[:color] %>" aria-hidden="true"></span>
    <% else %>
      <span class="h-2 w-2 shrink-0 rounded-full @md:hidden" style="background-color: <%= item[:color] %>" aria-hidden="true"></span>
      <% if item[:icon] %>
        <span class="hidden h-6 w-6 shrink-0 items-center justify-center rounded-full @md:flex"
              style="background-color: color-mix(in oklab, <%= item[:color] %> 12%, transparent); color: <%= item[:color] %>"
              aria-hidden="true">
          <%= icon(item[:icon], color: "current", size: "xs") %>
        </span>
      <% else %>
        <span class="hidden shrink-0 @md:inline-flex"><%= render DS::FilledIcon.new(variant: :text, hex_color: item[:color], text: item[:name], size: "sm", rounded: true) %></span>
      <% end %>
    <% end %>

    <%# Long names wrap rather than lose their end %>
    <% name_classes = sub ? "min-w-0 break-words text-sm text-secondary" : "min-w-0 break-words text-sm font-medium text-primary" %>
    <% if item[:href] %>
      <%# The link's ::before covers the whole row, which is relative %>
      <%= link_to item[:name], item[:href],
            class: "#{name_classes} rounded-sm hover:underline focus-ring before:absolute before:inset-0 before:rounded-lg before:content-['']",
            data: { turbo_frame: "_top", turbo_prefetch: false } %>
    <% else %>
      <span class="<%= name_classes %>"><%= item[:name] %></span>
    <% end %>
  </div>

  <span class="text-right text-sm tabular-nums whitespace-nowrap privacy-sensitive <%= sub ? "text-secondary" : "text-primary" %>"><%= breakdown_money(item[:amount]) %></span>
  <span class="text-right text-sm tabular-nums text-secondary"><%= number_to_percentage(item[:share], precision: 1) %></span>

  <%# Bar: the amount on the list's shared scale; the tick marks normal, with a
      hairline in the card colour so it stays visible on a light fill %>
  <div class="relative col-start-2 <%= sub ? "h-1" : "h-1.5" %> rounded-full bg-surface-inset" aria-hidden="true">
    <% if item[:bar].positive? %>
      <span class="absolute inset-y-0 left-0 rounded-full" style="width: max(<%= item[:bar] %>%, 2px); background-color: <%= item[:color] %>"></span>
    <% end %>
    <% if item[:tick] %>
      <span class="absolute -inset-y-1 -ml-px w-0.5 rounded-full bg-inverse ring-1 ring-container" style="left: <%= item[:tick] %>%" data-testid="breakdown-normal-tick"></span>
    <% end %>
  </div>
  <% if delta %>
    <span class="col-start-3 text-right text-xs tabular-nums whitespace-nowrap <%= delta[:tone_class] %>" data-testid="breakdown-delta">
      <%= delta[:label] %><span class="sr-only"> <%= t("reports.transactions_breakdown.vs_normal.delta_#{delta[:direction]}") %></span>
    </span>
    <% if delta[:percent] %>
      <span class="text-right text-xs tabular-nums whitespace-nowrap <%= delta[:tone_class] %>" aria-hidden="true"><%= delta[:percent] %></span>
    <% end %>
  <% else %>
    <span class="col-start-3 text-xs" aria-hidden="true">&nbsp;</span>
  <% end %>
<% end %>
