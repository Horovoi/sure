<div class="@container space-y-8">
    <%# Month-over-Month Trends %>
    <div>
      <h3 class="text-lg font-medium mb-4">
        <%= t("reports.trends.monthly_breakdown") %>
      </h3>

      <% if trends_data.any? %>
        <%# Bar Chart %>
        <%
          chart_trends = trends_data.map { |t|
            {
              month: t[:month],
              income: t[:income].is_a?(Money) ? t[:income].amount.to_f : t[:income].to_f,
              expenses: t[:expenses].is_a?(Money) ? t[:expenses].amount.to_f : t[:expenses].to_f
            }
          }.to_json
        %>
        <div class="mb-6"
             data-controller="reports-trends-bar"
             data-reports-trends-bar-trends-value="<%= chart_trends %>"
             data-reports-trends-bar-income-label-value="<%= t("reports.trends.income") %>"
             data-reports-trends-bar-expenses-label-value="<%= t("reports.trends.expenses") %>">
        </div>

        <%# Foldable monthly table %>
        <details class="group">
          <%# Only as wide as its text, so the click target and focus ring hug it %>
          <summary class="list-none [&::-webkit-details-marker]:hidden inline-flex w-fit items-center gap-1 mb-3 rounded-md cursor-pointer text-sm text-secondary hover:text-primary focus-ring">
            <%= icon "chevron-right", class: "w-4 h-4 group-open:rotate-90 transition-transform" %>
            <%= t("reports.trends.view_monthly_details") %>
          </summary>

          <div class="bg-container-inset rounded-xl p-1 overflow-x-auto">
            <div class="w-max sm:w-full">
              <div role="columnheader" class="grid grid-cols-5 items-center text-xs font-medium text-secondary px-4 py-2">
                <div class="font-medium text-secondary"><%= t("reports.trends.month") %></div>
                <div class="text-right font-medium text-secondary"><%= t("reports.trends.income") %></div>
                <div class="text-right font-medium text-secondary"><%= t("reports.trends.expenses") %></div>
                <div class="text-right font-medium text-secondary"><%= t("reports.trends.net") %></div>
                <div class="text-right font-medium text-secondary"><%= t("reports.trends.savings_rate") %></div>
              </div>
              <div class="bg-container rounded-lg shadow-border-xs">
                <% trends_data.each_with_index do |trend, idx| %>
                  <div class="grid grid-cols-5 items-center text-secondary text-sm py-3 px-4 lg:px-6">
                    <div class="flex items-center gap-2 <%= trend[:is_current_month] ? "font-medium" : "" %>">
                      <%= trend[:month] %>
                      <% if trend[:is_current_month] %>
                        <span class="text-xs text-subdued">(<%= t("reports.trends.current") %>)</span>
                      <% end %>
                    </div>
                    <div class="text-right tabular-nums whitespace-nowrap privacy-sensitive">
                      <%= Money.new(trend[:income], Current.family.currency).format %>
                    </div>
                    <div class="text-right tabular-nums whitespace-nowrap privacy-sensitive">
                      <%= Money.new(trend[:expenses], Current.family.currency).format %>
                    </div>
                    <div class="text-right tabular-nums whitespace-nowrap privacy-sensitive <%= trend[:net] >= 0 ? "text-success" : "text-destructive" %>">
                      <%= Money.new(trend[:net], Current.family.currency).format %>
                    </div>
                    <div class="text-right tabular-nums <%= trend[:net] >= 0 ? "text-success" : "text-destructive" %>">
                      <% savings_rate = trend[:income] > 0 ? ((trend[:net].to_f / trend[:income].to_f) * 100).round(1) : 0 %>
                      <%= number_to_percentage(savings_rate, precision: 1) %>
                    </div>
                  </div>
                  <% if idx < trends_data.size - 1 %>
                    <%= render "shared/ruler", classes: "mx-3 lg:mx-4" %>
                  <% end %>
                <% end %>
              </div>
            </div>
          </div>
        </details>

        <%# Trend Insights %>
        <div class="mt-6 grid grid-cols-1 @2xl:grid-cols-3 gap-4">
          <% avg_income = trends_data.sum { |t| t[:income] } / trends_data.length %>
          <% avg_expenses = trends_data.sum { |t| t[:expenses] } / trends_data.length %>
          <% avg_net = trends_data.sum { |t| t[:net] } / trends_data.length %>

          <%= render "reports/kpi_tile",
                label: t("reports.trends.avg_monthly_income"),
                value: Money.new(avg_income, Current.family.currency).format,
                value_class: "text-success",
                surface: :inset,
                size: :md %>
          <%= render "reports/kpi_tile",
                label: t("reports.trends.avg_monthly_expenses"),
                value: Money.new(avg_expenses, Current.family.currency).format,
                value_class: "text-destructive",
                surface: :inset,
                size: :md %>
          <%= render "reports/kpi_tile",
                label: t("reports.trends.avg_monthly_savings"),
                value: Money.new(avg_net, Current.family.currency).format,
                value_class: avg_net >= 0 ? "text-success" : "text-destructive",
                surface: :inset,
                size: :md %>
        </div>
      <% else %>
        <div class="text-center py-8 text-subdued">
          <%= t("reports.trends.no_data") %>
        </div>
      <% end %>
    </div>
  </div>
