<%# locals: (transactions:, period_type:, start_date:, end_date:, spending_comparison: nil) %>
<%# Income and expenses as two ranked bar lists with one shape: the same header,
    rows and columns. Expenses with a normal to compare with add a tick for normal
    and a change to each row. The export menu lives in the section header
    (reports/_transactions_breakdown_actions). %>
<% if transactions.any? %>
  <%
    income_groups = transactions.select { |g| g[:type] == "income" }
    expense_groups = transactions.select { |g| g[:type] == "expense" }

    current_sort_by = params[:sort_by]
    current_sort_direction = params[:sort_direction]
    # Sorting by amount toggles: descending first, then ascending
    next_sort_direction = (current_sort_by == "amount" && current_sort_direction == "desc") ? "asc" : "desc"
    # The sort link keeps the period, its fiscal mode and its arrows
    # (report_period_params), not only the dates
    amount_sort_params = report_period_params.merge(sort_by: "amount", sort_direction: next_sort_direction)

    sides = [
      ([ :income, income_groups ] if income_groups.any?),
      ([ :expense, expense_groups ] if expense_groups.any?)
    ].compact
  %>

  <%# Side by side when the section is wide (a container query: the side panels
      narrow it at any viewport), stacked otherwise %>
  <div class="@container">
    <div class="grid grid-cols-1 gap-x-10 gap-y-8 @3xl:grid-cols-2">
      <% sides.each do |type, groups| %>
        <%= render "reports/breakdown_column",
              column: breakdown_column(groups,
                                       total: groups.sum { |g| g[:total] },
                                       type: type,
                                       start_date: start_date,
                                       end_date: end_date,
                                       comparison: (spending_comparison if type == :expense)),
              amount_sort_params: amount_sort_params,
              current_sort_by: current_sort_by,
              current_sort_direction: current_sort_direction,
              span_all: sides.one? %>
      <% end %>
    </div>
  </div>
<% else %>
  <div class="text-center py-8 text-subdued">
    <%= t("reports.transactions_breakdown.no_transactions") %>
  </div>
<% end %>
