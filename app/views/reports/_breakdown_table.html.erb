<%# Renders a breakdown table for income or expense groups %>
<%# Local variables: groups, total, type (:income or :expense), amount_sort_params, current_sort_by, current_sort_direction, start_date, end_date %>
<%# Expenses also take comparison (IncomeStatement::SpendingComparison) and color_mode ("category" or "normal"): %>
<%# with a normal to compare with, the treemap can colour tiles by their change against normal and "What changed" lists the moves. %>

<%
  comparison = local_assigns[:comparison]
  color_class = type == :income ? "text-success" : "text-destructive"
  icon_name = type == :income ? "trending-up" : "trending-down"
  title_key = type == :income ? "reports.transactions_breakdown.table.income" : "reports.transactions_breakdown.table.expense"
  title_id = "breakdown-#{type}-title"

  vs_normal = type == :expense && comparison.present? && comparison.comparable?
  color_mode = vs_normal && local_assigns[:color_mode] == "normal" ? "normal" : "category"

  treemap_categories = groups.any? && total > 0 ?
    breakdown_treemap_categories(groups, total: total, start_date: start_date, end_date: end_date, comparison: (comparison if vs_normal)) : []
  changes = vs_normal ? spending_changes(comparison) : []

  treemap_data = if treemap_categories.any?
    {
      controller: "reports-treemap",
      reports_treemap_categories_value: treemap_categories.to_json,
      reports_treemap_type_value: type,
      reports_treemap_color_mode_value: color_mode,
      reports_treemap_preference_url_value: (update_preferences_reports_path if vs_normal),
      reports_treemap_labels_value: {
        txn: t("reports.treemap.txn"),
        txns: t("reports.treemap.txns"),
        avg: t("reports.treemap.avg"),
        per_day: t("reports.treemap.per_day"),
        more: t("reports.treemap.more"),
        open: t("reports.spending_vs_normal.tooltip.open")
      }.to_json
    }.compact
  else
    {}
  end
%>

<%= tag.div data: { testid: "breakdown-#{type}" }.merge(treemap_data) do %>
  <div class="mb-4 flex flex-wrap items-center justify-between gap-x-4 gap-y-2">
    <div class="text-large flex items-center gap-2 text-lg">
      <%= icon(icon_name, class: "w-5 h-5") %>
      <span id="<%= title_id %>"><%= t(title_key) %>:</span>
      <span class="font-medium text-secondary <%= color_class %>"> <%= Money.new(total, Current.family.currency).format %></span>
    </div>

    <% if vs_normal && treemap_categories.any? %>
      <%= render DS::SegmentedControl.new(aria_label: t("reports.spending_vs_normal.color_mode.label")) do |control| %>
        <% control.with_segment(t("reports.spending_vs_normal.color_mode.category"),
              active: color_mode == "category",
              data: { reports_treemap_target: "modeButton", action: "reports-treemap#setColorMode", reports_treemap_mode_param: "category" }) %>
        <% control.with_segment(t("reports.spending_vs_normal.color_mode.normal"),
              active: color_mode == "normal",
              data: { reports_treemap_target: "modeButton", action: "reports-treemap#setColorMode", reports_treemap_mode_param: "normal" }) %>
      <% end %>
    <% end %>
  </div>

  <% if vs_normal %>
    <p class="text-sm text-secondary -mt-2 mb-4" data-testid="spending-summary">
      <%= t(comparison.in_progress? ? "reports.spending_vs_normal.summary_so_far_html" : "reports.spending_vs_normal.summary_html",
            total: tag.span(spending_money(comparison.total, precision: 0), class: "font-medium text-primary"),
            normal: tag.span(spending_money(comparison.normal_total, precision: 0), class: "font-medium text-primary"),
            baseline_start: l(comparison.baseline_period.start_date, format: :long),
            baseline_end: l(comparison.baseline_period.end_date, format: :long)) %>
    </p>
  <% end %>

  <% if treemap_categories.any? %>
    <div class="mb-6 <%= "grid grid-cols-1 lg:grid-cols-5 gap-6" if vs_normal %>">
      <div class="min-w-0 <%= "lg:col-span-3" if vs_normal %>">
        <div class="relative w-full" data-reports-treemap-target="chart" role="group" aria-labelledby="<%= title_id %>"></div>

        <% if vs_normal %>
          <ul class="flex flex-wrap items-center gap-x-3 gap-y-1 mt-3 text-xs text-secondary <%= "hidden" unless color_mode == "normal" %>"
              data-reports-treemap-target="legend"
              data-testid="spending-legend">
            <% ReportsHelper::SPENDING_RATIO_BUCKETS.each do |bucket| %>
              <li class="inline-flex items-center gap-1.5">
                <span class="inline-block w-3 h-3 rounded-sm" style="background: <%= bucket[:color] %>"></span>
                <%= t("reports.spending_vs_normal.legend.#{bucket[:key]}") %>
              </li>
            <% end %>
          </ul>
        <% end %>
      </div>

      <% if vs_normal %>
        <div class="lg:col-span-2 min-w-0">
          <h3 class="text-sm font-medium text-secondary mb-2"><%= t("reports.spending_vs_normal.changes_title") %></h3>
          <% if changes.empty? %>
            <p class="text-sm text-secondary"><%= t("reports.spending_vs_normal.no_changes") %></p>
          <% else %>
            <ul class="space-y-1" data-testid="spending-changes">
              <% changes.each do |change| %>
                <li data-category-key="<%= IncomeStatement::CategoryNetting.key(change[:row].category) %>">
                  <% row_content = capture do %>
                    <span class="truncate text-primary"><%= change[:row].category.name %></span>
                    <span class="grid grid-cols-2 h-3" aria-hidden="true">
                      <span class="flex justify-end">
                        <% if change[:row].change.negative? %><span class="h-3 rounded-l bg-success" style="width: <%= change[:width] %>%"></span><% end %>
                      </span>
                      <span class="flex justify-start border-l border-secondary">
                        <% if change[:row].change.positive? %><span class="h-3 rounded-r bg-destructive" style="width: <%= change[:width] %>%"></span><% end %>
                      </span>
                    </span>
                    <span class="text-right text-secondary tabular-nums"><%= change[:amount_label] %></span>
                  <% end %>
                  <% row_classes = "grid grid-cols-[minmax(0,9rem)_1fr_5rem] items-center gap-2 rounded-md px-1 py-1 text-sm" %>
                  <% if change[:href] %>
                    <%= link_to row_content, change[:href], class: "#{row_classes} hover:bg-surface-hover", data: { turbo_frame: "_top" } %>
                  <% else %>
                    <div class="<%= row_classes %>"><%= row_content %></div>
                  <% end %>
                </li>
              <% end %>
            </ul>
          <% end %>
        </div>
      <% end %>
    </div>
  <% end %>

  <details class="group">
    <summary class="cursor-pointer text-sm text-secondary hover:text-primary mb-3 flex items-center gap-1">
      <%= icon "chevron-right", class: "w-4 h-4 group-open:rotate-90 transition-transform" %>
      <%= t("reports.transactions_breakdown.table.view_category_details", count: groups.size) %>
    </summary>

    <div class="bg-container-inset rounded-xl p-1 overflow-x-auto">
      <div class="w-max sm:w-full">
        <div class="grid grid-cols-[2fr_repeat(4,minmax(0,1fr))] items-center uppercase text-xs font-medium text-secondary px-4 py-2">
          <div class="font-medium text-secondary"><%= t("reports.transactions_breakdown.table.category") %></div>
          <div class="text-right font-medium text-secondary">
            <%= link_to reports_path(amount_sort_params), class: "inline-flex items-center gap-1 hover:text-primary" do %>
              <%= t("reports.transactions_breakdown.table.amount") %>
              <% if current_sort_by == "amount" %>
                <%= icon(current_sort_direction == "desc" ? "chevron-down" : "chevron-up", class: "w-3 h-3") %>
              <% end %>
            <% end %>
          </div>
          <div class="text-right font-medium text-secondary"><%= t("reports.transactions_breakdown.table.transactions_short") %></div>
          <div class="text-right font-medium text-secondary"><%= t("reports.transactions_breakdown.table.average_short") %></div>
          <div class="text-right font-medium text-secondary"><%= t("reports.transactions_breakdown.table.percentage") %></div>
        </div>

        <div class="bg-container rounded-lg shadow-border-xs">
          <% groups.each_with_index do |group, idx| %>
            <%= render "reports/category_row", item: group, total: total, color_class: color_class, level: :category, start_date: start_date, end_date: end_date %>
            <% if idx < groups.size - 1 %>
              <%= render "shared/ruler", classes: "mx-3 lg:mx-4" %>
            <% end %>
            <% if group[:subcategories].present? && group[:subcategories].any? %>
              <% group[:subcategories].each_with_index do |subcategory, sub_idx| %>
                <%= render "reports/category_row", item: subcategory, total: total, color_class: color_class, level: :subcategory, start_date: start_date, end_date: end_date %>
              <% end %>
              <% if idx < groups.size - 1 %>
                <%= render "shared/ruler", classes: "mx-3 lg:mx-4" %>
              <% end %>
            <% end %>
          <% end %>
        </div>
      </div>
    </div>
  </details>
<% end %>
