<%# locals: (columns:) %>
<%# The overview over both lists. First two figures, each a number with one short
    line: what was left over, and how far spending is from normal. Then one stacked
    bar per side on a shared scale (the gap between them is what was left over),
    and the key for the ticks on the expense rows. Which days normal comes from and
    what a grey change means sit in the key's info tooltip. %>
<%
  income = columns.find { |column| column[:type] == :income }
  expense = columns.find { |column| column[:type] == :expense }
  comparison = expense&.dig(:comparison)
  left_over = breakdown_left_over(income_total: income&.dig(:total).to_d, expense_total: expense&.dig(:total).to_d)
  vs_normal = comparison && breakdown_vs_normal(comparison)
  no_normal = !comparison && expense&.dig(:no_normal)
%>

<div class="@container mb-10 space-y-6" data-testid="breakdown-overview">
  <% if left_over || vs_normal || no_normal %>
    <div class="grid grid-cols-1 gap-x-10 gap-y-5 @md:grid-cols-2 @3xl:grid-cols-[minmax(0,1fr)_minmax(0,1fr)]">
      <% if left_over %>
        <div data-testid="breakdown-left-over">
          <p class="text-sm text-secondary"><%= left_over[:label] %></p>
          <p class="mt-1 text-2xl font-medium tabular-nums <%= left_over[:tone] == :unfavorable ? "text-destructive" : "text-primary" %>"><%= left_over[:value] %></p>
          <p class="mt-1 text-sm text-secondary"><%= left_over[:note] %></p>
        </div>
      <% end %>

      <% if vs_normal %>
        <div data-testid="spending-summary">
          <p class="text-sm text-secondary"><%= t("reports.transactions_breakdown.vs_normal.label") %></p>
          <p class="<%= class_names("mt-1 text-2xl font-medium tabular-nums",
                                    vs_normal[:tone] == :neutral ? "text-primary" : ReportsHelper::BREAKDOWN_TONE_CLASSES.fetch(vs_normal[:tone])) %>"><%= vs_normal[:value] %></p>
          <p class="mt-1 text-sm text-secondary"><%= vs_normal[:note] %></p>
        </div>
      <% elsif no_normal %>
        <div data-testid="spending-no-normal">
          <p class="text-sm text-secondary"><%= t("reports.transactions_breakdown.vs_normal.label") %></p>
          <p class="mt-1 text-sm text-secondary max-w-xs"><%= t("reports.transactions_breakdown.vs_normal.no_normal") %></p>
        </div>
      <% end %>
    </div>
  <% end %>

  <% if income && expense %>
    <%# The figures above say the same in words, so the strip stays decorative %>
    <div class="grid grid-cols-[4.5rem_minmax(0,1fr)] items-center gap-x-4 gap-y-3 text-xs text-secondary" aria-hidden="true">
      <% breakdown_strip(columns).each do |side| %>
        <span><%= t("reports.transactions_breakdown.overview.#{side[:type]}") %></span>
        <div class="flex h-2 overflow-hidden rounded-full bg-surface-inset" data-testid="breakdown-strip-<%= side[:type] %>">
          <% side[:segments].each do |segment| %>
            <%# A hairline in the card colour parts neighbouring segments %>
            <span class="h-full shrink-0 shadow-[inset_-1px_0_0_var(--color-container)] last:shadow-none" style="width: <%= segment[:width] %>%; background-color: <%= segment[:color] %>" title="<%= segment[:name] %>"></span>
          <% end %>
        </div>
      <% end %>
    </div>
  <% end %>

  <% if comparison %>
    <div class="flex items-center gap-2 text-xs text-secondary" data-testid="spending-legend">
      <span class="relative h-3.5 w-3 shrink-0" aria-hidden="true">
        <span class="absolute inset-y-0 left-1/2 -ml-px w-0.5 rounded-full bg-inverse"></span>
      </span>
      <span><%= breakdown_normal_key(comparison) %></span>
      <%= render DS::Tooltip.new(text: breakdown_normal_details(comparison), icon: "info", size: "xs", color: "default") %>
    </div>
  <% end %>
</div>
