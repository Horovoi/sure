<% content_for :page_header do %>
  <%# The period is the page's subject: its name is the headline. The two
      arrows sit together before it, as in a calendar, so they never move and
      the label takes its natural width. The breadcrumb already says Reports,
      so the h1 says it only to screen readers. %>
  <% nav = @period_nav %>
  <% custom = @period_type == :custom %>
  <% fiscal_choice = Current.family.fiscal_month_enabled? && !custom %>
  <div class="@container mb-6">
    <div class="flex flex-col gap-4 @2xl:flex-row @2xl:items-start @2xl:justify-between">
      <div class="min-w-0 grid grid-cols-[auto_minmax(0,1fr)] items-center gap-x-2" data-testid="report-period-nav">
        <div class="flex items-center -ml-2">
          <%= render DS::PeriodArrow.new(
            direction: :previous,
            label: t("reports.index.period_nav.previous"),
            href: nav[:previous_params] && reports_path(nav[:previous_params]),
            hotkey: "ArrowLeft",
            shortcut_hint: t("reports.index.period_nav.shortcut_hint", action: t("reports.index.period_nav.previous"), key: "←")
          ) %>
          <%= render DS::PeriodArrow.new(
            direction: :next,
            label: t("reports.index.period_nav.next"),
            href: nav[:next_params] && reports_path(nav[:next_params]),
            hotkey: "ArrowRight",
            shortcut_hint: t("reports.index.period_nav.shortcut_hint", action: t("reports.index.period_nav.next"), key: "→")
          ) %>
        </div>

        <%# The page title style Plan, Goals and the budget wizard share. A custom
            range is a long label, so it steps down a size on a narrow column. %>
        <h1 class="<%= class_names("min-w-0 truncate font-medium text-primary tabular-nums",
                                  custom ? "text-lg @lg:text-2xl" : "text-2xl") %>">
          <span class="sr-only"><%= t("reports.index.heading_prefix") %></span>
          <span data-testid="report-period-label"><%= nav[:label] %></span>
        </h1>

        <%# The exact days, or the fields that choose them for a custom range.
            Back to current comes last and the line never wraps (a long range
            is cut short instead), so showing it moves nothing else. %>
        <div class="<%= class_names("flex items-center gap-x-3 gap-y-2 min-h-6 mt-1 text-xs @md:text-sm text-secondary", custom ? "col-span-2 mt-2 @md:col-span-1 @md:col-start-2" : "col-start-2 whitespace-nowrap") %>">
          <% if custom %>
            <%= form_with url: reports_path, method: :get, data: { controller: "auto-submit-form" }, class: "grid grid-cols-[minmax(0,1fr)_auto_minmax(0,1fr)] items-center gap-2 w-full max-w-sm" do |f| %>
              <%= f.hidden_field :period_type, value: :custom %>
              <%= f.date_field :start_date,
                               value: @start_date.strftime("%Y-%m-%d"),
                               data: { auto_submit_form_target: "auto" },
                               autocomplete: "off",
                               aria: { label: t("reports.index.date_range.from") },
                               class: "w-full min-w-0 h-9 px-3 py-0 border border-secondary rounded-lg text-sm bg-container text-primary focus-ring" %>
              <span aria-hidden="true">–</span>
              <%= f.date_field :end_date,
                               value: @end_date.strftime("%Y-%m-%d"),
                               data: { auto_submit_form_target: "auto" },
                               autocomplete: "off",
                               aria: { label: t("reports.index.date_range.to") },
                               class: "w-full min-w-0 h-9 px-3 py-0 border border-secondary rounded-lg text-sm bg-container text-primary focus-ring" %>
            <% end %>
          <% else %>
            <span class="min-w-0 truncate" data-testid="report-period-range"><%= nav[:range] %></span>
          <% end %>

          <% unless nav[:at_current] %>
            <%= link_to t("reports.index.period_nav.current"),
                        reports_path(nav[:current_params]),
                        class: "shrink-0 text-primary underline underline-offset-2 hover:no-underline rounded-sm focus-ring",
                        data: { testid: "report-period-current" } %>
          <% end %>
        </div>
      </div>

      <div class="flex items-center gap-2 min-w-0">
        <%= render DS::SegmentedControl.new(
          aria_label: t("reports.index.periods.label"),
          class: "min-w-0 flex-1 overflow-x-auto [scrollbar-width:none] @2xl:flex-none",
          data: { testid: "report-period-types" }
        ) do |control| %>
          <% { monthly: "month", quarterly: "quarter", last_6_months: "six_months", ytd: "year" }.each do |period_type, key| %>
            <% control.with_segment(t("reports.index.periods.#{key}"),
                                    href: reports_path(period_type: period_type, fiscal_mode: @fiscal_mode),
                                    active: @period_type == period_type,
                                    class: "grow @max-2xl:px-1 @2xl:grow-0") %>
          <% end %>
          <% control.with_segment(t("reports.index.periods.custom"),
                                  href: reports_path(period_type: :custom),
                                  active: custom,
                                  class: "grow @max-2xl:px-1 @2xl:grow-0") %>
        <% end %>

        <% if fiscal_choice %>
          <%= render DS::Menu.new(variant: :button, testid: "report-options") do |menu| %>
            <% menu.with_button(variant: "icon", icon: "more-horizontal", aria: { label: t("reports.index.more_options") }) %>
            <% menu.with_item(variant: :link,
                              text: t("reports.index.toggles.calendar"),
                              href: reports_path(period_type: @period_type, fiscal_mode: "false", period_offset: @period_offset.nonzero?),
                              selected: @fiscal_mode != "true") %>
            <% menu.with_item(variant: :link,
                              text: t("reports.index.toggles.fiscal"),
                              href: reports_path(period_type: @period_type, fiscal_mode: "true", period_offset: @period_offset.nonzero?),
                              selected: @fiscal_mode == "true") %>
            <% menu.with_item(variant: :divider) %>
            <% menu.with_item(variant: :link,
                              text: t("reports.index.print_report"),
                              icon: "printer",
                              href: print_reports_path(report_period_params),
                              target: "_blank",
                              rel: "noopener") %>
          <% end %>
        <% else %>
          <%# With no months to choose, Print is the only option: one icon, not a menu of one. %>
          <%= render DS::Tooltip.new(text: t("reports.index.print_report")) do |tooltip| %>
            <% tooltip.with_trigger do %>
              <%= render DS::Link.new(variant: "icon",
                                      icon: "printer",
                                      href: print_reports_path(report_period_params),
                                      target: "_blank",
                                      rel: "noopener",
                                      aria: { label: t("reports.index.print_report") },
                                      data: { testid: "report-print" }) %>
            <% end %>
          <% end %>
        <% end %>
      </div>
    </div>

    <% if flash[:alert].present? %>
      <div class="mt-4 p-3 rounded-lg bg-destructive-surface text-sm text-destructive" role="alert">
        <%= flash[:alert] %>
      </div>
    <% end %>
  </div>
<% end %>

<div class="w-full space-y-6 lg:pb-6">
  <%= render "shared/exchange_rate_notes", family: Current.family %>

  <% if Current.family.transactions.any? %>
    <%# Summary Dashboard - Always visible, not collapsible %>
    <section>
      <%= render partial: "reports/summary_dashboard", locals: {
        metrics: @summary_metrics,
        period_type: @period_type
      } %>
    </section>

    <%# Collapsible & Reorderable Sections %>
    <%# The sections are not Tab stops: keyboard reordering lives on each drag
        handle, so Space on the page still scrolls it. %>
    <div data-controller="reports-sortable" data-action="dragover->reports-sortable#dragOver drop->reports-sortable#drop" role="list" aria-label="<%= t("reports.index.sections_label") %>">
      <% @reports_sections.each do |section| %>
        <% next unless section[:visible] %>
        <section
          class="bg-container rounded-xl shadow-border-xs transition-all mb-6 group"
          data-reports-sortable-target="section"
          data-section-key="<%= section[:key] %>"
          data-controller="reports-section"
          data-reports-section-section-key-value="<%= section[:key] %>"
          data-reports-section-collapsed-value="<%= Current.user.reports_section_collapsed?(section[:key]) %>"
          draggable="true"
          role="listitem"
          aria-grabbed="false"
          aria-label="<%= t(section[:title]) %>"
          data-action="
            dragstart->reports-sortable#dragStart
            dragend->reports-sortable#dragEnd
            keydown->reports-sortable#handleKeyDown">
          <div class="px-4 py-2 flex items-center justify-between gap-2">
            <div class="flex items-center gap-2 min-w-0">
              <%= render DS::Button.new(
                    variant: "icon",
                    size: :sm,
                    icon: "chevron-down",
                    class: "transition-transform",
                    aria: { label: t("reports.index.toggle_section"),
                            expanded: !Current.user.reports_section_collapsed?(section[:key]) },
                    data: { action: "click->reports-section#toggle keydown->reports-section#handleToggleKeydown",
                            reports_section_target: "button chevron" }
                  ) %>
              <h2 class="text-base font-medium text-primary truncate">
                <%= t(section[:title]) %>
              </h2>
            </div>
            <div class="flex items-center gap-1 shrink-0">
              <%# Shown on the section's hover or focus; touch screens always show it %>
              <%= render DS::Button.new(
                    variant: "icon",
                    size: :sm,
                    icon: "grip-vertical",
                    class: "cursor-grab active:cursor-grabbing transition-opacity pointer-fine:opacity-0 pointer-fine:group-hover:opacity-100 pointer-fine:group-focus-within:opacity-100 pointer-fine:focus-visible:opacity-100 aria-pressed:opacity-100",
                    aria: { label: t("reports.index.drag_to_reorder", section: t(section[:title])), pressed: "false" },
                    data: { reports_sortable_target: "handle",
                            action: "touchstart->reports-sortable#touchStart touchmove->reports-sortable#touchMove touchend->reports-sortable#touchEnd touchcancel->reports-sortable#touchCancel" }
                  ) %>
              <%# A section's own actions (the breakdown's export menu) sit in its header,
                  last, so they end on the same edge as the section's content %>
              <% if section[:actions_partial] %>
                <%= render partial: section[:actions_partial], locals: section[:locals] %>
              <% end %>
            </div>
          </div>
          <div class="py-4 px-6" data-reports-section-target="content">
            <%= render partial: section[:partial], locals: section[:locals] %>
          </div>
        </section>
      <% end %>
    </div>
  <% else %>
    <%# Empty State %>
    <section>
      <%= render partial: "reports/empty_state" %>
    </section>
  <% end %>
</div>
