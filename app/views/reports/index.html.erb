<% content_for :page_header do %>
  <div class="space-y-4 mb-6">
    <div class="space-y-1">
      <h1 class="text-xl lg:text-3xl font-medium text-primary">
        <%= t("reports.index.title") %>
      </h1>
      <p class="text-sm lg:text-base text-secondary">
        <%= t("reports.index.insights_for", start: l(@start_date, format: "%b %-d"), end: l(@end_date, format: "%b %-d, %Y")) %>
      </p>
    </div>

    <%# Flash messages %>
    <% if flash[:alert].present? %>
      <div class="p-3 rounded-lg bg-destructive-surface text-sm text-destructive">
        <%= flash[:alert] %>
      </div>
    <% end %>

    <%# Period Navigation Tabs %>
    <div class="space-y-2">
      <%# Tab Row %>
      <div class="flex items-center gap-2 overflow-x-auto">
        <%= render DS::Link.new(
          text: t("reports.index.periods.month"),
          variant: @period_type == :monthly ? "secondary" : "ghost",
          href: reports_path(period_type: :monthly, fiscal_mode: @fiscal_mode),
          size: :sm
        ) %>
        <%= render DS::Link.new(
          text: t("reports.index.periods.quarter"),
          variant: @period_type == :quarterly ? "secondary" : "ghost",
          href: reports_path(period_type: :quarterly, fiscal_mode: @fiscal_mode),
          size: :sm
        ) %>
        <%= render DS::Link.new(
          text: t("reports.index.periods.six_months"),
          variant: @period_type == :last_6_months ? "secondary" : "ghost",
          href: reports_path(period_type: :last_6_months, fiscal_mode: @fiscal_mode),
          size: :sm
        ) %>
        <%= render DS::Link.new(
          text: t("reports.index.periods.year"),
          variant: @period_type == :ytd ? "secondary" : "ghost",
          href: reports_path(period_type: :ytd, fiscal_mode: @fiscal_mode),
          size: :sm
        ) %>
        <%= render DS::Link.new(
          text: t("reports.index.periods.custom"),
          variant: @period_type == :custom ? "secondary" : "ghost",
          href: reports_path(period_type: :custom),
          size: :sm
        ) %>
      </div>

      <%# Filter Bar: Period arrows + Toggles + Date + Print %>
      <div class="flex flex-wrap items-center gap-3">
        <%# Period arrows: step back and forth through periods of the selected type.
            Nothing in this group changes size between periods: the arrows keep
            their box when off, the label is as wide as its widest sample, and
            Current keeps its slot (invisible) on the current period. %>
        <% nav = @period_nav %>
        <div class="flex items-center gap-1" data-testid="report-period-nav">
          <%= render DS::PeriodArrow.new(
            direction: :previous,
            label: t("reports.index.period_nav.previous"),
            href: reports_path(nav[:previous_params]),
            hotkey: "ArrowLeft",
            shortcut_hint: t("reports.index.period_nav.shortcut_hint", action: t("reports.index.period_nav.previous"), key: "←")
          ) %>

          <span class="inline-grid text-sm font-medium text-primary px-1 text-center whitespace-nowrap tabular-nums">
            <span class="[grid-area:1/1]" data-testid="report-period-label"><%= nav[:label] %></span>
            <% nav[:label_samples].each do |sample| %>
              <span class="[grid-area:1/1] invisible" aria-hidden="true"><%= sample %></span>
            <% end %>
          </span>

          <%= render DS::PeriodArrow.new(
            direction: :next,
            label: t("reports.index.period_nav.next"),
            href: nav[:next_params] && reports_path(nav[:next_params]),
            hotkey: "ArrowRight",
            shortcut_hint: t("reports.index.period_nav.shortcut_hint", action: t("reports.index.period_nav.next"), key: "→")
          ) %>

          <%= render DS::Link.new(
            text: t("reports.index.period_nav.current"),
            variant: "ghost",
            size: :sm,
            href: reports_path(nav[:current_params]),
            class: nav[:at_current] ? "invisible" : nil,
            aria: nav[:at_current] ? { hidden: true } : {},
            tabindex: nav[:at_current] ? -1 : nil,
            data: { testid: "report-period-current" }
          ) %>
        </div>

        <% if @period_type != :custom %>
          <%# Fiscal Toggle - for all period tabs (except custom) when fiscal enabled %>
          <% if Current.family.fiscal_month_enabled? %>
            <div class="inline-flex rounded-md border border-secondary p-0.5 bg-surface-inset">
              <%= link_to reports_path(period_type: @period_type, fiscal_mode: "false", period_offset: @period_offset.nonzero?),
                  class: "px-2.5 py-0.5 text-sm rounded transition-colors #{@fiscal_mode != 'true' ? 'bg-container shadow-xs font-medium' : 'text-secondary hover:text-primary'}" do %>
                <%= t("reports.index.toggles.calendar") %>
              <% end %>
              <%= link_to reports_path(period_type: @period_type, fiscal_mode: "true", period_offset: @period_offset.nonzero?),
                  class: "px-2.5 py-0.5 text-sm rounded transition-colors #{@fiscal_mode == 'true' ? 'bg-container shadow-xs font-medium' : 'text-secondary hover:text-primary'}" do %>
                <%= t("reports.index.toggles.fiscal") %>
              <% end %>
            </div>
          <% end %>
        <% else %>
          <%# Custom Date Range Picker %>
          <%= form_with url: reports_path, method: :get, data: { controller: "auto-submit-form" }, class: "flex flex-wrap items-center gap-2" do |f| %>
            <%= f.hidden_field :period_type, value: :custom %>
            <%= f.date_field :start_date,
                             value: @start_date.strftime("%Y-%m-%d"),
                             data: { auto_submit_form_target: "auto" },
                             autocomplete: "off",
                             class: "px-2 py-1 border border-secondary rounded-lg text-sm bg-surface-inset text-primary w-32" %>
            <span class="text-secondary">–</span>
            <%= f.date_field :end_date,
                             value: @end_date.strftime("%Y-%m-%d"),
                             data: { auto_submit_form_target: "auto" },
                             autocomplete: "off",
                             class: "px-2 py-1 border border-secondary rounded-lg text-sm bg-surface-inset text-primary w-32" %>
          <% end %>
        <% end %>

        <%# Spacer %>
        <div class="flex-1"></div>

        <%# Print Report Button %>
        <%= link_to print_reports_path(report_period_params),
                    target: "_blank",
                    rel: "noopener",
                    aria: { label: t("reports.index.print_report") },
                    class: "inline-flex items-center gap-1.5 px-2.5 py-1 text-sm font-medium text-secondary hover:text-primary transition-colors" do %>
          <%= icon("printer", size: "sm") %>
          <span class="hidden sm:inline"><%= t("reports.index.print_report") %></span>
        <% end %>
      </div>
    </div>
  </div>
<% end %>

<div class="w-full space-y-6 lg:pb-6">
  <%= render "shared/exchange_rate_notes", family: Current.family %>

  <% if Current.family.transactions.any? %>
    <%# Summary Dashboard - Always visible, not collapsible %>
    <section>
      <%= render partial: "reports/summary_dashboard", locals: {
        metrics: @summary_metrics,
        period_type: @period_type
      } %>
    </section>

    <%# Collapsible & Reorderable Sections %>
    <div data-controller="reports-sortable" data-action="dragover->reports-sortable#dragOver drop->reports-sortable#drop" role="list" aria-label="Reports sections">
      <% @reports_sections.each do |section| %>
        <% next unless section[:visible] %>
        <section
          class="bg-container rounded-xl shadow-border-xs transition-all mb-6 group focus:outline-none focus-visible:ring-2 focus-visible:ring-gray-900 focus-visible:ring-offset-2"
          data-reports-sortable-target="section"
          data-section-key="<%= section[:key] %>"
          data-controller="reports-section"
          data-reports-section-section-key-value="<%= section[:key] %>"
          data-reports-section-collapsed-value="<%= Current.user.reports_section_collapsed?(section[:key]) %>"
          draggable="true"
          tabindex="0"
          role="listitem"
          aria-grabbed="false"
          aria-label="<%= t(section[:title]) %> section. Press Enter or Space to grab for reordering, then use arrow keys to move."
          data-action="
            dragstart->reports-sortable#dragStart
            dragend->reports-sortable#dragEnd
            keydown->reports-sortable#handleKeyDown">
          <div class="px-4 py-2 flex items-center justify-between">
            <div class="flex items-center gap-2">
              <button
                type="button"
                class="text-secondary hover:text-primary transition-colors p-0.5"
                data-action="click->reports-section#toggle keydown->reports-section#handleToggleKeydown"
                data-reports-section-target="button"
                aria-label="<%= t("reports.index.toggle_section") %>"
                aria-expanded="<%= !Current.user.reports_section_collapsed?(section[:key]) %>">
                <%= icon("chevron-down", size: "sm", class: "transition-transform", data: { reports_section_target: "chevron" }) %>
              </button>
              <h2 class="text-base font-medium">
                <%= t(section[:title]) %>
              </h2>
            </div>
            <button
              type="button"
              class="cursor-grab active:cursor-grabbing text-secondary hover:text-primary transition-colors p-0.5 opacity-0 group-hover:opacity-100 pointer-coarse:opacity-100"
              data-reports-sortable-target="handle"
              data-action="
                touchstart->reports-sortable#touchStart
                touchmove->reports-sortable#touchMove
                touchend->reports-sortable#touchEnd
                touchcancel->reports-sortable#touchCancel"
              aria-label="<%= t("reports.index.drag_to_reorder") %>">
              <%= icon("grip-vertical", size: "sm") %>
            </button>
          </div>
          <div class="py-4 px-6" data-reports-section-target="content">
            <%= render partial: section[:partial], locals: section[:locals] %>
          </div>
        </section>
      <% end %>
    </div>
  <% else %>
    <%# Empty State %>
    <section>
      <%= render partial: "reports/empty_state" %>
    </section>
  <% end %>
</div>
