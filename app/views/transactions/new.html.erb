<%# Anchored to the top: the Expense / Income / Transfer tabs swap this dialog's
    content for a form of another height, and the title and tabs stay put %>
<%= render DS::Dialog.new(align: :top) do |dialog| %>
  <% dialog.with_header(title: t(".new_transaction")) %>
  <% dialog.with_body do %>
    <%= render "form",
               entry: @entry,
               categories: @categories,
               recent_categories: @recent_categories,
               category_classification: @category_classification,
               merchants: @merchants,
               tags: @tags %>
  <% end %>
<% end %>
