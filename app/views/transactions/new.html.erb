<%= render DS::Dialog.new do |dialog| %>
  <% dialog.with_header(title: t(".new_transaction")) %>
  <% dialog.with_body do %>
    <%= render "form",
               entry: @entry,
               categories: @categories,
               recent_categories: @recent_categories,
               category_classification: @category_classification,
               merchants: @merchants,
               tags: @tags %>
  <% end %>
<% end %>
