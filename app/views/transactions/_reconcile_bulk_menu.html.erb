<%# The selection bar's quick reconcile menu (w3-toolstrx reconciliation-status). It
    posts the picked status with the selected ids; entries that do not take the mark
    (balance updates, trades, synced accounts) are skipped by Entry.bulk_update!. %>
<%= render DS::Menu.new(variant: :button, placement: "top-end") do |menu| %>
  <% menu.with_button(
      variant: "icon",
      size: "sm",
      icon: "circle-check",
      type: "button",
      title: t("transactions.reconcile.bulk.menu"),
      aria: { label: t("transactions.reconcile.bulk.menu") },
      data: { testid: "reconcile-bulk-menu" }
    ) %>

  <% Entry::RECONCILED_STATUS_CYCLE.each do |status| %>
    <% menu.with_item(
        variant: :button,
        text: t("transactions.reconcile.bulk.mark_as", status: t("transactions.reconcile.statuses.#{status}")),
        icon: reconcile_status_presentation(status)[:icon],
        href: transactions_bulk_update_path,
        method: :post,
        # In the body, not the URL: a query bulk_update[...] would replace the whole
        # bulk_update hash, the entry_ids bulk-select adds included
        params: { bulk_update: { reconciled_status: status } },
        form: { data: { turbo_frame: "_top" } },
        data: { action: "bulk-select#submitBulkRequest", bulk_select_scope_param: "bulk_update" }
      ) %>
  <% end %>
<% end %>
