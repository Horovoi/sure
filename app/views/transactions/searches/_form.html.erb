<%= form_with url: transactions_path,
              id: "transactions-search",
              scope: :q,
              method: :get,
              data: { controller: "auto-submit-form", turbo_frame: "transactions_results", turbo_stream: true } do |form| %>
  <%= hidden_field_tag :per_page, params[:per_page] %>

  <div class="flex items-center gap-2 mb-3 md:mb-4">
    <%# A toolbar input: 36px, like the buttons beside it; the wrapper draws the focus ring %>
    <div class="grow min-w-0 flex items-center h-9 px-3 gap-2 bg-container border border-secondary rounded-lg focus-ring-within">
      <%= icon("search", class: "shrink-0") %>
      <%= form.text_field :search,
                          placeholder: t(".search_placeholder"),
                          aria: { label: t(".search_placeholder") },
                          value: @q[:search],
                          class: "form-field__input placeholder:text-sm placeholder:text-secondary",
                          "data-auto-submit-form-target": "auto",
                          "data-autosubmit-trigger-event": "input",
                          "data-autosubmit-min-length": "2",
                          "data-autosubmit-debounce-add-timeout": "100",
                          "data-autosubmit-debounce-clear-timeout": "0" %>
    </div>

    <%= render DS::Popover.new(variant: "button", no_padding: true) do |popover| %>
      <% popover.with_button(
        id: "transaction-filters-button",
        type: "button",
        text: t(".filter"),
        variant: "outline",
        icon: "list-filter"
      ) %>

      <% popover.with_custom_content do %>
        <%= render "transactions/searches/menu", form: form %>
      <% end %>
    <% end %>

    <%= render DS::Button.new(
          variant: "outline",
          icon: "list-todo",
          type: "button",
          id: "toggle-checkboxes-button",
          class: "lg:hidden",
          title: t(".toggle_selection_checkboxes"),
          aria: { label: t(".toggle_selection_checkboxes") },
          data: {
            action: "click->checkbox-toggle#toggle",
            checkbox_toggle_target: "toggleButton"
          }
        ) %>
  </div>
<% end %>
