<%# locals: (form:, filters: transaction_search_filters, clear_all_url: transactions_path(clear_filters: true)) %>

<%= render DS::Tabs.new(
  variant: :unstyled,
  active_tab: filters.first[:key],
  active_btn_classes: "tab-item-active text-primary shadow-sm",
  inactive_btn_classes: "text-secondary hover:tab-item-hover hover:text-primary"
) do |tabs| %>
  <%# The tab list is a track (tab-bg-group) with the DS tab items on it: the active
      one raised and lighter, the others tinted on hover %>
  <div id="transaction-filters-menu" class="flex flex-col md:flex-row h-[50vh] lg:max-h-auto z-10 md:h-96 w-full md:w-[540px] top-12 right-0 overflow-hidden rounded-lg">
    <%= tabs.with_nav(classes: "shrink-0 flex w-full md:w-44 flex-row md:flex-col items-start gap-0.5 p-2 text-sm font-medium tab-bg-group border-b md:border-b-0 md:border-r border-secondary overflow-x-auto md:overflow-x-hidden md:overflow-y-auto") do |nav| %>
      <% filters.each do |filter| %>
        <%= nav.with_btn(id: filter[:key], label: filter[:label], classes: "shrink-0 md:w-full p-2 flex gap-2 items-center rounded-md whitespace-nowrap motion-safe:transition-colors") do %>
          <%= icon(filter[:icon], color: "current") %>
          <%= tag.span(filter[:label], class: "text-sm font-medium") %>
        <% end %>
      <% end %>
    <% end %>

    <div class="flex flex-col grow overflow-y-auto">
      <div class="grow p-3 border-b border-secondary overflow-y-auto">
        <% filters.each do |filter| %>
          <%= tabs.with_panel(tab_id: filter[:key]) do %>
            <%= render partial: get_transaction_search_filter_partial_path(filter), locals: { form: form } %>
          <% end %>
        <% end %>
      </div>

      <div class="flex justify-between items-center gap-2 bg-container p-3 shrink-0">
        <div>
          <% if @q.present? %>
            <%= render DS::Link.new(
            text: t(".clear_filters"),
            variant: "ghost",
            href: clear_all_url,
          ) %>
          <% end %>
        </div>

        <div class="flex items-center gap-2">
          <%= render DS::Button.new(text: t(".cancel"), type: "button", variant: "ghost", data: { action: "DS--popover#close" }) %>
          <%= render DS::Button.new(text: t(".apply"), type: :submit) %>
        </div>
      </div>
    </div>
  </div>
<% end %>
