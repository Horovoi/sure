<%# locals: (form:) %>
<%# Filter rows: one recipe in every tab of the menu (32px, gap-2) %>

<div class="flex flex-col">
  <div class="filterable-item flex items-center gap-2 h-8 px-2 rounded-md hover:bg-container-hover" data-filter-name="confirmed">
    <%= form.check_box :status,
                       {
                         multiple: true,
                         checked: @q[:status]&.include?("confirmed"),
                         class: "checkbox checkbox--light"
                       },
                       "confirmed",
                       nil %>
    <%= form.label :status, t(".confirmed"), value: "confirmed", class: "flex-1 min-w-0 h-full flex items-center gap-2 text-sm text-primary cursor-pointer" %>
  </div>
  <div class="filterable-item flex items-center gap-2 h-8 px-2 rounded-md hover:bg-container-hover" data-filter-name="pending">
    <%= form.check_box :status,
                       {
                         multiple: true,
                         checked: @q[:status]&.include?("pending"),
                         class: "checkbox checkbox--light"
                       },
                       "pending",
                       nil %>
    <%= form.label :status, t(".pending"), value: "pending", class: "flex-1 min-w-0 h-full flex items-center gap-2 text-sm text-primary cursor-pointer" %>
  </div>
</div>
