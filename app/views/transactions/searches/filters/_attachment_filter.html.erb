<%# locals: (form:) %>

<div class="flex flex-col">
  <% Transaction::Search::ATTACHMENT_STATUSES.each do |status| %>
    <div class="filterable-item flex items-center gap-2 h-8 px-2 rounded-md hover:bg-container-hover" data-filter-name="<%= status %>">
      <%= form.check_box :attachment_status,
                         {
                           multiple: true,
                           checked: @q[:attachment_status]&.include?(status),
                           class: "checkbox checkbox--light"
                         },
                         status,
                         nil %>
      <%= form.label :attachment_status, t(".#{status}"), value: status, class: "flex-1 min-w-0 h-full flex items-center gap-2 text-sm text-primary cursor-pointer" %>
    </div>
  <% end %>
</div>
