<%# locals: (form:) %>
<div data-controller="list-filter">
  <div class="relative">
    <input type="search" autocomplete="off" placeholder="<%= t(".placeholder") %>" data-list-filter-target="input" data-action="input->list-filter#filter" class="block w-full bg-container border border-secondary rounded-md py-2 pl-10 pr-3 focus:ring-gray-500 sm:text-sm">
    <%= icon("search", class: "absolute inset-y-0 left-2 top-1/2 transform -translate-y-1/2") %>
  </div>
  <div class="my-2" id="list" data-list-filter-target="list">
    <% ([ Merchant.no_merchant ] + Current.family.assigned_merchants.alphabetically.includes(logo_attachment: :blob).to_a).each do |merchant| %>
      <div class="filterable-item flex items-center gap-2 p-2" data-filter-name="<%= merchant.name %>">
        <%= form.check_box :merchants,
                           {
                             multiple: true,
                             checked: @q[:merchants]&.include?(merchant.filter_value),
                             class: "checkbox checkbox--light"
                           },
                           merchant.filter_value,
                           nil %>
        <%= form.label :merchants, value: merchant.filter_value, class: "text-sm text-primary flex items-center gap-2" do %>
          <div class="hidden lg:flex">
            <% if merchant.new_record? %>
              <%= render DS::FilledIcon.new(icon: "circle-dashed", size: "sm", rounded: true) %>
            <% elsif merchant.logo_url.present? %>
              <%= image_tag Setting.transform_brand_fetch_url(merchant.logo_url),
                  class: "w-6 h-6 rounded-full border border-secondary",
                  loading: "lazy" %>
            <% else %>
              <%= render DS::FilledIcon.new(
                variant: :text,
                hex_color: merchant.color,
                text: merchant.name,
                size: "sm",
                rounded: true
              ) %>
            <% end %>
          </div>
          <%= merchant.name %>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
