<%# locals: (form:) %>
<div data-controller="list-filter" class="space-y-2">
  <%= render DS::SearchInput.new(
        placeholder: t(".placeholder"),
        data: { list_filter_target: "input", action: "input->list-filter#filter" }
      ) %>
  <div class="flex flex-col" id="list" data-list-filter-target="list">
    <% Current.family.accounts.visible.alphabetically.each do |account| %>
      <div class="filterable-item flex items-center gap-2 h-8 px-2 rounded-md hover:bg-container-hover" data-filter-name="<%= account.name %>">
        <%= form.check_box :accounts,
                           {
                             multiple: true,
                             checked: @q[:accounts]&.include?(account.name),
                             class: "checkbox checkbox--light"
                           },
                           account.name,
                           nil %>
        <%= form.label :accounts, value: account.name, class: "flex-1 min-w-0 h-full flex items-center gap-2 text-sm text-primary cursor-pointer" do %>
          <span class="truncate"><%= account.name %></span>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
