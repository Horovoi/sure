<%# locals: (param_key:, param_value:, clear_url: nil) %>
<li class="flex items-center gap-1 h-7 text-sm border border-secondary rounded-md pl-2 pr-0.5">
  <% if param_key == "start_date" || param_key == "end_date" %>
    <div class="flex items-center gap-2">
      <%= icon "calendar" %>
      <p>
        <% if param_key == "start_date" %>
          <%= t(".on_or_after", date: param_value) %>
        <% else %>
          <%= t(".on_or_before", date: param_value) %>
        <% end %>
      </p>
    </div>
  <% elsif param_key == "search" %>
    <div class="flex items-center gap-2">
      <%= icon "text" %>
      <p><%= "\"#{param_value}\"".truncate(20) %></p>
    </div>
  <% elsif param_key == "accounts" || param_key == "account_ids" %>
    <% account_name = param_key == "account_ids" ? transaction_filter_account_name(param_value) : param_value.to_s %>
    <div class="flex items-center gap-2">
      <div class="w-5 h-5 bg-info/10 text-xs flex items-center justify-center rounded-full"><%= account_name.first.to_s.upcase %></div>
      <p><%= account_name %></p>
    </div>
  <% elsif param_key == "amount" %>
    <div class="flex items-center gap-2">
      <%= icon "hash" %>
      <p><%= param_value %></p>
    </div>
  <% elsif param_key == "types" %>
    <div class="flex items-center gap-2 px-1">
      <div class="w-1 h-3 rounded-full <%= case param_value.downcase
                                          when "income" then "bg-success"
                                          when "expense" then "bg-destructive"
                                          when "transfer" then "bg-info"
                                          when "balance_update" then "bg-warning"
                                          when "trade" then "bg-purple-500"
                                          end %>"></div>
      <p><%= t(".#{param_value.downcase}", default: param_value.humanize) %></p>
    </div>
  <% elsif param_key == "status" %>
    <div class="flex items-center gap-2 px-1">
      <%= icon(param_value.downcase == "pending" ? "clock" : "check", size: "sm") %>
      <p><%= t(".#{param_value.downcase}") %></p>
    </div>
  <% elsif param_key == "attachment_status" && param_value.in?(Transaction::Search::ATTACHMENT_STATUSES) %>
    <div class="flex items-center gap-2 px-1">
      <%= icon("paperclip", size: "sm") %>
      <p><%= t(".attachment_#{param_value}") %></p>
    </div>
  <% elsif param_key == "reconcile_status" && param_value.in?(Entry::RECONCILED_STATUS_CYCLE) %>
    <div class="flex items-center gap-2 px-1">
      <%= icon(reconcile_status_presentation(param_value)[:icon], size: "sm") %>
      <p><%= t("transactions.reconcile.statuses.#{param_value}") %></p>
    </div>
  <% elsif param_key == "categories" && Category.uncategorized_filter_value?(param_value) %>
    <div class="flex items-center gap-2">
      <p><%= Category.uncategorized_name %></p>
    </div>
  <% elsif param_key == "merchants" && param_value == Merchant::NO_MERCHANT_FILTER_VALUE %>
    <div class="flex items-center gap-2">
      <p><%= Merchant.no_merchant_name %></p>
    </div>
  <% elsif param_key == "tags" && param_value == Tag::UNTAGGED_FILTER_VALUE %>
    <div class="flex items-center gap-2">
      <p><%= Tag.untagged_name %></p>
    </div>
  <% else %>
    <div class="flex items-center gap-2">
      <p><%= param_value %></p>
    </div>
  <% end %>

  <% badge_clear_url = clear_url || clear_filter_transactions_path(param_key: param_key, param_value: param_value, **request.query_parameters) %>
  <%# The whole page, not the results frame the badge sits in: the filter menu
      outside the frame holds the filters too. %>
  <%= button_to badge_clear_url,
        method: :delete,
        form: { data: { turbo_frame: "_top" } },
        aria: { label: t(".remove") },
        title: t(".remove"),
        class: "inline-flex items-center justify-center size-6 rounded-sm text-secondary hover:text-primary hover:bg-container-inset-hover cursor-pointer" do %>
    <%= icon "x", size: "sm", color: "current" %>
  <% end %>
</li>
