<%# locals: (form:) %>
<%# Labelled form-field boxes, like every other dated field %>
<div class="space-y-2">
  <div class="form-field">
    <div class="form-field__body">
      <%= form.label :start_date, t(".from"), class: "form-field__label" %>
      <%= form.date_field :start_date, value: @q[:start_date], class: "form-field__input" %>
    </div>
  </div>
  <div class="form-field">
    <div class="form-field__body">
      <%= form.label :end_date, t(".to"), class: "form-field__label" %>
      <%= form.date_field :end_date, value: @q[:end_date], class: "form-field__input" %>
    </div>
  </div>
</div>
