<%# locals: (form:) %>
<div data-controller="list-filter" class="space-y-2">
  <%= render DS::SearchInput.new(
        placeholder: t(".placeholder"),
        data: { list_filter_target: "input", action: "input->list-filter#filter" }
      ) %>
  <div class="flex flex-col" id="list" data-list-filter-target="list">
    <% ([ Tag.untagged ] + Current.family.tags.alphabetically.to_a).each do |tag| %>
      <div class="filterable-item flex items-center gap-2 h-8 px-2 rounded-md hover:bg-container-hover" data-filter-name="<%= tag.name %>">
        <%= form.check_box :tags,
                           {
                             multiple: true,
                             checked: @q[:tags]&.include?(tag.filter_value),
                             class: "checkbox checkbox--light"
                           },
                           tag.filter_value,
                           nil %>
        <%= form.label :tags, value: tag.filter_value, class: "flex-1 min-w-0 h-full flex items-center gap-2 text-sm text-primary cursor-pointer" do %>
          <% tag_color = tag.color.presence || Tag::UNCATEGORIZED_COLOR %>
          <span class="border text-sm font-medium px-2 py-0.5 rounded-full inline-flex items-center gap-1.5 min-w-0 max-w-full"
                style="
                  background-color: color-mix(in oklab, <%= tag_color %> 10%, transparent);
                  border-color: color-mix(in oklab, <%= tag_color %> 20%, transparent);
                  color: <%= tag_color %>;">
            <span class="size-1.5 shrink-0 rounded-full" style="background-color: <%= tag_color %>;"></span>
            <span class="truncate"><%= tag.name %></span>
          </span>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
