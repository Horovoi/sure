<%# locals: (form:) %>
<%# w3-toolstrx reconciliation-status: transactions of manual accounts by their mark.
    The checkbox alone marks the row: the status icons are circles and ticks too, and
    beside a checkbox they read as a second one %>

<div class="flex flex-col">
  <% Entry::RECONCILED_STATUS_CYCLE.each do |status| %>
    <div class="filterable-item flex items-center gap-2 h-8 px-2 rounded-md hover:bg-container-hover" data-filter-name="<%= status %>">
      <%= form.check_box :reconcile_status,
                         {
                           multiple: true,
                           checked: @q[:reconcile_status]&.include?(status),
                           class: "checkbox checkbox--light"
                         },
                         status,
                         nil %>
      <%= form.label :reconcile_status, t("transactions.reconcile.statuses.#{status}"), value: status, class: "flex-1 min-w-0 h-full flex items-center gap-2 text-sm text-primary cursor-pointer" %>
    </div>
  <% end %>
</div>
