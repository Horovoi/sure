<%# locals: (form:) %>
<%# w3-toolstrx reconciliation-status: transactions of manual accounts by their mark %>

<div class="p-2 space-y-3">
  <% Entry::RECONCILED_STATUS_CYCLE.each do |status| %>
    <div class="flex items-center gap-3" data-filter-name="<%= status %>">
      <%= form.check_box :reconcile_status,
                         {
                           multiple: true,
                           checked: @q[:reconcile_status]&.include?(status),
                           class: "checkbox checkbox--light"
                         },
                         status,
                         nil %>
      <%= form.label :reconcile_status, value: status, class: "text-sm text-primary flex items-center gap-2" do %>
        <%= icon(reconcile_status_presentation(status)[:icon], size: "sm", color: "current", class: reconcile_status_presentation(status)[:text_class]) %>
        <%= t("transactions.reconcile.statuses.#{status}") %>
      <% end %>
    </div>
  <% end %>
</div>
