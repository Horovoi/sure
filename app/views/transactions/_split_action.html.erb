<%# locals: (entry:) %>

<%# The drawer's Split row. Always rendered, so the update stream can replace it when a
    setting changes whether the transaction can be split (Exclude, One-time). %>
<%= tag.div id: dom_id(entry, :split_action) do %>
  <% if entry.splittable? %>
    <div class="flex items-center justify-between gap-4 p-3">
      <div class="text-sm space-y-1">
        <h4 class="text-primary"><%= t("transactions.show.split_title") %></h4>
        <p class="text-secondary"><%= t("transactions.show.split_description") %></p>
      </div>

      <%= render DS::Link.new(
        text: t("transactions.show.split_button"),
        icon: "split",
        variant: "outline",
        href: new_transaction_split_path(entry),
        frame: :modal
      ) %>
    </div>
  <% end %>
<% end %>
