<%= render "transactions/searches/filters_bar",
    clear_all_url: transactions_path(clear_filters: true, per_page: params[:per_page].presence) %>

<div id="entry-selection-bar" data-bulk-select-target="selectionBar" class="flex justify-center hidden">
  <%= render "transactions/selection_bar" %>
</div>

<% if @pagy.count > 0 || (@projected_recurring&.any? && @q.blank?) %>
  <div class="grow overflow-y-auto">
    <% if @transactions.any? %>
      <%# The columns of transactions/_transaction. The px-1 wrapper is a container as wide as a row (inside its group's p-1), so the header switches columns with the rows; px-4 lg:px-5 is a row's padding plus that p-1 %>
      <div class="@container px-1 mb-4">
        <div class="grid grid-cols-[minmax(0,1fr)_auto] @xl:grid-cols-[minmax(0,1fr)_2rem_minmax(7rem,auto)] @3xl:grid-cols-[minmax(0,1fr)_minmax(0,10rem)_minmax(7rem,auto)] gap-x-2 bg-container-inset rounded-xl px-4 lg:px-5 py-3 text-xs font-medium text-secondary items-center -mx-1">
          <div class="pl-0.5 @xl:pr-4 flex items-center gap-4 min-w-0">
            <%= check_box_tag "selection_entry",
                              class: "checkbox checkbox--light hidden lg:block",
                              aria: { label: t(".select_page") },
                              data: {
                                action: "bulk-select#togglePageSelection",
                                checkbox_toggle_target: "selectionEntry"
                              } %>
            <p><%= t(".col_transaction") %></p>
          </div>

          <%# Holds the 2rem icon column too, where the label does not fit %>
          <p class="hidden @xl:block min-w-0"><span class="hidden @3xl:inline"><%= t(".col_category") %></span></p>
          <p class="justify-self-end"><%= t(".col_amount") %></p>
        </div>
      </div>
    <% end %>

    <div class="space-y-6">
      <% if @projected_recurring&.any? && @q.blank? %>
        <div
          class="space-y-2"
          data-controller="transactions-section"
          data-transactions-section-section-key-value="upcoming_recurring"
          data-transactions-section-collapsed-value="<%= Current.user.transactions_section_collapsed?("upcoming_recurring") %>">
          <div class="flex items-center gap-2 px-2">
            <%# The whole button turns, as the controller rotates its chevron target %>
            <%= render DS::Button.new(
                  variant: "icon",
                  size: "sm",
                  icon: "chevron-down",
                  type: "button",
                  class: "transition-transform",
                  aria: { label: t("transactions.toggle_recurring_section"), expanded: !Current.user.transactions_section_collapsed?("upcoming_recurring") },
                  data: {
                    action: "click->transactions-section#toggle keydown->transactions-section#handleToggleKeydown",
                    transactions_section_target: "button chevron"
                  }
                ) %>
            <h3 class="text-xs font-medium text-secondary"><%= t(".upcoming") %></h3>
          </div>
          <div data-transactions-section-target="content">
            <% @projected_recurring.group_by(&:next_expected_date).sort.each do |date, transactions| %>
              <div class="space-y-2">
                <div class="text-xs text-secondary px-2 pt-2"><%= l(date, format: :long) %></div>
                <% transactions.each do |recurring_transaction| %>
                  <%= render "transactions/projected_recurring", recurring_transaction: recurring_transaction %>
                <% end %>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>

      <%= entries_by_date(@transactions.map(&:entry), totals: true) do |entries| %>
        <%= render_entry_rows(entries) %>
      <% end %>
    </div>
  </div>
<% else %>
  <%= render "entries/empty" %>
<% end %>

<div class="pt-4">
  <%= render "shared/pagination", pagy: @pagy, frame: "transactions_results" %>
</div>
