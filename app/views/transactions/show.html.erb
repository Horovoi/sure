<%= render DS::Dialog.new(variant: "drawer") do |dialog| %>
  <% dialog.with_header do %>
    <%= render "transactions/header", entry: @entry %>
  <% end %>

  <% dialog.with_body do %>
    <%# Potential duplicate alert %>
    <% if @entry.transaction.has_potential_duplicate? %>
      <% potential_match = @entry.transaction.potential_duplicate_entry %>
      <% if potential_match %>
        <div class="mx-4 my-3 p-4 rounded-lg border border-warning bg-warning/5">
          <div class="flex items-start gap-3">
            <%= icon "alert-triangle", size: "md", color: "warning" %>
            <div class="flex-1 space-y-2">
              <% copy_scope = @entry.transaction.subscription_charge_duplicate? ? "transactions.subscription_match" : "transactions.show" %>
              <h4 class="text-sm font-medium text-primary"><%= t("#{copy_scope}.potential_duplicate_title") %></h4>
              <p class="text-sm text-secondary"><%= t("#{copy_scope}.potential_duplicate_description") %></p>

              <div class="mt-3 p-3 rounded bg-container border border-primary">
                <div class="flex items-center justify-between">
                  <div>
                    <p class="text-sm font-medium text-primary"><%= potential_match.name %></p>
                    <p class="text-xs text-secondary"><%= potential_match.date.strftime("%b %d, %Y") %> • <%= potential_match.account.name %></p>
                  </div>
                  <p class="text-sm font-medium privacy-sensitive <%= potential_match.amount.negative? ? "text-success" : "text-primary" %>">
                    <%= format_money(-potential_match.amount_money) %>
                  </p>
                </div>
              </div>

              <div class="flex items-center gap-2 mt-3">
                <%# DS::Button: the old "btn btn--primary" classes are not in the design
                    system, so both actions rendered as plain text %>
                <%= render DS::Button.new(text: t("transactions.show.merge_duplicate"),
                      href: merge_duplicate_transaction_path(@entry.transaction),
                      method: :post,
                      size: :sm,
                      data: { turbo_frame: "_top" }) %>
                <%= render DS::Button.new(text: t("transactions.show.keep_both"),
                      href: dismiss_duplicate_transaction_path(@entry.transaction),
                      method: :post,
                      variant: :outline,
                      size: :sm,
                      data: { turbo_frame: "_top" }) %>
              </div>
            </div>
          </div>
        </div>
      <% end %>
    <% end %>

    <%= render "transactions/replaced_subscription_charge", transaction: @entry.transaction %>

    <% dialog.with_section(title: t(".overview"), open: true) do %>
      <div>
        <%= styled_form_with model: @entry,
              url: transaction_path(@entry),
              class: "space-y-2",
              data: { controller: "auto-submit-form" } do |f| %>

          <%= f.text_field :name,
                label: t(".name_label"),
                "data-auto-submit-form-target": "auto" %>

          <%= f.date_field :date,
                label: t(".date_label"),
                max: Date.current,
                disabled: @entry.linked?,
                "data-auto-submit-form-target": "auto" %>

          <% unless @entry.transaction.transfer? %>
            <div class="flex items-center gap-2">
              <%= f.select :nature,
                    [[t("transactions.form.expense"), "outflow"], [t("transactions.form.income"), "inflow"]],
                    { container_class: "w-2/5 sm:w-1/3", label: t(".nature"), selected: @entry.amount.negative? ? "inflow" : "outflow" },
                    { data: { "auto-submit-form-target": "auto" }, disabled: @entry.linked? } %>

              <%= f.money_field :amount, label: t(".amount"),
                    container_class: "w-3/5 sm:w-2/3",
                    auto_submit: true,
                    min: 0,
                    value: @entry.amount.abs,
                    disabled: @entry.linked?,
                    disable_currency: @entry.linked? %>
            </div>

            <%# w2-transfers custom-exchange-rate %>
            <%= render "transactions/exchange_rate_field", form: f, entry: @entry %>
          <% end %>

          <%# w2-transfers transfer-form-fixes: the category follows who owns it (Transaction#category_editable?),
              so the outflow leg of a loan payment or an investment contribution takes one, and the
              inflow leg shows the outflow's category read-only %>
          <% if @entry.transaction.category_editable? %>
            <%= f.fields_for :entryable do |ef| %>
              <% category_classification = @entry.amount.negative? ? "income" : "expense" %>
              <%= render DS::CategorySelect.new(
                    form: ef,
                    categories: Current.family.categories.alphabetically_by_hierarchy.to_a,
                    selected_id: ef.object.category_id,
                    blank_label: t(".uncategorized"),
                    label: t(".category_label"),
                    classification: category_classification,
                    recent_categories: Category.recently_used_for(family: Current.family, excluding: ef.object.category, classification: category_classification).to_a,
                    auto_submit: true
                  ) %>
            <% end %>
          <% elsif @entry.transaction.category_set_on_transfer_outflow? %>
            <div class="space-y-1">
              <div class="opacity-60 cursor-not-allowed">
                <%= f.fields_for :entryable do |ef| %>
                  <%= render DS::CategorySelect.new(
                        form: ef,
                        categories: [],
                        selected_category: transfer_outflow_category(@entry.transaction),
                        label: t(".category_label"),
                        disabled: true
                      ) %>
                <% end %>
              </div>
              <p class="text-xs text-secondary"><%= t(".category_set_on_outflow") %></p>
            </div>
          <% end %>

        <% end %>
      </div>
    <% end %>

    <% dialog.with_section(title: t(".details")) do %>
      <%= styled_form_with model: @entry,
            url: transaction_path(@entry),
            class: "space-y-2",
            data: { controller: "auto-submit-form" } do |f| %>
        <% unless @entry.transaction.transfer? %>
          <%= f.select :account,
              options_for_select(
                Current.family.accounts.alphabetically.pluck(:name, :id),
                @entry.account_id
              ),
              { label: t(".account_label") },
              { disabled: true } %>

          <%= f.fields_for :entryable do |ef| %>

            <%= render DS::MerchantSelect.new(
                  form: ef,
                  method: :merchant_id,
                  merchants: Current.family.available_merchants.with_attached_logo.alphabetically.to_a,
                  selected_id: ef.object.merchant_id,
                  include_blank: t(".none"),
                  label: t(".merchant_label"),
                  auto_submit: true
                ) %>

            <%# Tags save on their own (update_tags), so a toggle doesn't wait for the form. %>
            <%= render DS::TagSelect.new(
                  form: ef,
                  tags: Current.family.tags.alphabetically.to_a,
                  selected_ids: ef.object.tag_ids,
                  label: t(".tags_label"),
                  auto_submit: true,
                  update_url: tags_transaction_path(@entry)
                ) %>
          <% end %>
        <% end %>

        <%= f.text_area :notes,
                label: t(".note_label"),
                placeholder: t(".note_placeholder"),
                rows: 5,
                "data-auto-submit-form-target": "auto" %>

      <% end %>
    <% end %>

    <%# w3-toolstrx transaction-attachments %>
    <% dialog.with_section(title: t("transaction_attachments.section_title"), open: @entry.transaction.attachments.attached?) do %>
      <%= render "transaction_attachments/attachments", transaction: @entry.transaction %>
    <% end %>

    <% if (details = build_transaction_extra_details(@entry)) %>
      <% dialog.with_section(title: t(".additional_details"), open: false) do %>
        <div class="px-3 py-2 space-y-3">
          <pre class="text-xs text-secondary bg-surface-inset rounded p-2 overflow-auto"><%= details[:raw] %></pre>
        </div>
      <% end %>
    <% end %>

    <% dialog.with_section(title: t(".settings")) do %>
      <div class="pb-4">
        <%= styled_form_with model: @entry,
              url: transaction_path(@entry),
              class: "p-3",
              data: { controller: "auto-submit-form" } do |f| %>
          <div class="flex cursor-pointer items-center gap-4 justify-between">
            <div class="text-sm space-y-1">
              <h4 class="text-primary"><%= t(".exclude") %></h4>
              <p class="text-secondary"><%= t(".exclude_description") %></p>
            </div>

            <%= f.toggle :excluded, { data: { auto_submit_form_target: "auto" } } %>
          </div>
        <% end %>
      </div>

      <% if @entry.account.investment? || @entry.account.crypto? %>
        <div class="pb-4">
          <%= styled_form_with model: @entry,
                url: transaction_path(@entry),
                class: "p-3",
                data: { controller: "auto-submit-form" } do |f| %>
            <%= f.fields_for :entryable do |ef| %>
              <div class="flex cursor-pointer items-center gap-4 justify-between">
                <div class="text-sm space-y-1">
                  <h4 class="text-primary"><%= t(".activity_type") %></h4>
                  <p class="text-secondary"><%= t(".activity_type_description") %></p>
                </div>

                <%= ef.select :investment_activity_label,
                      options_for_select(
                        [["—", nil]] + Transaction::ACTIVITY_LABELS.map { |l| [t("transactions.activity_labels.#{l.parameterize(separator: '_')}"), l] },
                        @entry.entryable.investment_activity_label
                      ),
                      { label: false },
                      { class: "form-field__input border border-secondary rounded-lg px-3 py-1.5 max-w-40 text-sm",
                        data: { auto_submit_form_target: "auto" } } %>
              </div>
            <% end %>
          <% end %>
        </div>
      <% end %>

      <div class="pb-4">
        <%= styled_form_with model: @entry,
              url: transaction_path(@entry),
              class: "p-3",
              data: { controller: "auto-submit-form" } do |f| %>
          <%= f.fields_for :entryable do |ef| %>
            <div class="flex cursor-pointer items-center gap-4 justify-between">
              <div class="text-sm space-y-1">
                <h4 class="text-primary"><%= t(".one_time_title", type: @entry.amount.negative? ? t("transactions.form.income") : t("transactions.form.expense")) %></h4>
                <p class="text-secondary"><%= t(".one_time_description") %></p>
              </div>

              <%= ef.toggle :kind, {
                    checked: @entry.transaction.one_time?,
                    data: { auto_submit_form_target: "auto" }
                  }, "one_time", "standard" %>
            </div>
          <% end %>
        <% end %>

        <div class="flex items-center justify-between gap-4 p-3">
          <div class="text-sm space-y-1">
            <h4 class="text-primary"><%= t(".transfer_matcher_title") %></h4>
            <p class="text-secondary"><%= t(".transfer_matcher_description") %></p>
          </div>

          <%= render DS::Link.new(
            text: t(".transfer_matcher_button"),
            icon: "arrow-left-right",
            variant: "outline",
            href: new_transaction_transfer_match_path(@entry),
            frame: :modal
          ) %>
        </div>

        <!-- Convert to Trade (Investment Accounts Only, not already converted) -->
        <% if @entry.account.investment? && @entry.entryable.is_a?(Transaction) && !@entry.excluded? %>
          <div class="flex items-center justify-between gap-2 p-3">
            <div class="text-sm space-y-1">
              <h4 class="text-primary"><%= t(".convert_to_trade_title") %></h4>
              <p class="text-secondary"><%= t(".convert_to_trade_description") %></p>
            </div>

            <%= render DS::Button.new(
              text: t(".convert_to_trade_button"),
              variant: "outline",
              icon: "arrow-right-left",
              href: convert_to_trade_transaction_path(@entry.transaction),
              method: :get,
              frame: :modal
            ) %>
          </div>
        <% end %>

        <%= render "transactions/mark_recurring", transaction: @entry.transaction %>

        <!-- Delete Transaction Form -->
        <div class="flex items-center justify-between gap-2 p-3">
          <div class="text-sm space-y-1">
            <h4 class="text-primary"><%= t(".delete_title") %></h4>
            <p class="text-secondary"><%= t(".delete_subtitle") %></p>
          </div>

          <%= render DS::Button.new(
            text: t(".delete"),
            variant: "outline-destructive",
            href: entry_path(@entry),
            method: :delete,
            confirm: CustomConfirm.for_resource_deletion("transaction"),
            frame: "_top"
          ) %>
        </div>
      </div>
    <% end %>
  <% end %>
<% end %>
