<%# locals: (entry:, categories:, recent_categories:, category_classification:, merchants:, tags:) %>
<%# On a re-render after a failed create the nature comes back inside entry[]. %>
<% nature = params[:nature].presence || params.dig(:entry, :nature).presence || "outflow" %>

<% rate_accounts = Current.family.accounts.to_a %>
<%= styled_form_with model: entry, url: transactions_path, class: "space-y-4", data: {
      controller: "exchange-rate-form category-suggestion",
      action: "submit->exchange-rate-form#prepareSubmit formdata->category-suggestion#syncName hw-combobox:selection->category-suggestion#onNameSuggestionSelected",
      **exchange_rate_form_data(mode: "transaction", accounts: rate_accounts)
    } do |f| %>
  <% if entry.errors.any? %>
    <%= render "shared/form_errors", model: entry %>
  <% end %>

  <section>
    <%= render "shared/transaction_type_tabs", active_tab: nature == "inflow" ? "income" : "expense", account_id: params[:account_id] %>

    <%= f.hidden_field :nature, value: nature %>
    <%= f.hidden_field :entryable_type, value: "Transaction" %>
  </section>

  <section class="space-y-2">
    <%# Past names as you type; picking one also picks its usual category (category_suggestion_controller) %>
    <div class="form-field combobox">
      <%= f.combobox :name,
            name_suggestions_transactions_path(nature: nature),
            free_text: true,
            autocomplete: :list,
            label: t(".description"),
            placeholder: t(".description_placeholder"),
            required: true,
            input: { data: { category_suggestion_target: "name" } } %>
    </div>

    <% if @entry.account_id %>
      <%= f.hidden_field :account_id, data: { exchange_rate_form_target: "account" } %>
    <% else %>
      <%# @selected_account_id: an account carried over from another tab of the modal %>
      <%= f.collection_select :account_id, Current.family.accounts.manual.active.alphabetically, :id, :name, { prompt: t(".account_prompt"), label: t(".account"), selected: @selected_account_id || f.object.account_id }, required: true, class: "form-field__input text-ellipsis",
            data: { exchange_rate_form_target: "account", action: "change->exchange-rate-form#refresh" } %>
    <% end %>

    <%= f.money_field :amount, label: t(".amount"), required: true,
          amount_data: { exchange_rate_form_target: "amount", action: "input->exchange-rate-form#recalculate" },
          currency_data: { exchange_rate_form_target: "currency", action: "change->exchange-rate-form#refresh" } %>
    <div data-category-suggestion-target="categoryField" data-action="change->category-suggestion#onCategorySelected">
      <%= f.fields_for :entryable do |ef| %>
        <%= render DS::CategorySelect.new(
              form: ef,
              categories: categories,
              selected_id: ef.object&.category_id,
              blank_label: t(".category_prompt"),
              label: t(".category"),
              classification: category_classification,
              recent_categories: recent_categories
            ) %>
      <% end %>
    </div>
    <%= f.date_field :date, label: t(".date"), required: true, min: Entry.min_supported_date, max: Date.current, value: entry.date || Date.current,
          data: { exchange_rate_form_target: "date", action: "change->exchange-rate-form#refresh" } %>

    <%# w2-transfers custom-exchange-rate: shown only when the amount's currency is not the account's %>
    <%= render "shared/exchange_rate_tabs",
          id_prefix: "entry",
          rate_name: "entry[entryable_attributes][exchange_rate]",
          converted_name: "entry[converted_amount]",
          rate_value: params.dig(:entry, :entryable_attributes, :exchange_rate),
          converted_value: params.dig(:entry, :converted_amount) %>
  </section>

  <%= render DS::Disclosure.new(title: t(".details")) do %>
    <%= f.fields_for :entryable do |ef| %>
      <div class="space-y-2">
        <%= render DS::MerchantSelect.new(
              form: ef,
              method: :merchant_id,
              merchants: merchants,
              selected_id: ef.object&.merchant_id,
              include_blank: t(".none"),
              label: t(".merchant_label")
            ) %>
        <%= render DS::TagSelect.new(
              form: ef,
              tags: tags,
              selected_ids: Array(ef.object&.tag_ids),
              label: t(".tags_label")
            ) %>
      </div>
    <% end %>
    <%= f.text_area :notes,
                    label: t(".note_label"),
                    placeholder: t(".note_placeholder"),
                    rows: 5,
                    "data-auto-submit-form-target": "auto" %>
  <% end %>

  <section>
    <%= f.submit t(".submit") %>
  </section>
<% end %>
