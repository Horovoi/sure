<%# locals: (entries:, categories:) %>
<%# A container query sets the columns, as the list sits in a side-by-side layout: wide,
    one line per row under a header; narrow, each row stacks (categorizes/_entry_row)
    and the header, which has nothing to line up with, is hidden %>
<%# The checkbox column's header is the All box (checklist-select-all): it checks or
    clears every row. Narrow, where the column names are hidden, it is labelled and counts
    the checked rows. %>
<div id="categorize_transaction_list" class="@container bg-container-inset rounded-xl p-1 space-y-1"
     data-controller="checklist-select-all"
     data-action="change->checklist-select-all#refresh"
     data-checklist-select-all-rows-value="input[name='categorize[entry_ids][]']"
     data-checklist-select-all-count-template-value="<%= t("transactions.categorizes.show.selected_count", count: "%{count}", total: "%{total}") %>">
  <div class="grid grid-cols-[1rem_minmax(0,1fr)_auto] @xl:grid-cols-[1rem_minmax(0,1fr)_6.5rem_6.5rem_9rem] items-center gap-3 px-4 py-2 text-xs font-medium text-secondary">
    <input type="checkbox" id="categorize_select_all" class="checkbox checkbox--light"
           aria-label="<%= t("transactions.categorizes.show.select_all_aria") %>"
           data-checklist-select-all-target="all"
           data-action="checklist-select-all#toggle">
    <label for="categorize_select_all" class="@xl:hidden text-sm text-primary cursor-pointer"><%= t("transactions.categorizes.show.select_all") %></label>
    <span class="@xl:hidden text-right tabular-nums" data-checklist-select-all-target="count"></span>
    <p class="hidden @xl:block"><%= t("transactions.categorizes.show.col_transaction") %></p>
    <p class="hidden @xl:block"><%= t("transactions.categorizes.show.col_date") %></p>
    <p class="hidden @xl:block text-right"><%= t("transactions.categorizes.show.col_amount") %></p>
    <p class="hidden @xl:block"><%= t("transactions.categorizes.show.col_category") %></p>
  </div>

  <div class="shadow-border-xs rounded-lg overflow-hidden">
    <div class="max-h-[32rem] overflow-y-auto divide-y divide-alpha-black-200 theme-dark:divide-alpha-white-200 text-sm" tabindex="-1">
      <% if entries.empty? %>
        <p class="px-4 py-3 bg-container text-secondary"><%= t("transactions.categorizes.show.no_matches") %></p>
      <% else %>
        <% category_options = Category.grouped_select_options(categories) %>
        <% entries.each do |entry| %>
          <%= render "transactions/categorizes/entry_row", entry: entry, category_options: category_options %>
        <% end %>
      <% end %>
    </div>
  </div>
</div>
