<%= render DS::Dialog.new(variant: "drawer", frame: "bulk_transaction_edit_drawer") do |dialog| %>
  <% dialog.with_header(title: t(".header_title"), data: { bulk_select_target: "bulkEditDrawerHeader" }) %>

  <% dialog.with_body do %>
    <%= styled_form_with url: transactions_bulk_update_path, scope: "bulk_update", class: "h-full flex flex-col justify-between gap-4", data: { turbo_frame: "_top" } do |form| %>
      <div class="space-y-4">
        <%= render DS::Disclosure.new(title: t(".overview"), open: true) do %>
          <div class="space-y-2">
            <%# A date input takes no placeholder, so the blank-keeps-it note is helper text %>
            <div class="space-y-1">
              <%= form.date_field :date, label: t(".date_label"), max: Date.current, aria: { describedby: "bulk_update_date_hint" } %>
              <p id="bulk_update_date_hint" class="text-xs text-secondary px-1"><%= t(".date_hint") %></p>
            </div>
            <%= form.text_field :name, label: t(".name_label"), placeholder: t(".name_placeholder"), autocomplete: "off" %>
          </div>
        <% end %>

        <%= render DS::Disclosure.new(title: t(".transactions_section"), open: true) do %>
          <div class="space-y-2">
            <%# No blank row: an empty choice means "leave each category as it is".
                No inline create either, since the selection can mix income and
                expense transactions and a new category needs one of the two. %>
            <%= render DS::CategorySelect.new(
                  form: form,
                  categories: Current.family.categories.alphabetically_by_hierarchy.to_a,
                  label: t(".category_label"),
                  recent_categories: Category.recently_used_for(family: Current.family).to_a,
                  creatable: false
                ) %>
            <%= form.collection_select :merchant_id, Current.family.available_merchants.with_attached_logo.alphabetically, :id, :name, { prompt: t(".merchant_prompt"), label: t(".merchant_label"), variant: :logo, searchable: true } %>
            <%# Native multi-select on purpose: it sends tag_ids only when the user picks some,
                and a sent empty set would clear every selected transaction's tags. %>
            <%# As tall as its tags (up to six rows), not a fixed 160px box %>
            <% tag_options = Current.family.tags.alphabetically.pluck(:name, :id) %>
            <% if tag_options.any? %>
              <%= form.select :tag_ids, tag_options, { include_blank: t(".none"), multiple: true, label: t(".tags_label"), include_hidden: false }, { size: (tag_options.size + 1).clamp(2, 6) } %>
            <% else %>
              <div class="form-field">
                <div class="form-field__body">
                  <span class="form-field__label"><%= t(".tags_label") %></span>
                  <p class="text-sm text-secondary py-1"><%= t(".no_tags") %></p>
                </div>
              </div>
            <% end %>
            <%= form.text_area :notes, label: t(".notes_label"), placeholder: t(".notes_placeholder"), rows: 5 %>
            <%# w3-toolstrx reconciliation-status: blank leaves each mark as it is %>
            <%= form.select :reconciled_status,
                  Entry::RECONCILED_STATUS_CYCLE.map { |status| [ t("transactions.reconcile.statuses.#{status}"), status ] },
                  { include_blank: t("transactions.reconcile.bulk.no_change"), label: t("transactions.reconcile.bulk.label") } %>
            <p class="text-xs text-secondary"><%= t("transactions.reconcile.bulk.hint") %></p>
          </div>
        <% end %>
      </div>

      <div class="flex justify-end gap-2 mt-auto">
        <%= render DS::Button.new(text: t(".cancel"), variant: "ghost", data: { action: "click->DS--dialog#close" }) %>
        <%= render DS::Button.new(text: t(".save"), type: :submit, data: { bulk_select_scope_param: "bulk_update", action: "bulk-select#submitBulkRequest" }) %>
      </div>
    <% end %>
  <% end %>
<% end %>
