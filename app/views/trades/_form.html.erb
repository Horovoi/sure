<%# locals: (model:, account:) %>

<%# A failed create renders the form again with the type that was sent %>
<% type = params[:type].presence || params.dig(:model, :type).presence || "buy" %>

<%# Every type's fields are on the page and the type select shows only its own,
    in the browser. Fetching the form again for each type replaced it under the
    cursor: what was typed while the request ran, or before the type changed, was
    lost. A disabled fieldset is not validated or sent. %>
<% fields_for_types = ->(types, &block) do
     tag.fieldset(class: "space-y-2", hidden: !types.include?(type), disabled: !types.include?(type),
                  data: { trade_form_target: "fields", types: types.join(" ") }, &block)
   end %>

<%= styled_form_with url: trades_path(account_id: account&.id), scope: :model, data: { controller: "trade-form" } do |form| %>
  <div class="space-y-4">
    <% if model.errors.any? %>
      <%= render "shared/form_errors", model: model %>
    <% end %>

    <div class="space-y-2">
      <%= form.select :type, [
          ["Buy", "buy"],
          ["Sell", "sell"],
          ["Deposit", "deposit"],
          ["Withdrawal", "withdrawal"],
          ["Interest", "interest"]
      ],
      { label: t(".type"), selected: type },
      { data: { action: "trade-form#changeType", trade_form_target: "type" } } %>

      <%= fields_for_types.call(%w[buy sell]) do %>
        <% if Security.provider.present? %>
          <div class="form-field combobox">
            <%= form.combobox :ticker,
                            securities_path(country_code: Current.family.country),
                            name_when_new: "entry[manual_ticker]",
                            label: t(".holding"),
                            placeholder: t(".ticker_placeholder"),
                            required: true %>
          </div>
        <% else %>
          <%= form.text_field :manual_ticker, label: "Ticker symbol", placeholder: "AAPL", required: true %>
        <% end %>
      <% end %>

      <%= form.date_field :date, label: true, value: model.date || Date.current, required: true %>

      <%= fields_for_types.call(%w[deposit withdrawal interest]) do %>
        <%= form.money_field :amount, label: t(".amount"), value: model.amount, required: true %>
      <% end %>

      <%= fields_for_types.call(%w[deposit withdrawal]) do %>
        <%= form.collection_select :transfer_account_id, Current.family.accounts.visible.alphabetically, :id, :name, { prompt: t(".account_prompt"), label: t(".account") } %>
      <% end %>

      <%= fields_for_types.call(%w[buy sell]) do %>
        <%= form.number_field :qty, label: t(".qty"), placeholder: "10", min: 0.000000000000000001, step: "any", required: true %>
        <%= form.money_field :price, label: t(".price"), step: "any", precision: 10, required: true %>
      <% end %>
    </div>

    <%= form.submit t(".submit") %>
  </div>
<% end %>
