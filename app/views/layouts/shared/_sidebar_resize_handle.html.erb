<%# locals: (side:) %>
<%# The draggable divider of a resizable side panel: "left" (accounts) or "right"
    (assistant). Drag it, nudge it with the arrow keys (Home resets), or
    double-click it to reset. Drives sidebar_resize_controller. %>
<% suffix = side.capitalize %>
<% edge = side == "left" ? "right-0 translate-x-1/2" : "left-0 -translate-x-1/2" %>
<%= tag.div(
  class: class_names("group/resize absolute inset-y-0 z-20 hidden w-2 cursor-col-resize touch-none lg:block focus-visible:outline-none", edge),
  role: "separator",
  tabindex: "0",
  title: t("layouts.application.resize_hint"),
  aria: { orientation: "vertical", label: t("layouts.application.resize_#{side}_sidebar"), controls: "app_#{side}_panel" },
  data: {
    sidebar_resize_side: side,
    action: "pointerdown->sidebar-resize#start#{suffix} keydown->sidebar-resize#key#{suffix} dblclick->sidebar-resize#reset#{suffix}"
  }
) do %>
  <span class="absolute inset-y-0 left-1/2 w-0.5 -translate-x-1/2 rounded-full bg-transparent transition-colors group-hover/resize:bg-loader group-focus-visible/resize:bg-inverse group-active/resize:bg-inverse"></span>
<% end %>
