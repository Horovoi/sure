<%# locals: (breadcrumbs:) %>

<div class="py-2 flex items-center gap-2 min-w-0">
  <% breadcrumbs.each_with_index do |(name, path), index| %>
    <% if index > 0 %>
      <%= icon("chevron-right", size: "sm") %>
    <% end %>

    <% if path.present? && index < breadcrumbs.size - 1 %>
      <%= link_to name, path, class: "text-sm text-secondary hover:text-primary font-medium rounded-md focus-ring" %>
    <% elsif index == breadcrumbs.size - 1 %>
      <span class="text-primary font-medium text-sm truncate" aria-current="page"><%= name %></span>
    <% else %>
      <span class="text-sm text-secondary font-medium"><%= name %></span>
    <% end %>
  <% end %>
</div>
