<% mobile_nav_items = [
  { name: t(".nav.home"), path: root_path, icon: "pie-chart", icon_custom: false, active: page_active?(root_path) },
  { name: t(".nav.transactions"), path: transactions_path, icon: "credit-card", icon_custom: false, active: page_active?(transactions_path) },
  { name: t(".nav.subscriptions"), path: subscriptions_path, icon: "repeat", icon_custom: false, active: page_active?(subscriptions_path) || page_active?(calendar_subscriptions_path) },
  { name: t(".nav.reports"), path: reports_path, icon: "chart-bar", icon_custom: false, active: page_active?(reports_path) },
  # One item for the Plan page and the budget and goal pages under it
  { name: t(".nav.plan"), path: plan_path, icon: "compass", icon_custom: false, active: page_active?(plan_path) || page_active?(budgets_path) || page_active?(goals_path) },
  { name: t(".nav.assistant"), path: chats_path, icon: "icon-assistant", icon_custom: true, active: page_active?(chats_path), mobile_only: true }
] %>

<% desktop_nav_items = mobile_nav_items.reject { |item| item[:mobile_only] } %>
<% expanded_sidebar_class = "w-full" %>
<% collapsed_sidebar_class = "w-0" %>

<%= render "layouts/shared/htmldoc" do %>
  <%# data-left-panel says whether the accounts panel is open. Below 1280px (xl) there is room
      for one side panel only: when both are set to show, the assistant panel steps aside
      (the CSS below), and opening one closes the other (app_layout_controller). %>
  <div
    class="group/layout flex flex-col lg:flex-row h-full bg-surface"
    data-controller="app-layout"
    data-left-panel="<%= Current.user.show_sidebar? ? "open" : "closed" %>"
    data-action="turbo:before-cache@document->app-layout#closeMobileSidebar"
    data-app-layout-expanded-sidebar-class="<%= expanded_sidebar_class %>"
    data-app-layout-collapsed-sidebar-class="<%= collapsed_sidebar_class %>"
    data-app-layout-user-id-value="<%= Current.user.id %>">
    <%# MOBILE - Accounts drawer: a modal dialog, so focus moves into it, the page
        behind it is inert and Escape closes it %>
    <dialog
      id="app_mobile_sidebar"
      class="fixed inset-0 m-0 h-full w-full max-w-none max-h-none border-0 bg-surface text-primary z-20 pt-[calc(env(safe-area-inset-top)+0.75rem)] pr-3 pb-[calc(env(safe-area-inset-bottom)+0.75rem)] pl-3 overflow-y-auto backdrop:bg-transparent"
      aria-label="<%= t("layouts.application.mobile_sidebar") %>"
      data-app-layout-target="mobileSidebar"
      data-action="close->app-layout#mobileSidebarClosed">
      <div class="mb-2">
        <%= icon("x", as_button: true, aria: { label: t("ds.dialog.close") }, data: { action: "app-layout#closeMobileSidebar" }) %>
      </div>

      <%= render(
        "accounts/account_sidebar_tabs",
        family: Current.family,
        active_tab: @account_group_tab,
        mobile: true
      ) %>
    </dialog>

    <%# MOBILE - Top nav %>
    <nav class="lg:hidden flex justify-between items-center p-3 pt-[calc(env(safe-area-inset-top)+0.75rem)]">
      <%= icon("panel-left", as_button: true,
                             aria: { label: t("layouts.application.open_sidebar"), expanded: "false", controls: "app_mobile_sidebar", haspopup: "dialog" },
                             data: { action: "app-layout#openMobileSidebar", app_layout_target: "mobileToggle" }) %>

      <%= link_to root_path, class: "block", aria: { label: t("layouts.application.home") } do %>
        <%= image_tag "logomark-color.svg", class: "w-9 h-9 mx-auto", alt: "" %>
      <% end %>

      <div class="flex items-center gap-1">
        <%= render "layouts/shared/privacy_toggle" %>
        <%= render "users/user_menu", user: Current.user, placement: "bottom-end", offset: 12 %>
      </div>
    </nav>

    <%# DESKTOP - Left navbar %>
    <div class="hidden lg:block">
      <nav class="h-full flex flex-col shrink-0 w-[84px] py-4 mr-3">
        <div class="pl-2 mb-3">
          <%= link_to root_path, class: "block", aria: { label: t("layouts.application.home") } do %>
            <%= image_tag "logomark-color.svg", class: "w-9 h-9 mx-auto", alt: "" %>
          <% end %>
        </div>

        <ul class="space-y-0.5">
          <% desktop_nav_items.reject { |item| item[:mobile_only] }.each do |nav_item| %>
            <li>
              <%= render "layouts/shared/nav_item", **nav_item %>
            </li>
          <% end %>
        </ul>

        <div class="pl-2 mt-auto mx-auto flex flex-col gap-2">
          <%= render "users/user_menu", user: Current.user %>
        </div>
      </nav>
    </div>

    <%# DESKTOP - Left sidebar %>
    <%= tag.div id: "app_left_panel",
       class: class_names(
        "hidden lg:block py-4 overflow-y-auto shrink-0 max-w-[320px] transition-all duration-300",
        Current.user.show_sidebar? ? expanded_sidebar_class : collapsed_sidebar_class,
       ),
       inert: !Current.user.show_sidebar?,
       data: { app_layout_target: "leftSidebar" } do %>
      <% if content_for?(:sidebar) %>
        <%= yield :sidebar %>
      <% else %>
        <div class="h-full flex flex-col">
          <div class="overflow-y-auto grow">
            <%= render "accounts/account_sidebar_tabs", family: Current.family, active_tab: @account_group_tab %>
          </div>
        </div>
      <% end %>
    <% end %>

    <%# SHARED - Main content %>
    <%= tag.main class: class_names("grow overflow-y-auto px-3 lg:px-10 pt-4 pb-[calc(5rem+env(safe-area-inset-bottom))] lg:pb-4 w-full mx-auto max-w-5xl"), data: { app_layout_target: "content" } do %>
      <div class="hidden lg:flex gap-2 items-center justify-between mb-6">
        <div class="flex items-center gap-2">
          <%= icon("panel-left", as_button: true,
                                 aria: { label: t("layouts.application.toggle_left_sidebar"), expanded: Current.user.show_sidebar?.to_s, controls: "app_left_panel" },
                                 data: { action: "app-layout#toggleLeftSidebar", app_layout_target: "leftToggle" }) %>

          <% if content_for?(:breadcrumbs) %>
            <%= yield :breadcrumbs %>
          <% else %>
            <%= render "layouts/shared/breadcrumbs", breadcrumbs: @breadcrumbs %>
          <% end %>
        </div>
        <div class="flex items-center gap-1">
          <%= render "layouts/shared/privacy_toggle" %>
          <%= icon("panel-right", as_button: true,
                                  aria: { label: t("layouts.application.toggle_right_sidebar"), expanded: Current.user.show_ai_sidebar?.to_s, controls: "app_right_panel" },
                                  data: { action: "app-layout#toggleRightSidebar", app_layout_target: "rightToggle" }) %>
        </div>
      </div>

      <% if content_for?(:page_header) %>
        <%= yield :page_header %>
      <% end %>

      <%= yield %>
    <% end %>

    <%# DESKTOP - Right sidebar %>
    <%# Below 1280px it gives way to an open accounts panel (see data-left-panel above) %>
    <%= tag.div id: "app_right_panel",
        class: class_names(
          "hidden lg:block h-full overflow-y-auto shrink-0 max-w-[400px] transition-all duration-300",
          "max-xl:group-data-[left-panel=open]/layout:w-0",
          Current.user.show_ai_sidebar? ? expanded_sidebar_class : collapsed_sidebar_class,
        ),
        inert: !Current.user.show_ai_sidebar?,
        data: { app_layout_target: "rightSidebar" } do %>
      <%= tag.div id: "chat-container", class: "relative h-full", data: { controller: "chat hotkey", turbo_permanent: true } do %>
        <div class="flex flex-col h-full justify-between shrink-0">
          <%= turbo_frame_tag chat_frame, src: chat_view_path(@chat), loading: "lazy", class: "h-full" do %>
            <div class="flex justify-center items-center h-full">
              <%= icon("loader-circle", class: "animate-spin") %>
            </div>
          <% end %>
        </div>

        <% unless Current.user.ai_enabled? %>
          <div class="absolute backdrop-blur-lg inset-0 h-full w-full flex flex-col justify-center items-center pl-0.5 pr-4">
            <%= render "chats/ai_consent" %>
          </div>
        <% end %>
      <% end %>
    <% end %>

    <%# MOBILE - Bottom Nav: fixed to the window bottom, padded above the home indicator.
        The main content's bottom padding (5rem + the inset) keeps its last row clear of it. %>
    <%= tag.nav class: "lg:hidden fixed bottom-0 left-0 right-0 bg-surface z-10 border-t border-tertiary flex justify-around pb-[env(safe-area-inset-bottom)]" do %>
      <% mobile_nav_items.each do |nav_item| %>
        <%= render "layouts/shared/nav_item", **nav_item %>
      <% end %>
    <% end %>
  </div>
<% end %>
