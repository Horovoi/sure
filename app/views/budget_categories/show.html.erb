<%= render DS::Dialog.new(variant: :drawer) do |dialog| %>
  <% dialog.with_header do %>
    <%# The ring comes first and centres on the title block, as in a list row %>
    <div class="flex min-w-0 items-center gap-3">
      <% if @budget_category.budget.initialized? %>
        <div class="w-10 h-10 shrink-0">
          <%= render "budget_categories/budget_category_donut",
                      budget_category: @budget_category %>
        </div>
      <% end %>

      <div class="min-w-0">
        <p class="text-sm text-secondary"><%= t(".category") %></p>
        <h3 class="text-2xl font-medium text-primary truncate">
          <%= @budget_category.name %>
        </h3>

        <% if @budget_category.budget.initialized? %>
          <p class="text-sm text-secondary tabular-nums">
            <span class="text-primary privacy-sensitive">
              <%= format_money(@budget_category.actual_spending_money) %>
            </span>
            <span>/</span>
            <span class="privacy-sensitive"><%= format_money(@budget_category.budgeted_spending_money) %></span>
          </p>
        <% end %>
      </div>
    </div>
  <% end %>

  <% dialog.with_body do %>
    <% dialog.with_section(title: t(".overview"), open: true) do %>
      <div class="pb-4">
        <dl class="space-y-3 px-3 py-2">
          <div class="flex items-center justify-between text-sm">
            <dt class="text-secondary">
              <%= t(".period_spending", period: l(@budget_category.budget.start_date, format: "%b %Y")) %>
            </dt>
            <dd class="text-primary font-medium privacy-sensitive">
              <%= format_money @budget_category.actual_spending_money %>
            </dd>
          </div>

          <% if @budget_category.budget.initialized? %>
            <div class="flex items-center justify-between text-sm">
              <dt class="text-secondary"><%= t(".status") %></dt>
              <% if @budget_category.available_to_spend.negative? %>
                <dd class="flex items-center gap-1 text-destructive font-medium">
                  <%= icon "alert-circle", size: "sm", color: "destructive" %>
                  <span class="privacy-sensitive"><%= format_money @budget_category.available_to_spend_money.abs %></span>
                  <span><%= t(".overspent") %></span>
                </dd>
              <% elsif @budget_category.available_to_spend.zero? %>
                <dd class="flex items-center gap-1 text-warning font-medium">
                  <%= icon "x-circle", size: "sm", color: "warning" %>
                  <span class="privacy-sensitive"><%= format_money @budget_category.available_to_spend_money %></span>
                  <span><%= t(".left") %></span>
                </dd>
              <% else %>
                <dd class="flex items-center gap-1 text-success font-medium">
                  <%= icon "check-circle", size: "sm", color: "success" %>
                  <span class="privacy-sensitive"><%= format_money @budget_category.available_to_spend_money %></span>
                  <span><%= t(".left") %></span>
                </dd>
              <% end %>
            </div>

            <div class="flex items-center justify-between text-sm">
              <dt class="text-secondary"><%= t(".budgeted") %></dt>
              <dd class="text-primary font-medium privacy-sensitive">
                <%= format_money @budget_category.budgeted_spending_money %>
              </dd>
            </div>

            <% if @budget_category.rolled_over? %>
              <div class="flex items-center justify-between text-sm" data-testid="budget-category-rolled-over-detail">
                <dt class="text-secondary"><%= t(".rolled_over") %></dt>
                <dd class="text-primary font-medium privacy-sensitive">
                  <%= format_money @budget_category.display_rolled_over_amount_money %>
                </dd>
              </div>
            <% end %>
          <% end %>

          <% if @budget_category.subscriptions_reserved? %>
            <div class="flex flex-wrap items-center justify-between gap-y-1 text-sm" data-testid="budget-category-reserved-detail">
              <dt class="text-secondary flex items-center gap-1.5">
                <span class="inline-block w-2.5 h-2.5 rounded-sm bg-reserved-hatched text-secondary shrink-0" aria-hidden="true"></span>
                <%= t("budgets.subscription_reservations.reserved") %>
              </dt>
              <dd class="text-primary font-medium text-right">
                <span class="privacy-sensitive"><%= format_money @budget_category.subscriptions_reserved %></span>
                <% if @budget_category.subscriptions_reserved_unconvertible_count.positive? %>
                  <span class="block text-xs text-subdued font-normal">
                    <%= t("budgets.subscription_reservations.unconvertible", count: @budget_category.subscriptions_reserved_unconvertible_count) %>
                  </span>
                <% end %>
              </dd>
              <dd class="w-full text-xs text-subdued"><%= t("budgets.subscription_reservations.explanation") %></dd>
            </div>
          <% end %>

          <div class="flex items-center justify-between text-sm">
            <dt class="text-secondary"><%= t(".monthly_average") %>
              <% if Current.family.fiscal_month_enabled? %>
                <span class="ml-1 px-1.5 py-0.5 border border-secondary rounded-md text-xs"><%= t(".fiscal") %></span>
              <% end %>
            </dt>
            <dd class="text-primary font-medium privacy-sensitive">
              <%= @budget_category.avg_monthly_expense_money.format %>
            </dd>
          </div>

          <div class="flex items-center justify-between text-sm">
            <dt class="text-secondary"><%= t(".monthly_median") %>
              <% if Current.family.fiscal_month_enabled? %>
                <span class="ml-1 px-1.5 py-0.5 border border-secondary rounded-md text-xs"><%= t(".fiscal") %></span>
              <% end %>
            </dt>
            <dd class="text-primary font-medium privacy-sensitive">
              <%= @budget_category.median_monthly_expense_money.format %>
            </dd>
          </div>
        </dl>
      </div>
    <% end %>

    <% dialog.with_section(title: t(".recent_transactions"), open: true) do %>
      <div class="space-y-2">
        <div class="px-3 py-4 space-y-2">
          <% if @recent_transactions.any? %>
            <ul class="space-y-2 mb-4">
              <% @recent_transactions.each_with_index do |transaction, index| %>
                <li class="flex gap-4 text-sm space-y-1">
                  <div class="flex flex-col items-center gap-1.5 pt-2">
                    <div class="rounded-full h-1.5 w-1.5 bg-subdued"></div>
                    <% unless index == @recent_transactions.length - 1 %>
                      <div class="h-12 w-px border-l border-secondary"></div>
                    <% end %>
                  </div>

                  <div class="flex justify-between w-full">
                    <div>
                      <p class="text-secondary text-xs">
                        <%= l(transaction.entry.date, format: "%b %-d") %>
                      </p>
                      <%= link_to transaction.entry.name,
                                  transactions_path,
                                  class: "text-primary hover:underline",
                                  data: { turbo_frame: :_top } %>
                    </div>
                    <p class="text-primary font-medium tabular-nums whitespace-nowrap privacy-sensitive">
                      <%= format_money transaction.entry.amount_money %>
                    </p>
                  </div>
                </li>
              <% end %>
            </ul>

            <%= render DS::Link.new(
              text: t(".view_all"),
              variant: "outline",
              full_width: true,
              href: transactions_path(q: {
                categories: [@budget_category.name],
                start_date: @budget.start_date,
                end_date: @budget.end_date
              }),
              frame: :_top
            ) %>
          <% else %>
            <p class="text-secondary text-sm mb-4">
              <%= t(".no_transactions") %>
            </p>
          <% end %>
        </div>
      </div>
    <% end %>
  <% end %>
<% end %>
