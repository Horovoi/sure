<%# locals: (budget:, budget_categories:) %>

<%# One dialog for the whole step: each row's move button fills it in (budget-move
    controller). auto_open: false because a row button opens it, disable_frame: true
    because it lives on the page, not in the modal frame. %>
<%= render DS::Dialog.new(
      auto_open: false,
      disable_frame: true,
      width: "md",
      data: { budget_move_target: "dialog", testid: "budget-move-dialog" }
    ) do |dialog| %>
  <% dialog.with_header(title: t("budget_categories.move.dialog_title")) %>

  <% dialog.with_body do %>
    <%# Closed on a successful submit only, so a refused move keeps the dialog and its
        reason on screen %>
    <%= form_with url: move_budget_budget_categories_path(budget),
                  method: :post,
                  class: "space-y-4",
                  data: { action: "turbo:submit-end->budget-move#submitEnd" } do %>
      <%= hidden_field_tag "from_id", nil, data: { budget_move_target: "fromId" } %>

      <div class="space-y-1">
        <p class="text-sm text-secondary"><%= t("budget_categories.move.from_label") %></p>
        <p class="text-sm">
          <span class="text-primary font-medium" data-budget-move-target="fromName"></span>
          <span class="text-secondary tabular-nums" data-budget-move-target="available"></span>
        </p>
      </div>

      <%# .form-field gives the inputs their border and focus halo; a bare
          .form-field__input has none %>
      <div class="form-field">
        <%= label_tag "budget_category_move_amount", t("budget_categories.move.amount_label"), class: "form-field__label" %>
        <%= number_field_tag "budget_category_move[amount]", nil,
                             id: "budget_category_move_amount",
                             step: Money::Currency.new(budget.currency).step,
                             min: Money::Currency.new(budget.currency).step,
                             required: true,
                             autocomplete: "off",
                             class: "form-field__input w-full text-right tabular-nums",
                             data: { budget_move_target: "amount" } %>
      </div>

      <div class="form-field">
        <%= label_tag "to_id", t("budget_categories.move.to_label"), class: "form-field__label" %>
        <%= select_tag "to_id",
                       safe_join(budget_categories.sort_by { |bc| bc.category.name_with_parent }.map { |bc|
                         tag.option(bc.category.name_with_parent,
                                    value: bc.id,
                                    data: { category_id: bc.category_id, parent_id: bc.category.parent_id })
                       }),
                       class: "form-field__input w-full",
                       data: { budget_move_target: "toSelect" } %>
      </div>

      <%# Why the last move was refused; the notification tray sits under the modal %>
      <p id="budget-move-error" class="hidden" data-budget-move-target="error"></p>

      <%# The only other envelopes are the row's own parent or subcategories, which a move
          cannot reach: a parent's amount is built from its subcategories' %>
      <p class="hidden text-sm text-secondary" data-budget-move-target="noDestination">
        <%= t("budget_categories.move.no_destination") %>
      </p>

      <div class="flex justify-end gap-2 pt-1">
        <%= render DS::Button.new(text: t("budget_categories.move.cancel"),
                                  variant: "secondary",
                                  type: "button",
                                  data: { action: "budget-move#close" }) %>
        <%= render DS::Button.new(text: t("budget_categories.move.submit"),
                                  type: "submit",
                                  data: { budget_move_target: "submit" }) %>
      </div>
    <% end %>
  <% end %>
<% end %>
