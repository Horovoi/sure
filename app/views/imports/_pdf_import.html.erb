<%# locals: (import:) %>

<%# While the document is processed the frame polls this page and swaps in the result;
    the response without polling attributes (any other state) stops it. Links and forms
    inside still navigate the whole page. %>
<%= turbo_frame_tag dom_id(import, :pdf_import),
      target: "_top",
      class: "block h-full",
      data: import.processing? ? {
        controller: "polling",
        polling_url_value: import_path(import),
        polling_interval_value: 3000
      } : {} do %>
<div class="h-full flex flex-col justify-center items-center">
  <div class="space-y-6 max-w-lg w-full">
    <% if import.processing? || (import.pending? && !import.ai_processed?) %>
      <div class="mx-auto bg-gray-500/5 h-8 w-8 rounded-full flex items-center justify-center">
        <%= icon "loader", class: "animate-pulse" %>
      </div>

      <div class="text-center space-y-2">
        <h1 class="font-medium text-primary text-center text-3xl"><%= t(".processing.title") %></h1>
        <p class="text-sm text-secondary"><%= t(".processing.description") %></p>
      </div>

      <div class="space-y-2 flex flex-col">
        <%= render DS::Link.new(text: t(".refresh_status"), href: import_path(import), variant: "primary", full_width: true) %>
        <%= render DS::Link.new(text: t(".back_to_dashboard"), href: root_path, variant: "secondary", full_width: true) %>
        <%= button_to t(".delete_import"), import_path(import), method: :delete, class: "w-full font-medium text-sm px-3 py-2 rounded-lg text-primary bg-gray-200 hover:bg-gray-300" %>
      </div>
    <% elsif import.pending? || import.reverted? %>
      <% already_recorded = import.already_recorded %>

      <div class="mx-auto bg-success/10 h-8 w-8 rounded-full flex items-center justify-center">
        <%= icon "check", class: "text-success" %>
      </div>

      <div class="text-center space-y-2">
        <h1 class="font-medium text-primary text-center text-3xl"><%= t(".review.title") %></h1>
        <p class="text-sm text-secondary"><%= t(".review.description", count: import.rows_count) %></p>
        <% if import.reverted? %>
          <p class="text-sm text-secondary"><%= t("imports.ready.reverted_notice") %></p>
        <% end %>
      </div>

      <div class="bg-container border border-primary rounded-xl p-4 space-y-4">
        <div class="space-y-2">
          <h2 class="font-medium text-primary"><%= t(".document_type") %></h2>
          <p class="text-sm text-secondary px-3 py-2 bg-gray-500/5 rounded-lg"><%= import.document_type&.humanize || t(".unknown_document_type") %></p>
        </div>

        <%= render "imports/pdf_import_counts", import: import, already_recorded: already_recorded %>

        <div class="space-y-2">
          <h2 class="font-medium text-primary"><%= t(".review.account_label") %></h2>
          <%= form_with model: import, url: import_path(import), method: :patch, class: "space-y-2" do |form| %>
            <% accounts = import.family.accounts.visible_manual.alphabetically %>
            <% if accounts.any? %>
              <%= form.select :account_id, options_for_select(accounts.map { |account| [account.name, account.id] }, import.account_id), { include_blank: t(".review.account_prompt") }, class: "form-field__input" %>
              <% if import.account.nil? %>
                <p class="text-xs text-secondary"><%= t(".review.account_hint") %></p>
              <% end %>
              <%= form.submit t(".review.save_account"), class: "w-full font-medium text-sm px-3 py-2 rounded-lg text-inverse bg-inverse hover:bg-inverse-hover" %>
            <% else %>
              <p class="text-sm text-secondary px-3 py-2 bg-yellow-500/10 rounded-lg"><%= t(".review.no_accounts") %></p>
              <%= render DS::Link.new(text: t(".review.create_account"), href: new_depository_path(return_to: import_path(import)), variant: "primary", full_width: true, frame: :modal) %>
            <% end %>
          <% end %>
        </div>
      </div>

      <%= render "imports/already_recorded", import: import, matches: already_recorded %>

      <div class="space-y-2 flex flex-col">
        <% if import.publishable? %>
          <%= button_to t(".review.publish", count: import.new_rows_count), publish_import_path(import), method: :post, class: "w-full font-medium text-sm px-3 py-2 rounded-lg text-inverse bg-inverse hover:bg-inverse-hover" %>
          <%= render DS::Link.new(text: t(".review.review_transactions"), href: import_clean_path(import), variant: "secondary", full_width: true) %>
        <% elsif import.account.present? %>
          <%= render DS::Link.new(text: t(".review.review_transactions"), href: import_clean_path(import), variant: "primary", full_width: true) %>
        <% else %>
          <p class="text-center text-sm text-secondary"><%= t(".review.select_account") %></p>
        <% end %>
        <%= render DS::Link.new(text: t(".back_to_imports"), href: imports_path, variant: "secondary", full_width: true) %>
      </div>
    <% elsif import.complete? %>
      <% already_recorded = import.already_recorded %>

      <div class="mx-auto bg-success/10 h-8 w-8 rounded-full flex items-center justify-center">
        <%= icon "check", class: "text-success" %>
      </div>

      <div class="text-center space-y-2">
        <h1 class="font-medium text-primary text-center text-3xl"><%= t(".complete.title") %></h1>
        <p class="text-sm text-secondary">
          <%= import.entries.any? ? t(".complete.description") : t(".complete.nothing_new") %>
        </p>
      </div>

      <div class="bg-container border border-primary rounded-xl p-4 space-y-4">
        <%= render "imports/pdf_import_counts", import: import, already_recorded: already_recorded %>
        <%= render "imports/pdf_statement_balance_check", import: import %>
      </div>

      <%= render "imports/already_recorded", import: import, matches: already_recorded %>

      <div class="space-y-2 flex flex-col">
        <%= render DS::Link.new(text: t(".back_to_dashboard"), href: root_path, variant: "primary", full_width: true) %>
        <%= render DS::Link.new(text: t(".back_to_imports"), href: imports_path, variant: "secondary", full_width: true) %>
      </div>
    <% elsif import.processing_failed? %>
      <div class="mx-auto bg-destructive/10 h-8 w-8 rounded-full flex items-center justify-center">
        <%= icon "x", class: "text-destructive" %>
      </div>

      <div class="text-center space-y-2">
        <h1 class="font-medium text-primary text-center text-3xl"><%= t(".failed.title") %></h1>
        <p class="text-sm text-secondary"><%= t(".failed.description") %></p>
        <% if import.error.present? %>
          <p class="text-sm text-destructive"><%= import.error %></p>
        <% end %>
      </div>

      <div class="space-y-2 flex flex-col">
        <%= button_to t(".retry_processing"), retry_processing_import_path(import), method: :post, class: "w-full font-medium text-sm px-3 py-2 rounded-lg text-inverse bg-inverse hover:bg-inverse-hover" %>
        <%= render DS::Link.new(text: t(".failed.try_another_file"), href: new_import_path, variant: "secondary", full_width: true) %>
        <%= button_to t(".delete_import"), import_path(import), method: :delete, class: "w-full font-medium text-sm px-3 py-2 rounded-lg text-primary bg-gray-200 hover:bg-gray-300" %>
      </div>
    <% elsif import.indexed? %>
      <div class="mx-auto bg-success/10 h-8 w-8 rounded-full flex items-center justify-center">
        <%= icon "check", class: "text-success" %>
      </div>

      <div class="text-center space-y-2">
        <h1 class="font-medium text-primary text-center text-3xl"><%= t(".indexed.title") %></h1>
        <p class="text-sm text-secondary"><%= t(".indexed.description") %></p>
      </div>

      <div class="bg-container border border-primary rounded-xl p-4 space-y-4">
        <div class="space-y-2">
          <h2 class="font-medium text-primary"><%= t(".document_type") %></h2>
          <p class="text-sm text-secondary px-3 py-2 bg-gray-500/5 rounded-lg"><%= import.document_type&.humanize || t(".unknown_document_type") %></p>
        </div>

        <div class="space-y-2">
          <h2 class="font-medium text-primary"><%= t(".indexed.summary") %></h2>
          <p class="text-sm text-secondary px-3 py-2 bg-gray-500/5 rounded-lg whitespace-pre-wrap"><%= import.ai_summary %></p>
        </div>
      </div>

      <div class="space-y-2 flex flex-col">
        <%= render DS::Link.new(text: t(".back_to_imports"), href: imports_path, variant: "primary", full_width: true) %>
        <%= button_to t(".delete_import"), import_path(import), method: :delete, class: "w-full font-medium text-sm px-3 py-2 rounded-lg text-primary bg-gray-200 hover:bg-gray-300" %>
      </div>
    <% else %>
      <div class="text-center space-y-2">
        <h1 class="font-medium text-primary text-center text-3xl"><%= t(".unknown_state.title") %></h1>
        <p class="text-sm text-secondary"><%= t(".unknown_state.description") %></p>
      </div>

      <div class="space-y-2 flex flex-col">
        <%= render DS::Link.new(text: t(".back_to_imports"), href: imports_path, variant: "primary", full_width: true) %>
      </div>
    <% end %>
  </div>
</div>
<% end %>
