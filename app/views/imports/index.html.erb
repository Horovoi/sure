<%# The header as on Tags and Rules: the title and the primary action in one row %>
<div class="space-y-4">
  <header class="flex flex-wrap items-center justify-between gap-x-4 gap-y-2">
    <h1 class="text-primary text-xl font-medium"><%= t(".title") %></h1>
    <%= render DS::Link.new(
          text: t(".new"),
          variant: "primary",
          href: new_import_path,
          icon: "plus",
          frame: :modal
        ) %>
  </header>

  <div class="bg-container rounded-xl shadow-border-xs">
    <% if @imports.any? %>
      <div class="overflow-x-auto" tabindex="-1">
        <table class="w-full">
          <thead>
            <tr class="text-xs font-medium text-secondary border-b border-divider">
              <th class="px-4 py-3 text-left font-medium min-w-44"><%= t("imports.table.header.date") %></th>
              <th class="px-2 py-3 text-left font-medium min-w-32"><%= t("imports.table.header.operation") %></th>
              <th class="px-2 py-3 text-left font-medium min-w-24"><%= t("imports.table.header.status") %></th>
              <th class="px-4 py-3 text-right font-medium min-w-20"><span class="sr-only"><%= t("imports.table.header.actions") %></span></th>
            </tr>
          </thead>
          <tbody>
            <% @imports.ordered.each do |import| %>
              <tr id="<%= dom_id import %>" class="border-b border-subdued last:border-b-0 hover:bg-container-hover">
                <td class="px-4 py-3">
                  <span class="text-sm text-secondary whitespace-nowrap">
                    <%= l(import.updated_at, format: :long) %>
                  </span>
                </td>
                <td class="px-2 py-3">
                  <%= link_to import_path(import), class: "font-medium text-sm text-primary hover:underline rounded-sm focus-ring" do %>
                    <% if import.account.present? %>
                      <%= import.account.name + " " %>
                    <% end %>
                    <%= import.type.titleize.gsub(/ Import\z/, "") %>
                  <% end %>
                </td>
                <td class="px-2 py-3">
                  <% if import.pending? %>
                    <%= render "shared/badge" do %>
                      <%= t("imports.table.row.status.in_progress") %>
                    <% end %>
                  <% elsif import.processing? %>
                    <%= render "shared/badge", color: "warning", pulse: true do %>
                      <%= t("imports.table.row.status.processing") %>
                    <% end %>
                  <% elsif import.processing_failed? %>
                    <%= render "shared/badge", color: "error" do %>
                      <%= t("imports.table.row.status.processing_failed") %>
                    <% end %>
                  <% elsif import.indexed? %>
                    <%= render "shared/badge", color: "success" do %>
                      <%= t("imports.table.row.status.indexed") %>
                    <% end %>
                  <% elsif import.importing? %>
                    <%= render "shared/badge", color: "warning", pulse: true do %>
                      <%= t("imports.table.row.status.uploading") %>
                    <% end %>
                  <% elsif import.failed? %>
                    <%= render "shared/badge", color: "error" do %>
                      <%= t("imports.table.row.status.failed") %>
                    <% end %>
                  <% elsif import.reverting? %>
                    <%= render "shared/badge", color: "warning", pulse: true do %>
                      <%= t("imports.table.row.status.reverting") %>
                    <% end %>
                  <% elsif import.reverted? %>
                    <%= render "shared/badge" do %>
                      <%= t("imports.table.row.status.reverted") %>
                    <% end %>
                  <% elsif import.revert_failed? %>
                    <%= render "shared/badge", color: "error" do %>
                      <%= t("imports.table.row.status.revert_failed") %>
                    <% end %>
                  <% elsif import.complete? %>
                    <%= render "shared/badge", color: "success" do %>
                      <%= t("imports.table.row.status.complete") %>
                    <% end %>
                  <% end %>
                </td>
                <td class="px-4 py-2 text-right">
                  <div class="flex items-center justify-end gap-1">
                    <% if import.revertable? %>
                      <%= render DS::Button.new(
                            variant: :icon,
                            size: :sm,
                            icon: "rotate-ccw",
                            href: revert_import_path(import),
                            method: :put,
                            title: t("imports.table.row.actions.revert"),
                            aria_label: t("imports.table.row.actions.revert"),
                            confirm: t("imports.table.row.actions.confirm_revert")
                          ) %>
                    <% elsif import.deletable? %>
                      <%= render DS::Button.new(
                            variant: :icon,
                            size: :sm,
                            icon: "trash-2",
                            href: import_path(import),
                            method: :delete,
                            title: t("imports.table.row.actions.delete"),
                            aria_label: t("imports.table.row.actions.delete"),
                            confirm: CustomConfirm.for_resource_deletion("import")
                          ) %>
                    <% end %>

                    <%= render DS::Link.new(
                          variant: :icon,
                          size: :sm,
                          icon: "eye",
                          href: import_path(import),
                          title: t("imports.table.row.actions.view"),
                          aria: { label: t("imports.table.row.actions.view") }
                        ) %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <%= render DS::EmptyState.new(icon: "download", title: t("imports.table.empty")) do |empty| %>
        <% empty.with_action do %>
          <%= render DS::Link.new(text: t(".new"), variant: "outline", href: new_import_path, icon: "plus", frame: :modal) %>
        <% end %>
      <% end %>
    <% end %>
  </div>

  <% if @pagy.pages > 1 %>
    <%= render "shared/pagination", pagy: @pagy %>
  <% end %>
</div>
