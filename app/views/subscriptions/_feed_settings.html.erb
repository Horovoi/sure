<%# locals: (feed_url:) %>
<%# The opt-in iCal feed of upcoming subscriptions and recurring rows (decision 41). %>

<section id="subscriptions-feed" class="bg-container rounded-xl shadow-border-xs p-4 space-y-3" data-testid="subscriptions-feed">
  <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-3">
    <div class="space-y-1">
      <h2 class="text-sm font-medium text-primary"><%= t(".title") %></h2>
      <p class="text-xs text-secondary"><%= t(".description", days: RecurringTransaction::IcalFeed::DAYS) %></p>
    </div>

    <div class="flex items-center gap-2 shrink-0">
      <% if feed_url %>
        <%= render DS::Button.new(
          text: t(".reset"),
          variant: "outline",
          icon: "refresh-cw",
          href: reset_feed_subscriptions_path,
          method: :post,
          confirm: CustomConfirm.new(title: t(".reset_confirm_title"), body: t(".reset_confirm_body"), btn_text: t(".reset")),
          data: { testid: "subscriptions-feed-reset" }
        ) %>
        <%= render DS::Button.new(
          text: t(".disable"),
          variant: "outline",
          icon: "x",
          href: disable_feed_subscriptions_path,
          method: :delete,
          data: { testid: "subscriptions-feed-disable" }
        ) %>
      <% else %>
        <%= render DS::Button.new(
          text: t(".enable"),
          variant: "primary",
          icon: "calendar-plus",
          href: enable_feed_subscriptions_path,
          method: :post,
          data: { testid: "subscriptions-feed-enable" }
        ) %>
      <% end %>
    </div>
  </div>

  <% if feed_url %>
    <div class="space-y-2" data-controller="clipboard">
      <label for="subscriptions_feed_url" class="block text-xs font-medium text-secondary"><%= t(".url_label") %></label>
      <div class="flex items-center gap-2">
        <code id="subscriptions_feed_url"
              class="flex-1 min-w-0 px-3 py-2 text-xs font-mono text-primary bg-surface-inset rounded-lg break-all select-all"
              data-clipboard-target="source"
              data-testid="subscriptions-feed-url"><%= feed_url %></code>
        <button type="button"
                class="p-2 rounded-lg text-secondary hover:text-primary hover:bg-surface-hover transition-colors"
                title="<%= t(".copy") %>"
                aria-label="<%= t(".copy") %>"
                data-action="clipboard#copy">
          <span data-clipboard-target="iconDefault"><%= icon "copy", size: "sm", color: "current" %></span>
          <span data-clipboard-target="iconSuccess" class="hidden"><%= icon "check", size: "sm", color: "current" %></span>
        </button>
      </div>
      <%= link_to t(".open_in_calendar"), feed_url.sub(/\Ahttps?:/, "webcal:"),
            class: "inline-block text-xs text-primary underline hover:no-underline" %>
    </div>
  <% end %>

  <p class="flex items-start gap-2 text-xs text-secondary">
    <%= icon "info", size: "sm", class: "shrink-0 mt-0.5" %>
    <span><%= t(".lan_note") %></span>
  </p>
</section>
