<% kind = @other_recurring ? SubscriptionsController::OTHER_RECURRING_KIND : nil %>
<div class="space-y-4 flex flex-col">
  <header class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
    <div>
      <h1 class="text-primary text-xl font-medium"><%= t(".title") %></h1>
      <p class="text-secondary text-sm mt-1">
        <span class="font-medium text-primary"><%= @active_count %></span> <%= t(".summary.active") %><% if @inactive_count > 0 %> ·
        <span class="font-medium text-primary"><%= @inactive_count %></span> <%= t(".summary.paused") %><% end %> ·
        <span class="font-medium text-primary"><%= format_money(@monthly_total) %></span><%= t(".summary.per_month") %> ·
        <span class="font-medium text-primary"><%= format_money(@yearly_total) %></span><%= t(".summary.per_year") %>
      </p>
    </div>

    <div class="flex items-center gap-2">
      <%= render DS::Link.new(
        text: t(".calendar"),
        icon: "calendar",
        variant: "outline",
        href: calendar_subscriptions_path
      ) %>

      <%= render DS::Menu.new(variant: :button, placement: "bottom-end") do |menu| %>
        <% menu.with_button(text: t(".add_subscription"), variant: "primary", icon: "plus") %>
        <% menu.with_item(variant: "link", text: t(".add_manually"), icon: "edit-3", href: new_subscription_path) %>
        <% menu.with_item(variant: "button", text: t(".detect_from_history"), icon: "search", href: detect_subscriptions_path, method: :post) %>
      <% end %>
    </div>
  </header>

  <%# Suggestion banner - only show when there are pending suggestions %>
  <% if @suggestion_count > 0 %>
    <div class="bg-blue-50 theme-dark:bg-blue-950 border border-blue-200 theme-dark:border-blue-800 rounded-xl p-4 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3">
      <div class="flex items-center gap-3">
        <%= icon "zap", size: "md", class: "text-blue-600 theme-dark:text-blue-400" %>
        <div>
          <p class="text-blue-900 theme-dark:text-blue-100 font-medium">
            <%= t("subscriptions.detect.found", count: @suggestion_count) %>
          </p>
          <p class="text-blue-700 theme-dark:text-blue-300 text-sm"><%= t(".suggestion_banner") %></p>
        </div>
      </div>
      <%= render DS::Link.new(
        text: t("subscriptions.suggestions.title"),
        icon: "arrow-right",
        variant: "outline",
        href: suggestions_subscriptions_path
      ) %>
    </div>
  <% end %>

  <%# Filters %>
  <div class="bg-container rounded-xl shadow-border-xs p-4">
    <%= form_with url: subscriptions_path, method: :get, data: { turbo_frame: "subscriptions_results", turbo_action: "advance", controller: "auto-submit-form" } do |f| %>
      <%= hidden_field_tag :kind, kind if kind %>
      <%= hidden_field_tag :status, params[:status] if params[:status].present? %>
      <%= hidden_field_tag :billing_cycle, params[:billing_cycle] if params[:billing_cycle].present? && !@other_recurring %>
      <div class="flex flex-wrap items-center gap-3">
        <%# Subscriptions or the manual recurring rows that are not subscriptions %>
        <div class="flex items-center gap-1 bg-surface-inset rounded-lg p-1" data-testid="subscriptions-kind-filter">
          <%= link_to t(".filter.subscriptions"),
              subscriptions_path(status: params[:status], billing_cycle: params[:billing_cycle]),
              data: { turbo_action: "advance" },
              aria: { current: (@other_recurring ? nil : "page") },
              class: class_names(
                "px-3 py-1.5 text-sm rounded-md transition-colors",
                @other_recurring ? "text-secondary hover:text-primary" : "bg-container shadow-border-xs text-primary font-medium"
              ) %>
          <%= link_to subscriptions_path(kind: SubscriptionsController::OTHER_RECURRING_KIND, status: params[:status]),
              data: { turbo_action: "advance" },
              aria: { current: (@other_recurring ? "page" : nil) },
              class: class_names(
                "px-3 py-1.5 text-sm rounded-md transition-colors",
                @other_recurring ? "bg-container shadow-border-xs text-primary font-medium" : "text-secondary hover:text-primary"
              ) do %>
            <%= t(".filter.other_recurring") %>
            <span class="text-subdued">(<%= @other_recurring_count %>)</span>
          <% end %>
        </div>

        <%# Status filter %>
        <div class="flex items-center gap-1 bg-surface-inset rounded-lg p-1">
          <%= link_to t(".filter.all"),
              subscriptions_path(kind: kind, status: nil, billing_cycle: params[:billing_cycle]),
              data: { turbo_action: "advance" },
              class: class_names(
                "px-3 py-1.5 text-sm rounded-md transition-colors",
                params[:status].blank? ? "bg-container shadow-border-xs text-primary font-medium" : "text-secondary hover:text-primary"
              ) %>
          <%= link_to t(".filter.active"),
              subscriptions_path(kind: kind, status: "active", billing_cycle: params[:billing_cycle]),
              data: { turbo_action: "advance" },
              class: class_names(
                "px-3 py-1.5 text-sm rounded-md transition-colors",
                params[:status] == "active" ? "bg-container shadow-border-xs text-primary font-medium" : "text-secondary hover:text-primary"
              ) %>
          <%= link_to t(".filter.inactive"),
              subscriptions_path(kind: kind, status: "inactive", billing_cycle: params[:billing_cycle]),
              data: { turbo_action: "advance" },
              class: class_names(
                "px-3 py-1.5 text-sm rounded-md transition-colors",
                params[:status] == "inactive" ? "bg-container shadow-border-xs text-primary font-medium" : "text-secondary hover:text-primary"
              ) %>
        </div>

        <%# Billing cycle filter (subscriptions only) %>
        <% unless @other_recurring %>
        <div class="flex items-center gap-1 bg-surface-inset rounded-lg p-1">
          <%= link_to t(".filter.all"),
              subscriptions_path(status: params[:status], billing_cycle: nil),
              data: { turbo_action: "advance" },
              class: class_names(
                "px-3 py-1.5 text-sm rounded-md transition-colors",
                params[:billing_cycle].blank? ? "bg-container shadow-border-xs text-primary font-medium" : "text-secondary hover:text-primary"
              ) %>
          <%= link_to t(".filter.monthly"),
              subscriptions_path(status: params[:status], billing_cycle: "monthly"),
              data: { turbo_action: "advance" },
              class: class_names(
                "px-3 py-1.5 text-sm rounded-md transition-colors",
                params[:billing_cycle] == "monthly" ? "bg-container shadow-border-xs text-primary font-medium" : "text-secondary hover:text-primary"
              ) %>
          <%= link_to t(".filter.yearly"),
              subscriptions_path(status: params[:status], billing_cycle: "yearly"),
              data: { turbo_action: "advance" },
              class: class_names(
                "px-3 py-1.5 text-sm rounded-md transition-colors",
                params[:billing_cycle] == "yearly" ? "bg-container shadow-border-xs text-primary font-medium" : "text-secondary hover:text-primary"
              ) %>
        </div>
        <% end %>

        <%# Search %>
        <div class="flex-1 min-w-[200px]">
          <%= f.search_field :search,
              value: params[:search],
              placeholder: @other_recurring ? t(".search_other_placeholder") : t(".search_placeholder"),
              class: "w-full px-3 py-1.5 text-sm bg-surface-inset rounded-lg border border-secondary focus:border-primary focus:ring-1 focus:ring-primary",
              data: {
                auto_submit_form_target: "auto",
                autosubmit_trigger_event: "input",
                autosubmit_min_length: "2",
                autosubmit_debounce_add_timeout: "100",
                autosubmit_debounce_clear_timeout: "0"
              } %>
        </div>
      </div>
    <% end %>
  </div>

  <%# Subscriptions list %>
  <%= render "subscriptions/results_frame" %>
</div>
