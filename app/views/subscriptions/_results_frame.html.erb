<%= turbo_frame_tag "subscriptions_results" do %>
  <div class="bg-container rounded-xl shadow-border-xs">
    <% if @other_recurring %>
      <%= render "subscriptions/other_recurring_table", recurring_transactions: @subscriptions %>
    <% elsif @subscriptions.empty? %>
      <%= render DS::EmptyState.new(icon: "credit-card", title: t("subscriptions.index.no_subscriptions"), description: t("subscriptions.index.no_subscriptions_description")) do |empty| %>
        <% empty.with_action do %>
          <%= render DS::Link.new(
            text: t("subscriptions.index.new_subscription"),
            icon: "plus",
            variant: "primary",
            href: new_subscription_path
          ) %>
        <% end %>
      <% end %>
    <% else %>
      <%# A table when the card is wide; below 48rem each row is a card of its own
          (subscriptions/_subscription), so a phone never scrolls sideways %>
      <div class="@container">
        <div class="overflow-x-auto" tabindex="-1">
          <table class="w-full">
            <thead class="hidden @3xl:table-header-group">
              <tr class="text-xs font-medium text-secondary border-b border-divider">
                <th scope="col" class="text-left py-3 px-4"><%= t("subscriptions.index.table.name") %></th>
                <th scope="col" class="text-left py-3 px-4"><%= t("subscriptions.index.table.amount") %></th>
                <th scope="col" class="text-left py-3 px-4"><%= t("subscriptions.index.table.cycle") %></th>
                <th scope="col" class="text-left py-3 px-4"><%= t("subscriptions.index.table.next_billing") %></th>
                <th scope="col" class="text-left py-3 px-4"><%= t("subscriptions.index.table.status") %></th>
                <th scope="col" class="text-right py-3 px-4 sticky right-0 bg-container"><span class="sr-only"><%= t("subscriptions.index.table.actions") %></span></th>
              </tr>
            </thead>
            <tbody class="block @3xl:table-row-group">
              <% @subscriptions.each do |subscription| %>
                <%= render "subscriptions/subscription", subscription: subscription %>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    <% end %>
  </div>
<% end %>
