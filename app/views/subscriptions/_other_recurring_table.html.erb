<%# locals: (recurring_transactions:) %>
<%# The Other recurring tab: manual recurring rows that are not subscriptions. %>

<% if recurring_transactions.empty? %>
  <div class="text-center py-12 px-4" data-testid="other-recurring-empty">
    <div class="text-secondary mb-4">
      <%= icon "repeat", size: "xl" %>
    </div>
    <p class="text-primary font-medium mb-2"><%= t(".empty_title") %></p>
    <p class="text-secondary text-sm"><%= t(".empty_description") %></p>
  </div>
<% else %>
  <div class="overflow-x-auto">
    <table class="w-full" data-testid="other-recurring-table">
      <thead>
        <tr class="text-xs uppercase font-medium text-secondary border-b border-divider">
          <th class="text-left py-3 px-4"><%= t(".name") %></th>
          <th class="text-left py-3 px-4"><%= t(".amount") %></th>
          <th class="text-left py-3 px-4"><%= t(".expected_day") %></th>
          <th class="text-left py-3 px-4"><%= t(".next_date") %></th>
          <th class="text-left py-3 px-4"><%= t(".last_occurrence") %></th>
          <th class="text-left py-3 px-4"><%= t(".status") %></th>
          <th class="text-right py-3 px-4"><%= t(".actions") %></th>
        </tr>
      </thead>
      <tbody>
        <% recurring_transactions.each do |recurring_transaction| %>
          <%= render "subscriptions/other_recurring", recurring_transaction: recurring_transaction %>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>
