<%# locals: (recurring_transactions:) %>
<%# The Other recurring tab: manual recurring rows that are not subscriptions. %>

<% if recurring_transactions.empty? %>
  <%= render DS::EmptyState.new(icon: "repeat", title: t(".empty_title"), description: t(".empty_description"), data: { testid: "other-recurring-empty" }) %>
<% else %>
  <%# Like subscriptions/_results_frame: a table when wide, card rows below 48rem %>
  <div class="@container">
    <div class="overflow-x-auto" tabindex="-1">
      <table class="w-full" data-testid="other-recurring-table">
        <thead class="hidden @3xl:table-header-group">
          <tr class="text-xs font-medium text-secondary border-b border-divider">
            <th scope="col" class="text-left py-3 px-4"><%= t(".name") %></th>
            <th scope="col" class="text-left py-3 px-4"><%= t(".amount") %></th>
            <th scope="col" class="text-left py-3 px-4"><%= t(".expected_day") %></th>
            <th scope="col" class="text-left py-3 px-4"><%= t(".next_date") %></th>
            <th scope="col" class="text-left py-3 px-4"><%= t(".last_occurrence") %></th>
            <th scope="col" class="text-left py-3 px-4"><%= t(".status") %></th>
            <th scope="col" class="text-right py-3 px-4 sticky right-0 bg-container"><span class="sr-only"><%= t(".actions") %></span></th>
          </tr>
        </thead>
        <tbody class="block @3xl:table-row-group">
          <% recurring_transactions.each do |recurring_transaction| %>
            <%= render "subscriptions/other_recurring", recurring_transaction: recurring_transaction %>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
<% end %>
