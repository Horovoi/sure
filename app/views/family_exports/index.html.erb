<%# The header as on Tags and Rules: the title and the primary action in one row %>
<div class="space-y-4">
  <header class="flex flex-wrap items-center justify-between gap-x-4 gap-y-2">
    <h1 class="text-primary text-xl font-medium"><%= t(".title") %></h1>
    <%= render DS::Link.new(
          text: t(".new"),
          variant: "primary",
          href: new_family_export_path,
          icon: "plus",
          frame: :modal
        ) %>
  </header>

  <%# Polls only while an export runs; the response without polling attributes stops it %>
  <% has_processing = @exports.any? { |e| e.pending? || e.processing? } %>
  <%= turbo_frame_tag "family_exports",
      target: "_top",
      class: "block space-y-4",
      data: has_processing ? {
        controller: "polling",
        polling_url_value: family_exports_path(page: params[:page].presence),
        polling_interval_value: 3000
      } : {} do %>
    <div class="bg-container rounded-xl shadow-border-xs">
      <% if @exports.any? %>
        <div class="overflow-x-auto" tabindex="-1">
          <table class="w-full">
            <thead>
              <tr class="text-xs font-medium text-secondary border-b border-divider">
                <th class="px-4 py-3 text-left font-medium min-w-44"><%= t("family_exports.table.header.date") %></th>
                <th class="px-2 py-3 text-left font-medium min-w-64"><%= t("family_exports.table.header.filename") %></th>
                <th class="px-2 py-3 text-left font-medium min-w-24"><%= t("family_exports.table.header.status") %></th>
                <th class="px-4 py-3 text-right font-medium min-w-20"><span class="sr-only"><%= t("family_exports.table.header.actions") %></span></th>
              </tr>
            </thead>
            <tbody>
            <% @exports.ordered.each do |export| %>
              <tr class="border-b border-subdued last:border-b-0 hover:bg-container-hover">
                <td class="px-4 py-3">
                  <span class="text-sm text-secondary whitespace-nowrap">
                    <%= l(export.created_at, format: :long) %>
                  </span>
                </td>
                <td class="px-2 py-3">
                  <span class="text-sm text-secondary truncate">
                    <%= export.filename %>
                  </span>
                </td>
                <td class="px-2 py-3">
                  <% if export.processing? || export.pending? %>
                    <%= render "shared/badge" do %>
                      <%= t("family_exports.table.row.status.in_progress") %>
                    <% end %>
                  <% elsif export.completed? %>
                    <%= render "shared/badge", color: "success" do %>
                      <%= t("family_exports.table.row.status.complete") %>
                    <% end %>
                  <% elsif export.failed? %>
                    <%= render "shared/badge", color: "error" do %>
                      <%= t("family_exports.table.row.status.failed") %>
                    <% end %>
                  <% end %>
                </td>
                <td class="px-4 py-2 text-right">
                  <% if export.processing? || export.pending? %>
                    <div class="flex items-center justify-end gap-2 text-secondary">
                      <div class="animate-spin h-4 w-4 border-2 border-secondary border-t-transparent rounded-full"></div>
                      <span class="text-sm"><%= t("family_exports.exporting") %></span>
                    </div>
                  <% elsif export.completed? %>
                    <div class="flex items-center gap-1 justify-end">
                      <%= render DS::Button.new(
                            variant: :icon,
                            size: :sm,
                            icon: "trash-2",
                            href: family_export_path(export),
                            method: :delete,
                            title: t("family_exports.table.row.actions.delete"),
                            aria_label: t("family_exports.table.row.actions.delete"),
                            confirm: CustomConfirm.new(body: t("family_exports.delete_confirmation"), btn_text: t("family_exports.table.row.actions.delete"), destructive: true),
                            form: { data: { turbo_frame: "_top" } }
                          ) %>

                      <%= render DS::Link.new(
                            variant: :icon,
                            size: :sm,
                            icon: "download",
                            href: download_family_export_path(export),
                            frame: "_top",
                            title: t("family_exports.table.row.actions.download"),
                            aria: { label: t("family_exports.table.row.actions.download") }
                          ) %>
                    </div>
                  <% elsif export.failed? %>
                    <div class="flex items-center gap-1 justify-end">
                      <div class="flex items-center gap-2 text-destructive">
                        <%= icon "alert-circle", class: "w-4 h-4" %>
                      </div>

                      <%= render DS::Button.new(
                            variant: :icon,
                            size: :sm,
                            icon: "trash-2",
                            href: family_export_path(export),
                            method: :delete,
                            title: t("family_exports.table.row.actions.delete"),
                            aria_label: t("family_exports.table.row.actions.delete"),
                            confirm: CustomConfirm.new(body: t("family_exports.delete_failed_confirmation"), btn_text: t("family_exports.table.row.actions.delete"), destructive: true),
                            form: { data: { turbo_frame: "_top" } }
                          ) %>
                    </div>
                  <% end %>
                </td>
              </tr>
            <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <%= render DS::EmptyState.new(icon: "upload", title: t("family_exports.table.empty")) %>
      <% end %>
    </div>

    <% if @pagy.pages > 1 %>
      <%= render "shared/pagination", pagy: @pagy %>
    <% end %>
  <% end %>
</div>
