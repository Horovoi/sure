<%= render DS::Dialog.new do |dialog| %>
  <% dialog.with_header(title: t(".title"), subtitle: t(".subtitle")) %>

  <% dialog.with_body do %>
    <div class="space-y-4">
      <div class="bg-container-inset rounded-lg p-4 space-y-3">
        <h3 class="font-medium text-primary"><%= t(".included_heading") %></h3>
        <ul class="space-y-2 text-sm text-secondary">
          <% %w[accounts transactions trades categories].each do |item| %>
            <li class="flex items-start gap-2">
              <%= icon "check", color: "success", class: "mt-0.5" %>
              <span><%= t(".included.#{item}") %></span>
            </li>
          <% end %>
        </ul>
      </div>

      <%= render DS::Alert.new(variant: :warning, message: t(".import_note")) %>

      <%= form_with url: family_exports_path, method: :post, class: "space-y-4" do |form| %>
        <div class="flex gap-3">
          <%# DS--dialog#close: the old "modal#close" action had no controller, so Cancel did nothing %>
          <%= render DS::Button.new(text: t(".cancel"), type: :button, variant: :outline, full_width: true,
                                    data: { action: "DS--dialog#close" }) %>
          <%= render DS::Button.new(text: t(".submit"), type: :submit, full_width: true) %>
        </div>
      <% end %>
    </div>
  <% end %>
<% end %>
