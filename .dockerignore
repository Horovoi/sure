# See https://docs.docker.com/engine/reference/builder/#dockerignore-file for more about ignoring files.

# Ignore git directory.
/.git/
/.gitignore

# Ignore bundler config.
/.bundle

# Ignore all environment files (except templates).
/.env*
!/.env*.erb

# Ignore all default key files.
/config/master.key
/config/credentials/*.key

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore pidfiles, but keep the directory.
/tmp/pids/*
!/tmp/pids/.keep

# Ignore storage (uploaded files in development and any SQLite databases).
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/.keep

# Ignore assets.
/node_modules/
/app/assets/builds/*
!/app/assets/builds/.keep
/public/assets

# Ignore CI service files.
/.github

# Ignore Docker-related files
/.dockerignore
/Dockerfile*

# Ignore local database backups and private working files. They must never be
# copied into the image: the image is pushed to a registry.
/backups/
/temp.md
/docs/temp/
/.claude/settings.local.json
/.ruby-lsp/

# Ignore everything the running app does not need. Smaller image, and edits to
# these files no longer force a rebuild of the application layers.
/test/
/spec/
/mobile/
/docs/hosting/
/script/
/bin/deploy
/bin/staging
/docker-compose*.yml
/Procfile.dev
/*.md
/.cursor/
/.junie/
/.gemini/
/.claude/
/coverage/
**/.DS_Store
