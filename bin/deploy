#!/usr/bin/env bash
# Builds the current commit and runs it as production on this machine.
#
#   bin/deploy                    build, rehearse on a copy of production, then deploy
#   bin/deploy --skip-rehearsal   deploy without the rehearsal
#   bin/deploy --rollback <ref>   switch back to an image built by an earlier deploy
#   bin/deploy --allow-row-loss   continue even if a migration removes rows from a table
#
# What a deploy does:
#   1. Builds the image sure:<commit> from the working tree.
#   2. Rehearsal: copies production into staging, runs the new image's migrations
#      there, and checks that the app starts. Production is not touched if this fails.
#   3. Writes a pre-deploy backup bundle to backups/bundles/pre-deploy: the database,
#      uploaded files, cached icons, the encrypted .env.production and a manifest,
#      mirrored to OFFSITE_BACKUP_DIR.
#   4. If there are migrations: stops the app, migrates, and checks that no table lost rows.
#   5. Starts the new version and waits until it is healthy.
#
# A rollback does not undo migrations. To go back past a migration, restore the
# pre-deploy bundle (see .claude/deploy.md).

set -euo pipefail
cd "$(dirname "$0")/.."
source script/deploy/lib.sh

rehearse=1
allow_row_loss=0
rollback=""

while [ $# -gt 0 ]; do
  case "$1" in
    --skip-rehearsal) rehearse=0 ;;
    --allow-row-loss) allow_row_loss=1 ;;
    --rollback) rollback="${2:-}"; [ -n "$rollback" ] || die "--rollback needs a commit"; shift ;;
    -h|--help) sed -n '2,/^$/p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) die "unknown option: $1 (see bin/deploy --help)" ;;
  esac
  shift
done

port=$(env_value PORT)
port="${port:-3333}"
previous=$(deployed_tag)

# Records the tag as the deployed one and starts it
start_version() {
  local tmp
  tmp=$(mktemp)
  if grep -q '^BUILD_COMMIT_SHA=' "$ENV_FILE"; then
    sed "s/^BUILD_COMMIT_SHA=.*/BUILD_COMMIT_SHA=$TAG/" "$ENV_FILE" > "$tmp"
  else
    { cat "$ENV_FILE"; echo "BUILD_COMMIT_SHA=$TAG"; } > "$tmp"
  fi
  cat "$tmp" > "$ENV_FILE"
  rm -f "$tmp"

  quiet prod up -d --wait web worker
  wait_for_http "http://localhost:$port/up"
  # Started without waiting: its health check only runs every five minutes
  quiet prod up -d backup
}

if [ -n "$rollback" ]; then
  TAG=$(tag_for "$rollback")
  image_exists "$TAG" || die "no local image sure:$TAG. Available: $(docker images sure --format '{{.Tag}}' | tr '\n' ' ')"
  step "Rolling back to sure:$TAG (migrations are not undone)"
  start_version
  echo "✓ Running sure:$TAG at http://localhost:$port"
  exit 0
fi

SECONDS=0
TAG=$(tag_for HEAD)
export BUILD_FULL_SHA
BUILD_FULL_SHA=$(git rev-parse HEAD)

step "Building sure:$TAG"
changed=$(git status --porcelain --untracked-files=no)
[ -z "$changed" ] || echo "  note: the build includes uncommitted changes: $(echo "$changed" | awk '{print $2}' | tr '\n' ' ')"
quiet prod build web
echo "  built in ${SECONDS}s"

if [ "$rehearse" = 1 ]; then
  refresh_staging
  step "Rehearsing sure:$TAG on the copy"
  status=0
  migrate_checked staging || status=$?
  if [ "$status" = 2 ]; then
    die "Rehearsal failed: the migration does not run on a copy of production. Production was not touched."
  elif [ "$status" = 1 ] && [ "$allow_row_loss" != 1 ]; then
    die "Rehearsal failed. Production was not touched. Re-run with --allow-row-loss if the loss is intended."
  fi
  start_staging
  echo "  the new version starts and serves pages on the copy"
  stop_staging_app
  quiet staging stop db redis
fi

step "Backing up production"
quiet prod up -d --wait db redis
backup_root=$(env_value BACKUP_DIR)
backup_root="${backup_root:-./backups}"
offsite_root=$(env_value OFFSITE_BACKUP_DIR)
[ -n "$offsite_root" ] || echo "  warning: OFFSITE_BACKUP_DIR is not set in $ENV_FILE, so the mirror is backups/offsite on the same disk"
mkdir -p "${offsite_root:-./backups/offsite}"

# The bundle folder: the database dump and the two volume tarballs are written here by
# this script (no Rails needed); the new image's backup:seal then adds the encrypted
# env file and the manifest, mirrors the folder off-site and prunes old bundles.
bundle_name="$(date -u +%Y%m%dT%H%M%SZ)_$TAG"
bundle="$backup_root/bundles/pre-deploy/$bundle_name"
mkdir -p "$bundle"
if ! prod exec -T db sh -c 'pg_dump -U "$POSTGRES_USER" "$POSTGRES_DB"' | gzip > "$bundle/db.sql.gz"; then
  die "the database dump failed; production was not touched. Partial files: $bundle"
fi
gunzip -t "$bundle/db.sql.gz" && [ -s "$bundle/db.sql.gz" ] || die "the database dump is invalid; production was not touched. Partial files: $bundle"
archive_volume app-storage "$bundle/storage.tar.gz" || die "copying uploaded files failed; production was not touched. Partial files: $bundle"
archive_volume icons "$bundle/icons.tar.gz" || die "copying cached icons failed; production was not touched. Partial files: $bundle"

if ! quiet prod run --rm --no-deps -T worker bin/rails "backup:seal[/backups/bundles/pre-deploy/$bundle_name,pre_deploy]"; then
  die "sealing the backup bundle failed (env copy, manifest or off-site mirror). The database dump and the tarballs are in $bundle; production was not touched."
fi
echo "  $bundle ($(du -sh "$bundle" | cut -f1 | tr -d ' '))"

step "Migrating production"
pending=$(pending_migrations prod "$TAG") || die "could not read the migration state of production; nothing was changed"
if [ -n "$pending" ]; then
  quiet prod stop web worker
  status=0
  migrate_checked prod || status=$?
  if [ "$status" = 2 ]; then
    die "The migration failed and the app is stopped. Rails rolled the failing migration back; any earlier ones in this deploy stay applied. Backup bundle from before: $bundle. Previous version: bin/deploy --rollback ${previous:-<commit>}"
  elif [ "$status" = 1 ] && [ "$allow_row_loss" != 1 ]; then
    die "Stopped before starting the new version; the app is down. Backup bundle from before the migration: $bundle. To continue anyway: bin/deploy --allow-row-loss"
  fi
else
  echo "  no pending migrations"
fi

step "Starting sure:$TAG"
start_version

# Keep the five newest images for rollbacks
docker images sure --format '{{.Tag}}' | grep -v -e "^$TAG\$" -e "^${previous:-none}\$" | tail -n +4 |
  while read -r old; do docker image rm "sure:$old" >/dev/null 2>&1 || true; done

echo
echo "✓ Deployed sure:$TAG in ${SECONDS}s: http://localhost:$port"
[ -z "$previous" ] || [ "$previous" = "$TAG" ] || echo "  previous version: bin/deploy --rollback $previous"
echo "  backup bundle from before this deploy: $bundle"
